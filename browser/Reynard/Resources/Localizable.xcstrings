      }
    },
    "This will clear selected browsing data. This action cannot be undone." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto se smažou vybraná data o prohlížení. Tuto akci nelze odvolat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die ausgewählten Daten gelöscht. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will clear selected browsing data. This action cannot be undone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci effacera les données de navigation sélectionnées. Cette action ne pourra pas être annulée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択されたブラウジングデータは削除されます。この作業は取り消せません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to wyczyszczenie wybranych danych przeglądania. Tej czynności nie można cofnąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это действие очистит выбранные данные браузера. Отменить его будет невозможно.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将清除所选浏览数据。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清除所選的瀏覽資料。此動作無法復原。"
          }
        }
      }
    },
    "This will close your %d tabs." : {
