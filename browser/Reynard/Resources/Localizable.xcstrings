    "Reynard won’t remember any of your browsing history or cookies. However, downloads and new bookmarks will be saved." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reynard si nebude pamatovat vaši historii prohlížení ani cookies. Stažené soubory a nové záložky budou nicméně uloženy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reynard speichert weder den Browserverlauf noch Cookies. Downloads und neue Lesezeichen werden jedoch gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reynard won’t remember any of your browsing history or cookies. However, downloads and new bookmarks will be saved."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reynard ne conservera pas votre historique de recherche ou vos cookies. Cependant, vos téléchargements et les marques pages ajoutés seront conservés. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度タブを閉じるとReynardは履歴とクッキーの情報を削除しますが、ダウンロードや新しいブックマークは保存されます"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reynard nie będzie zapamiętywał historii przeglądania ani plików cookie. Pobrane pliki i nowe zakładki zostaną jednak zapisane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reynard не сохранит историю посещений и файлы cookie. Скачанные файлы и новые закладки при этом сохранятся.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reynard 不会记住任何浏览历史记录或 Cookie。但是，下载项目和新书签仍会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reynard 不會記住你的任何瀏覽記錄或 Cookie。不過，下載項目和新增的書籤仍會保留。"
          }
        }
      }
    },
