    "Use %%s for search terms, as in example.com⁠/⁠search⁠?⁠q⁠=⁠%%s." : {
      "comment" : "Literal %s, word joiners",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místo pro dotaz pro vyhledávač označte jako „%%s“, např. example.com/search?=%%s."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie %%s als Suchbegriff, wie in example.com⁠/⁠search⁠?⁠q⁠=⁠%%s."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use %%s for search terms, as in example.com⁠/⁠search⁠?⁠q⁠=⁠%%s."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser %%s comme termes de recherche, par exemple : example.com/search?q=%%s"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nexample.com/search?q=%%s のように、検索語句には %%s を使用してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj %%s do wyszukiwania terminów, np. example.com⁠/⁠search⁠?⁠q⁠=⁠%%s."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте %%s для поисковых запросов, например: example.com⁠/⁠search⁠?⁠q⁠=⁠%%s.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用%%s作为搜索词，例如 example.com⁠/⁠search⁠?⁠q⁠=⁠%%s。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 %%s 代表搜尋字詞，例如 example.com⁠/⁠search⁠?⁠q⁠=⁠%%s。"
