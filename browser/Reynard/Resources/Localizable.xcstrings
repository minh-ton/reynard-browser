      "comment" : "User agent name placeholder",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : ""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Seiten hinzu, bei denen Anmeldefehler, Probleme bei der manuellen Verifizierung oder andere Probleme auftreten, damit der User-Agent %@ verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add websites with sign-in failures, human verification challenges, or other issues to use the %@ user agent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter des sites web avec des erreurs lors de la connexion, des vérifications d'humain ou d'autres problèmes pour utiliser l'user agent %@. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動作に問題のあるサイトなどを%@のユーザーエージェントを使用するには追加してください"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj witryny, w których występują problemy z logowaniem, weryfikacją lub inne problemy, aby używać %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте сайты с ошибками входа, капчей или другими сбоями, чтобы использовать юзер агент %@.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将登录失败、人机验证或其他异常的网站添加到此列表，以使用 %@ 用户代理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將發生登入失敗、真人驗證或其他問題的網站加入此清單，以改用 %@ 使用者代理程式。"
          }
        }
      }
