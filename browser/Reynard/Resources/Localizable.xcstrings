    "This build does not support in-app updates. Visit the project's Releases page to download the latest version of the app." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato verze nepodporuje aktualizace přímo z aplikace. Nejnovější verzi aplikace si můžete stáhnout v sekci Releases na GitHub stránkách tohoto projektu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version unterstützt keine Updates innerhalb der App. Besuche die Release-Seite des Projekts, um die neueste Version der App herunterzuladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This build does not support in-app updates. Visit the project's Releases page to download the latest version of the app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce build ne prend pas en charge les mises à jour dans l'application. Veuillez visites l'onglet Releases du projet pour télécharger la dernière version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドはアプリ内更新に対応していません。プロジェクトのリリースページを訪れてアプリの最新版を入手してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kompilacja nie obsługuje aktualizacji w aplikacji. Odwiedź stronę „Releases” projektu, aby pobrać najnowszą wersję aplikacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сборка не поддерживает обновления в приложении. Перейдите на страницу релизов проекта, чтобы скачать последнюю версию приложения.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此构建不支持 App 内更新。请前往项目的 Releases 页面下载最新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
