    "Are you sure you want to upload all files? Only do this if you trust the site." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Určitě chcete nahrát všechny soubory? Pokračujte pouze, pokud této stránce důvěřujete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher, dass du alle Dateien hochladen möchtest? Wir empfehlen, dies nur zu tun, wenn du der Seite vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to upload all files? Only do this if you trust the site."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir téléverser tous les fichiers ? Ne faites ceci que si vous avez confiance en ce site web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロードを本当に行いますか?信頼できるサイトでのみ行ってください"
