+#[cfg(target_os = "ios")]
+#[repr(C)]
+struct MachTimebase {
+    numer: u32,
+    denom: u32,
+}
+
+#[cfg(target_os = "ios")]
+extern "C" {
+    fn mach_absolute_time() -> u64;
+    fn mach_timebase_info(info: *mut MachTimebase) -> i32;
+}
+
+#[cfg(target_os = "ios")]
+struct InputClock {
+    origin: u64,
+    timebase: MachTimebase,
+}
+
+#[cfg(target_os = "ios")]
+impl InputClock {
+    fn new() -> Self {
+        let mut timebase = MachTimebase { numer: 0, denom: 0 };
+        unsafe { mach_timebase_info(&mut timebase) };
+        Self {
+            origin: unsafe { mach_absolute_time() },
+            timebase,
+        }
+    }
+
+    fn microseconds(&self, timestamp: u64) -> u64 {
+        let timestamp = if timestamp == 0 {
+            unsafe { mach_absolute_time() }
+        } else {
+            timestamp
+        };
+        let ticks = timestamp.saturating_sub(self.origin) as u128;
+        (ticks * self.timebase.numer as u128 / self.timebase.denom as u128 / 1000) as u64
+    }
+}
