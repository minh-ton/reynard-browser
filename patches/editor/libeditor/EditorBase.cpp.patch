+      nsresult rv = CompositionTransaction::SetIMESelection(
+          *this, text, composition->ClampedStartOffsetInTextNode(),
+          composition->ClampedLengthInTextNode(), composition->GetRanges());
+
+      if (NS_FAILED(rv)) {
+        return rv;
+      }
+      if (!mComposition) {
+        return NS_OK;
+      }
+    }
+  }
+#endif
