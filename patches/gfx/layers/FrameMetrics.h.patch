+          mCompositionSizeWithoutDynamicToolbar.height > 0
+              ? mCompositionSizeWithoutDynamicToolbar.height
+              : mCompositionBounds.Height();
+      if (CSSCoord(rect.Height()) * aZoom <= compositionHeight) {
+        // Short pages need the inset without any extra scrolling.
