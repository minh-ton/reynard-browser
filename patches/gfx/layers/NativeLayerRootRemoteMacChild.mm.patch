+#ifdef MOZ_WIDGET_UIKIT
+static CFTypeRefPtr<IOSurfaceRef> GetVideoFrame(base::ProcessId aPid,
+                                                uint64_t aHandle) {
+  RefPtr<ImageBridgeParent> bridge = ImageBridgeParent::GetInstance(aPid);
+  RefPtr<CompositableHost> host =
+      bridge ? bridge->FindCompositable(CompositableHandle(aHandle)) : nullptr;
+  WebRenderImageHost* imageHost = host ? host->AsWebRenderImageHost() : nullptr;
+  TextureHost* texture =
+      imageHost ? imageHost->GetTextureHostAt(TimeStamp::Now()) : nullptr;
+  MacIOSurfaceTextureHostOGL* surfaceTexture =
+      texture ? texture->AsMacIOSurfaceTextureHost() : nullptr;
+  if (!surfaceTexture) {
+    return {};
+  }
+  return surfaceTexture->GetMacIOSurface()->GetIOSurfaceRef();
+}
+#endif
+
+mozilla::ipc::IPCResult NativeLayerRemoteChild::RecvStartVideoFrames(
+    const base::ProcessId& aPid, const uint64_t& aHandle) {
+#ifdef MOZ_WIDGET_UIKIT
+  RecvStopVideoFrames();
+
+  nsCOMPtr<nsISerialEventTarget> actorThread = GetCurrentSerialEventTarget();
+  NS_NewTimerWithCallback(
+      getter_AddRefs(mVideoFrameTimer),
+      [self = RefPtr{this}, actorThread, aPid, aHandle,
+       lastSurface = CFTypeRefPtr<IOSurfaceRef>()](nsITimer*) mutable {
+        CFTypeRefPtr<IOSurfaceRef> surface = GetVideoFrame(aPid, aHandle);
+        if (!surface || surface.get() == lastSurface.get()) {
+          return;
+        }
+
+        lastSurface = surface;
+        actorThread->Dispatch(NS_NewRunnableFunction(
+            "NativeLayerRemoteChild::SendVideoFrame", [self, surface] {
+              if (self->CanSend()) {
+                (void)self->SendVideoFrame(IOSurfacePort::FromSurface(surface));
+              }
+            }));
+      },
+      TimeDuration::FromMilliseconds(16),
+      nsITimer::TYPE_REPEATING_PRECISE_CAN_SKIP,
+      "NativeLayerRemoteChild::VideoFrames"_ns, CompositorThread());
+#endif
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult NativeLayerRemoteChild::RecvStopVideoFrames() {
+  if (mVideoFrameTimer) {
+    mVideoFrameTimer->Cancel();
+    mVideoFrameTimer = nullptr;
+  }
+  return IPC_OK();
+}
+
+void NativeLayerRemoteChild::ActorDestroy(ActorDestroyReason aWhy) {
+  RecvStopVideoFrames();
+}
