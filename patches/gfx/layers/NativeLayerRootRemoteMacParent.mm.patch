+void NativeLayerRootRemoteMacParent::Shutdown() {
+  // Clear the remote layer state and release the root before the
+  // UIKit view backing it is torn down.
+  if (mRealNativeLayerRoot) {
+    mRealNativeLayerRoot->SetLayers({});
+  }
+
+#ifdef MOZ_WIDGET_UIKIT
+  mVideoFrameCallback = nullptr;
+#endif
+
+  mSnapshotter = nullptr;
+  mKnownLayers.Clear();
+  mRealNativeLayerRoot = nullptr;
+}
+
 mozilla::ipc::IPCResult
 NativeLayerRootRemoteMacParent::RecvCommitNativeLayerCommands(
     nsTArray<NativeLayerCommand>&& aCommands) {
+  if (!mRealNativeLayerRoot) {
+    return IPC_OK();
+  }
+
+#ifdef MOZ_WIDGET_UIKIT
+  ReleasableMutexAutoLock layerUpdateLock(
+      mRealNativeLayerRoot->LayerUpdateMutex());
+#endif
+
   for (auto& command : aCommands) {
     switch (command.type()) {
       case NativeLayerCommand::TCommandCreateLayer: {
@@ -77,6 +102,15 @@
         break;
       }
 
+      case NativeLayerCommand::TCommandOnscreenCommitData: {
+#ifdef MOZ_WIDGET_UIKIT
+        auto& commitData = command.get_CommandOnscreenCommitData();
+        mRealNativeLayerRoot->SetOnscreenCommitData(
+            std::move(commitData.Data()));
+#endif
+        break;
+      }
+
       default: {
         gfxWarning() << "Unknown NativeLayerCommand.";
         break;
@@ -84,6 +118,9 @@
     }
   }
 
+#ifdef MOZ_WIDGET_UIKIT
