 }
 
+mozilla::ipc::IPCResult NativeLayerRootRemoteMacParent::RecvVideoFrame(
+    IOSurfacePort&& aSurface) {
+#ifdef MOZ_WIDGET_UIKIT
+  CFTypeRefPtr<IOSurfaceRef> surface = aSurface.GetSurface();
+  if (mVideoFrameCallback && surface) {
+    mVideoFrameCallback(surface);
+  }
+#endif
+  return IPC_OK();
+}
+
+#ifdef MOZ_WIDGET_UIKIT
+void NativeLayerRootRemoteMacParent::StartVideoFrames(
+    base::ProcessId aPid, uint64_t aHandle,
+    std::function<void(CFTypeRefPtr<IOSurfaceRef>)>&& aCallback) {
+  mVideoFrameCallback = std::move(aCallback);
+  if (CanSend()) {
+    (void)SendStartVideoFrames(aPid, aHandle);
+  }
+}
+
+void NativeLayerRootRemoteMacParent::StopVideoFrames() {
+  mVideoFrameCallback = nullptr;
+  if (CanSend()) {
+    (void)SendStopVideoFrames();
+  }
+}
+#endif
