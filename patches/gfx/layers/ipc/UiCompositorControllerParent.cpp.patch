+mozilla::ipc::IPCResult
+UiCompositorControllerParent::RecvNativeTextInputScrollers(
+    const nsTArray<ScrollableLayerGuid>& aScrollers) {
+#ifdef MOZ_WIDGET_UIKIT
+  CompositorBridgeParent* parent =
+      CompositorBridgeParent::GetCompositorBridgeParentFromLayersId(
+          mRootLayerTreeId);
+  if (parent) {
+    if (RefPtr<APZSampler> sampler = parent->GetAPZSampler()) {
+      sampler->SetNativeTextInputScrollers(aScrollers);
+      if (!aScrollers.IsEmpty()) {
+        parent->ScheduleComposition(wr::RenderReasons::OTHER);
+      }
+    }
+  }
+#endif
+  return IPC_OK();
+}
