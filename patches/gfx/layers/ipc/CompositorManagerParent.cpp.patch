+/* static */
+void CompositorManagerParent::NotifyMemoryPressure() {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  RefPtr<CompositorThreadHolder> compositorThread =
+      CompositorThreadHolder::GetSingleton();
+  if (!compositorThread) {
+    return;
+  }
+
+  compositorThread->Dispatch(NS_NewRunnableFunction(
+      "layers::CompositorManagerParent::NotifyMemoryPressure", []() {
+        RefPtr<CompositorManagerParent> manager;
+        {
+          StaticMonitorAutoLock lock(sMonitor);
+          manager = sInstance;
+        }
+        if (manager) {
+          manager->NotifyMemoryPressureOnCompositorThread();
+        }
+      }));
+}
+
 mozilla::ipc::IPCResult CompositorManagerParent::RecvNotifyMemoryPressure() {
+  NotifyMemoryPressureOnCompositorThread();
+  return IPC_OK();
+}
+
+void CompositorManagerParent::NotifyMemoryPressureOnCompositorThread() {
+  MOZ_ASSERT(CompositorThreadHolder::IsInCompositorThread());
+
   nsTArray<PCompositorBridgeParent*> compositorBridges;
   ManagedPCompositorBridgeParent(compositorBridges);
   for (auto bridge : compositorBridges) {
     static_cast<CompositorBridgeParentBase*>(bridge)->NotifyMemoryPressure();
   }
-  return IPC_OK();
 }
 
