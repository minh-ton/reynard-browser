@@ -4,6 +4,8 @@
 
 #include "ExpectedGeckoMetrics.h"
 
+#include <algorithm>
+
 #include "FrameMetrics.h"
 
 namespace mozilla {
@@ -12,6 +14,18 @@ namespace layers {
 void ExpectedGeckoMetrics::UpdateFrom(const FrameMetrics& aMetrics) {
   mVisualScrollOffset = aMetrics.GetVisualScrollOffset();
   mLayoutScrollOffset = aMetrics.GetLayoutScrollOffset();
+  if (aMetrics.GetContentTopInset() > 0 ||
+      aMetrics.GetContentBottomInset() > 0) {
+    // Gecko clamps its layout viewport to the document. The visual offset
+    // still includes the insets so the callback transform can account for them.
+    const CSSRect& scrollableRect = aMetrics.GetScrollableRect();
+    const CSSCoord scrollTop = scrollableRect.Y();
+    const CSSCoord scrollBottom =
+        std::max(scrollTop, CSSCoord(scrollableRect.YMost() -
+                                     aMetrics.GetLayoutViewport().Height()));
+    mLayoutScrollOffset.y =
+        std::clamp(mLayoutScrollOffset.y, scrollTop, scrollBottom);
+  }
   mZoom = aMetrics.GetZoom();
   mDevPixelsPerCSSPixel = aMetrics.GetDevPixelsPerCSSPixel();
 }
