+void AsyncScrollThumbTransformer::FitThumbInUnobscuredTrack(const Axis& aAxis) {
+  const float toParentLayer =
+      (mMetrics.GetDevPixelsPerCSSPixel() * LayoutDeviceToParentLayerScale(1.0))
+          .scale;
+  const OuterCSSCoord scrollTrackOrigin =
+      aAxis.GetPointOffset(
+          mMetrics.CalculateCompositionBoundsInOuterCssPixels().TopLeft()) +
+      mScrollbarData.mScrollTrackStart;
+
+  // Where the thumb is after the transforms applied so far.
+  const float thumbScale = aAxis.GetTransformScale(mScrollbarTransform);
+  const OuterCSSCoord thumbStart =
+      (scrollTrackOrigin + mScrollbarData.mThumbStart) * thumbScale +
+      OuterCSSCoord(aAxis.GetTransformTranslation(mScrollbarTransform).value /
+                    toParentLayer) -
+      scrollTrackOrigin;
+  const OuterCSSCoord thumbLength = mScrollbarData.mThumbLength * thumbScale;
+
+  const CSSRect visualViewport = mApzc->GetCurrentAsyncVisualViewport(
+      AsyncPanZoomController::eForCompositing);
+  const CSSRect scrollableRect =
+      mMetrics.GetScrollableRectWithContentInsets(mMetrics.GetZoom());
+  const CSSCoord scrollRange =
+      aAxis.GetRectLength(scrollableRect) - aAxis.GetRectLength(visualViewport);
+  if (scrollRange <= 0) {
+    return;
+  }
+
+  const auto [unobscuredStart, unobscuredEnd] =
+      mApzc->GetUnobscuredScrollTrack(mScrollbarData);
+  const float progress = (aAxis.GetRectOffset(visualViewport) -
+                          aAxis.GetRectOffset(scrollableRect)) /
+                         scrollRange;
+  const OuterCSSCoord fittedThumbStart =
+      unobscuredStart +
+      (unobscuredEnd - unobscuredStart - thumbLength) * progress;
+  TranslateThumb(aAxis, fittedThumbStart - thumbStart);
+}
