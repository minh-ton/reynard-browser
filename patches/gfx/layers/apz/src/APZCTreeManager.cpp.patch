+ScreenPoint APZCTreeManager::ComputeStickyMarginsOffset(
+    const StickyPositionInfo& aStickyInfo, const AsyncPanZoomController* aApzc,
+    AsyncTransformConsumer aMode, const MutexAutoLock& aProofOfMapLock) const {
+  ScreenPoint result;
