+  const float asyncZoom = aApzc->GetCurrentPinchZoomScale(aMode).scale /
+                          aApzc->GetCumulativeResolution().scale;
+  float ancestorOffset = 0;
+  float ancestorOffsetWithoutMargins = 0;
+
+  // WebRender includes each parent's sticky movement when positioning children.
+  for (const auto& range : aStickyInfo.mScrollRanges) {
+    result = ScreenPoint();
+    if ((range.mSides & SideBits::eTopBottom) == SideBits::eNone) {
+      continue;
+    }
+    const float scrollDelta = -translation.y * asyncZoom - ancestorOffset;
+    const float innerTop = range.mInner.YMost() * asyncZoom;
+    const float outerTop = range.mOuter.YMost() * asyncZoom;
+    const float innerBottom = range.mInner.Y() * asyncZoom;
+    const float outerBottom = range.mOuter.Y() * asyncZoom;
+    auto stickyOffset = [&](float aDelta) {
+      return std::clamp(aDelta, innerTop, outerTop) -
+             std::clamp(0.0f, innerTop, outerTop) +
+             std::clamp(aDelta, outerBottom, innerBottom) -
+             std::clamp(0.0f, outerBottom, innerBottom);
