+#ifdef MOZ_WIDGET_UIKIT
+NativeTextInputScrollUpdate
+AsyncPanZoomController::GetNativeTextInputScrollUpdate() const {
+  RecursiveMutexAutoLock lock(mRecursiveMutex);
+  NativeTextInputScrollUpdate update;
+  update.mGuid = GetGuid();
+  update.mGeneration = Metrics().GetScrollGeneration();
+  update.mVisualOffset = GetEffectiveScrollOffset(eForCompositing, lock);
+  update.mLayoutOffset =
+      GetEffectiveLayoutViewport(eForCompositing, lock).TopLeft();
+  update.mZoom = GetEffectiveZoom(eForCompositing, lock).scale;
+
+  // Use the same scale as WebRender's scroll offsets.
+  const CSSToParentLayerScale overscrollScale =
+      Metrics().LayersPixelsPerCSSPixel() * LayerToParentLayerScale(1.0f);
+  const CSSPoint overscrollOffset = GetOverscrollTransform(eForCompositing)
+                                        .TransformPoint(ParentLayerPoint()) /
+                                    overscrollScale;
+
+  // Shift both offsets so fixed content stays still during the bounce.
+  update.mVisualOffset -= overscrollOffset;
+  update.mLayoutOffset -= overscrollOffset;
+  update.mScrolling =
+      IsTransformingState(mState) || overscrollOffset != CSSPoint();
+
+  if (!update.mScrolling) {
+    const auto transform = GetCurrentAsyncTransform(
+        eForCompositing, {AsyncTransformComponent::eLayout});
+    update.mScrolling =
+        gfx::RoundedToInt(transform.mTranslation) != ParentLayerIntPoint();
+  }
+
+  return update;
+}
+#endif
