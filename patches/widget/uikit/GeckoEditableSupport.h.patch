+// MARK: - Coordinate Conversion Utilities
+
+inline mozilla::LayoutDeviceIntPoint UIKitPointsToDevPixels(
+    CGPoint aPoint, CGFloat aBackingScale) {
+  return mozilla::LayoutDeviceIntPoint(
+      static_cast<int32_t>(std::lround(aPoint.x * aBackingScale)),
+      static_cast<int32_t>(std::lround(aPoint.y * aBackingScale)));
+}
+
+inline CGRect DevPixelsToUIKitPoints(const mozilla::LayoutDeviceRect& aRect,
+                                     CGFloat aBackingScale) {
+  return CGRectMake((CGFloat)aRect.x / aBackingScale,
+                    (CGFloat)aRect.y / aBackingScale,
+                    (CGFloat)aRect.width / aBackingScale,
+                    (CGFloat)aRect.height / aBackingScale);
+}
+
+inline CGRect DevPixelsToUIKitPoints(const mozilla::LayoutDeviceIntRect& aRect,
+                                     CGFloat aBackingScale) {
+  return DevPixelsToUIKitPoints(
+      mozilla::LayoutDeviceRect(aRect.x, aRect.y, aRect.width, aRect.height),
+      aBackingScale);
+}
+
+// MARK: - Geometry Utilities
+
+inline bool ClipCGRectToBounds(CGRect& aRect, const CGRect& aBounds) {
+  if (CGRectIsNull(aRect) || CGRectIsEmpty(aRect) || CGRectIsNull(aBounds) ||
+      CGRectIsEmpty(aBounds)) {
+    aRect = CGRectZero;
+    return false;
+  }
+
+  CGRect clippedRect =
+      CGRectIntersection(CGRectStandardize(aRect), CGRectStandardize(aBounds));
+  if (CGRectIsNull(clippedRect) || CGRectIsEmpty(clippedRect)) {
+    aRect = CGRectZero;
+    return false;
+  }
+
+  aRect = clippedRect;
+  return true;
+}
+
+// MARK: - Credential Utilities
+
+inline NSInteger EffectiveOriginPort(NSURLComponents* aComponents) {
+  if (aComponents.port) {
+    return aComponents.port.integerValue;
+  }
+  NSString* scheme = aComponents.scheme.lowercaseString;
+  if ([scheme isEqualToString:@"http"]) {
+    return 80;
+  }
+  if ([scheme isEqualToString:@"https"]) {
+    return 443;
+  }
+  return NSNotFound;
+}
+
+inline BOOL CredentialOriginsMatch(NSURL* aDocumentURL,
+                                   NSString* aExpectedOrigin) {
+  NSURLComponents* documentOrigin =
+      [NSURLComponents componentsWithURL:aDocumentURL
+                 resolvingAgainstBaseURL:NO];
+  NSURLComponents* expectedOrigin =
+      [NSURLComponents componentsWithString:aExpectedOrigin];
+  NSString* documentScheme = documentOrigin.scheme.lowercaseString;
+  NSString* expectedScheme = expectedOrigin.scheme.lowercaseString;
+  NSString* documentHost = documentOrigin.host.lowercaseString;
+  NSString* expectedHost = expectedOrigin.host.lowercaseString;
+  if (!documentScheme || !expectedScheme || !documentHost || !expectedHost) {
+    return NO;
+  }
+  if (![documentScheme isEqualToString:expectedScheme] ||
+      ![documentHost isEqualToString:expectedHost]) {
+    return NO;
+  }
+  return EffectiveOriginPort(documentOrigin) ==
+         EffectiveOriginPort(expectedOrigin);
+}
