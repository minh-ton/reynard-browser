+template <typename T>
+void DispatchToPage(nsWindow* aWindow, const nsAString& aEvent, T&& aData) {
+  AssertIsOnMainThread();
+  if (!aWindow) {
+    return;
+  }
+
+  if (EventDispatcher* dispatcher = aWindow->GetEventDispatcher()) {
+    dispatcher->Dispatch(aEvent, std::forward<T>(aData));
+  }
+}
