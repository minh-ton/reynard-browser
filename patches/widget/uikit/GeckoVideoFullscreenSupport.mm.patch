+@interface GeckoAVPlayerLayer : CALayer
+@property(nonatomic, copy) NSString* videoGravity;
+@property(nonatomic, getter=isReadyForDisplay) BOOL readyForDisplay;
+@property(nonatomic, retain) AVPlayerController* playerController;
+@property(nonatomic, copy) NSDictionary* pixelBufferAttributes;
+@property(nonatomic) CGSize videoDimensions;
+@property(nonatomic, readonly) CGRect videoRect;
+@property(nonatomic) UIEdgeInsets legibleContentInsets;
+@property(nonatomic, getter=isLegibleDisplayEnabled) BOOL legibleDisplayEnabled;
+@end
+
+@implementation GeckoAVPlayerLayer
+
+- (instancetype)init {
+  if ((self = [super init])) {
+    self.masksToBounds = YES;
+    self.videoGravity = AVLayerVideoGravityResizeAspect;
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [_videoGravity release];
+  [_playerController release];
+  [_pixelBufferAttributes release];
+  [super dealloc];
+}
+
+- (void)setVideoGravity:(NSString*)videoGravity {
+  [_videoGravity release];
+  _videoGravity = [videoGravity copy];
+
+  if ([videoGravity isEqualToString:AVLayerVideoGravityResizeAspectFill]) {
+    self.contentsGravity = kCAGravityResizeAspectFill;
+  } else if ([videoGravity isEqualToString:AVLayerVideoGravityResize]) {
+    self.contentsGravity = kCAGravityResize;
+  } else {
+    self.contentsGravity = kCAGravityResizeAspect;
+  }
+}
+
+- (CGRect)videoRect {
+  CGSize bounds = self.bounds.size;
+  bool isResize = [_videoGravity isEqualToString:AVLayerVideoGravityResize];
+  if (isResize || _videoDimensions.width <= 0 || _videoDimensions.height <= 0) {
+    return self.bounds;
+  }
+
+  CGFloat widthScale = bounds.width / _videoDimensions.width;
+  CGFloat heightScale = bounds.height / _videoDimensions.height;
+  CGFloat scale =
+      [_videoGravity isEqualToString:AVLayerVideoGravityResizeAspectFill]
+          ? std::max(widthScale, heightScale)
+          : std::min(widthScale, heightScale);
+  CGSize size = CGSizeMake(_videoDimensions.width * scale,
+                           _videoDimensions.height * scale);
+  return CGRectMake((bounds.width - size.width) / 2,
+                    (bounds.height - size.height) / 2, size.width, size.height);
+}
+
++ (NSSet*)keyPathsForValuesAffectingVideoRect {
+  return [NSSet setWithObjects:@"videoDimensions", @"videoGravity", nil];
+}
+
+@end
