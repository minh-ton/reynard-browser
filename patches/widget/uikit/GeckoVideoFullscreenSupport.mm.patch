+class VideoFrameTarget final {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(VideoFrameTarget)
+
+  explicit VideoFrameTarget(CALayer* aLayer) { SetLayer(aLayer); }
+
+  void SetLayer(CALayer* aLayer) {
+    AssertIsOnMainThread();
+    [mLayer release];
+    mLayer = [aLayer retain];
+  }
+
+  void ShowFrame(CFTypeRefPtr<IOSurfaceRef> aSurface) {
+    AssertIsOnMainThread();
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    mLayer.contents = (id)aSurface.get();
+    [CATransaction commit];
+  }
+
+ private:
+  ~VideoFrameTarget() { [mLayer release]; }
+
+  CALayer* mLayer = nil;
+};
