+- (void)updateWithState:(NSDictionary*)state {
+  double duration = [state[@"duration"] doubleValue];
+  if (duration >= std::exp2(32)) {
+    duration = INFINITY;
+  }
+
+  self.contentDuration = duration;
+  self.contentDurationWithinEndTimes = duration;
+  self.contentDimensions = CGSizeMake([state[@"videoWidth"] doubleValue],
+                                      [state[@"videoHeight"] doubleValue]);
+
+  double playbackRate = [state[@"playbackRate"] doubleValue];
+  if (_defaultPlaybackRate != playbackRate) {
+    [self willChangeValueForKey:@"defaultPlaybackRate"];
+    _defaultPlaybackRate = playbackRate;
+    [self didChangeValueForKey:@"defaultPlaybackRate"];
+  }
+
+  double rate = [state[@"paused"] boolValue] ? 0 : playbackRate;
+  if (_rate != rate) {
+    [self willChangeValueForKey:@"rate"];
+    _rate = rate;
+    [self didChangeValueForKey:@"rate"];
+  }
+
+  BOOL muted = [state[@"muted"] boolValue];
+  if (_muted != muted) {
+    [self willChangeValueForKey:@"muted"];
+    _muted = muted;
+    [self didChangeValueForKey:@"muted"];
+  }
+
+  if (!_isScrubbing) {
+    NSTimeInterval anchorTimeStamp =
+        _rate ? [AVValueTiming currentTimeStamp] : NAN;
+    self.timing = [AVValueTiming
+        valueTimingWithAnchorValue:[state[@"currentTime"] doubleValue]
+                   anchorTimeStamp:anchorTimeStamp
+                              rate:0];
+  }
+
+  double bufferedTime = [state[@"bufferedTime"] doubleValue];
+  self.loadedTimeRanges =
+      @[ @0, @(duration > 0 ? bufferedTime / duration : 0) ];
+
+  NSMutableArray* seekableTimeRanges = [NSMutableArray array];
+  for (NSArray* range in state[@"seekable"]) {
+    CMTime start = CMTimeMakeWithSeconds([range[0] doubleValue], 1000);
+    CMTime end = CMTimeMakeWithSeconds([range[1] doubleValue], 1000);
+    [seekableTimeRanges
+        addObject:[NSValue valueWithCMTimeRange:CMTimeRangeFromTimeToTime(
+                                                    start, end)]];
+  }
+  self.seekableTimeRanges = seekableTimeRanges;
+}
