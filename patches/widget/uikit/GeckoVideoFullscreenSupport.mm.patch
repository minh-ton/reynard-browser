+  [oldController release];
+}
+
+- (BOOL)respondsToSelector:(SEL)selector {
+  return [self.controller respondsToSelector:selector];
+}
+
+- (id)forwardingTargetForSelector:(SEL)selector {
+  return self.controller;
+}
+
+- (id)valueForKey:(NSString*)key {
+  return [[self targetForKeyPath:key] valueForKey:key];
+}
+
+- (id)valueForKeyPath:(NSString*)keyPath {
+  return [[self targetForKeyPath:keyPath] valueForKeyPath:keyPath];
+}
+
+- (void)addObserver:(NSObject*)observer
+         forKeyPath:(NSString*)keyPath
+            options:(NSKeyValueObservingOptions)options
+            context:(void*)context {
+  [[self targetForKeyPath:keyPath] addObserver:observer
+                                    forKeyPath:keyPath
+                                       options:options
+                                       context:context];
+}
+
+- (void)removeObserver:(NSObject*)observer
+            forKeyPath:(NSString*)keyPath
+               context:(void*)context {
+  [[self targetForKeyPath:keyPath] removeObserver:observer
+                                       forKeyPath:keyPath
+                                          context:context];
+}
+
+- (void)removeObserver:(NSObject*)observer forKeyPath:(NSString*)keyPath {
+  [[self targetForKeyPath:keyPath] removeObserver:observer forKeyPath:keyPath];
+}
+
+- (NSObject*)targetForKeyPath:(NSString*)keyPath {
+  GeckoAVPlayerController* controller = self.controller;
+  NSString* key = [keyPath componentsSeparatedByString:@"."].firstObject;
+  if (class_getProperty([controller class], key.UTF8String)) {
+    return controller;
+  }
+  return controller.playerControllerProxy;
+}
+
+@end
+
+static Class GeckoAVPlayerControllerForwarderClass() {
+  static Class sForwarderClass = nil;
+  if (sForwarderClass) {
+    return sForwarderClass;
+  }
+
+  Class superclass = [AVPlayerController class];
+  Class forwarderClass = objc_allocateClassPair(
+      superclass, "GeckoAVPlayerControllerForwarderSubclass", 0);
+  class_addIvar(forwarderClass, "_controller", sizeof(id), log2(sizeof(id)),
+                @encode(id));
+  objc_registerClassPair(forwarderClass);
+
+  unsigned int count = 0;
+  Method* methods = class_copyMethodList(superclass, &count);
+  for (unsigned int i = 0; i < count; i++) {
+    SEL selector = method_getName(methods[i]);
+    if (sel_getName(selector)[0] == '.') {
+      continue;
+    }
+    class_addMethod(forwarderClass, selector, (IMP)_objc_msgForward,
+                    method_getTypeEncoding(methods[i]));
+  }
+  free(methods);
+
+  methods =
+      class_copyMethodList([GeckoAVPlayerControllerForwarder class], &count);
+  for (unsigned int i = 0; i < count; i++) {
+    class_replaceMethod(forwarderClass, method_getName(methods[i]),
+                        method_getImplementation(methods[i]),
+                        method_getTypeEncoding(methods[i]));
+  }
+  free(methods);
+
+  sForwarderClass = forwarderClass;
+  return sForwarderClass;
+}
