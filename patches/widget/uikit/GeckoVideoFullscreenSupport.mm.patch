+NS_IMPL_ISUPPORTS(VideoFullscreenListener, nsIGeckoViewEventListener)
+
+NS_IMETHODIMP VideoFullscreenListener::OnEvent(
+    const nsAString& aEvent, JS::Handle<JS::Value> aData,
+    nsIGeckoViewEventCallback* aCallback) {
+  if (aEvent.EqualsLiteral(kCancelEvent)) {
+    [mSupport cancelPrepared];
+    return NS_OK;
+  }
+
+  NS_ENSURE_TRUE(aData.isObject(), NS_ERROR_INVALID_ARG);
+
+  dom::AutoJSAPI jsapi;
+  NS_ENSURE_TRUE(jsapi.Init(xpc::PrivilegedJunkScope()), NS_ERROR_FAILURE);
+
+  JSContext* cx = jsapi.cx();
+  JS::Rooted<JSObject*> data(cx, &aData.toObject());
+  NS_ENSURE_TRUE(JS_WrapObject(cx, &data), NS_ERROR_FAILURE);
+
+  CFTypeRefPtr<CFTypeRef> state;
+  nsresult rv = EventDispatcher::BoxBundle(cx, data, state);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  if (aEvent.EqualsLiteral(kPrepareEvent)) {
+    [mSupport prepareWithData:(NSDictionary*)state.get()];
+  } else if (aEvent.EqualsLiteral(kEnterEvent)) {
+    [mSupport enterWithState:(NSDictionary*)state.get()];
+  } else if (aEvent.EqualsLiteral(kExitEvent)) {
+    id rect = ((NSDictionary*)state.get())[@"videoRect"];
+    [mSupport
+        exitToRect:[rect isKindOfClass:[NSDictionary class]] ? rect : nil];
+  } else {
+    [mSupport updateWithState:(NSDictionary*)state.get()];
+  }
+  return NS_OK;
+}
