+  CALayer* mVideoLayer;
+  RefPtr<VideoFrameTarget> mFrameTarget;
+  AVPlayerViewController* mPlayerViewController;
+  UIWindow* mWindow;
+  UIView* mSnapshotView;
+  GeckoVideoFullscreenState mState;
+  BOOL mExitPending;
+}
+
+- (instancetype)initWithGeckoChild:(nsWindow*)geckoChild {
+  if (!(self = [super init])) {
+    return nil;
+  }
+
+  mGeckoChild = geckoChild;
+  mListener = new VideoFullscreenListener(self);
+
+  EventDispatcher* dispatcher = geckoChild->GetEventDispatcher();
+  dom::AutoJSAPI jsapi;
+  if (!dispatcher || !jsapi.Init(xpc::PrivilegedJunkScope())) {
+    return self;
+  }
+
+  JSContext* cx = jsapi.cx();
+  for (const char* event :
+       {kPrepareEvent, kEnterEvent, kUpdateEvent, kExitEvent, kCancelEvent}) {
+    JS::Rooted<JSString*> name(cx, JS_NewStringCopyZ(cx, event));
+    if (!name) {
+      break;
+    }
+    JS::Rooted<JS::Value> value(cx, JS::StringValue(name));
+    dispatcher->RegisterListener(mListener, value, cx);
+  }
+  return self;
+}
+
+- (void)widgetDestroyed {
+  [self stopPictureInPicture];
+  [self tearDown];
+  mListener->Disconnect();
+  mGeckoChild = nullptr;
+}
+
+- (void)prepareWithData:(NSDictionary*)data {
+  if (mState != GeckoVideoFullscreenStateNone || !mGeckoChild) {
+    return;
+  }
+
+  UIView* geckoView = (UIView*)mGeckoChild->GetNativeData(NS_NATIVE_WIDGET);
+  UIWindow* browserWindow = geckoView.window;
+  if (![self openPlayerInScene:browserWindow.windowScene video:data]) {
+    return;
+  }
+
+  mSnapshotView = [browserWindow snapshotViewAfterScreenUpdates:NO];
+  [mWindow.rootViewController.view insertSubview:mSnapshotView atIndex:0];
+
+  [self moveInlinePlayerToRect:data[@"videoRect"]];
+  mState = GeckoVideoFullscreenStatePrepared;
+}
+
+- (void)cancelPrepared {
+  if (mState == GeckoVideoFullscreenStatePrepared) {
+    [self tearDown];
+  }
+}
+
+- (void)moveInlinePlayerToRect:(NSDictionary*)rect {
+  UIView* geckoView = (UIView*)mGeckoChild->GetNativeData(NS_NATIVE_WIDGET);
+  CGFloat scale = geckoView.window.screen.scale;
+  CGRect videoRect = CGRectMake([rect[@"x"] doubleValue] / scale,
+                                [rect[@"y"] doubleValue] / scale,
+                                [rect[@"width"] doubleValue] / scale,
+                                [rect[@"height"] doubleValue] / scale);
+  // Both windows cover the scene, so their coordinates match. Converting
+  // through screen coordinates can use a stale position of the player window.
+  mPlayerViewController.view.frame = [mWindow.rootViewController.view
+      convertRect:[geckoView convertRect:videoRect toView:nil]
+         fromView:nil];
+}
+
+- (void)enterWithState:(NSDictionary*)state {
+  if (!mGeckoChild) {
+    return;
+  }
+
+  if (mState == GeckoVideoFullscreenStatePictureInPicture) {
+    [self startVideoFrames:state];
+    [self updateWithState:state];
+    [mPlayerViewController stopPictureInPicture];
+    return;
+  }
+
+  if (mState == GeckoVideoFullscreenStateNone) {
+    UIView* geckoView = (UIView*)mGeckoChild->GetNativeData(NS_NATIVE_WIDGET);
+    if (![self openPlayerInScene:geckoView.window.windowScene video:state]) {
+      return;
+    }
+  } else if (mState != GeckoVideoFullscreenStatePrepared) {
+    return;
+  }
+
+  [self updateWithState:state];
+  [mPlayerViewController.view layoutIfNeeded];
+
+  mState = GeckoVideoFullscreenStateEntering;
+  [mPlayerViewController
+      enterFullScreenAnimated:YES
+            completionHandler:^(BOOL success, NSError* error) {
+              if (!success) {
+                [self tearDown];
+                return;
+              }
+
+              mState = GeckoVideoFullscreenStateEntered;
+
+              [mSnapshotView removeFromSuperview];
+              mSnapshotView = nil;
+
+              if (mExitPending) {
+                [self exitToRect:nil];
+              }
+            }];
+}
+
+- (BOOL)openPlayerInScene:(UIWindowScene*)windowScene
+                    video:(NSDictionary*)video {
+  if (!windowScene) {
+    return NO;
+  }
+
+  mExitPending = NO;
+
+  mPlayerController = [[GeckoAVPlayerController alloc] initWithSupport:self];
+  mPlayerLayerView = [[GeckoAVPlayerLayerView alloc] initWithFrame:CGRectZero];
+  mPlayerLayerView.support = self;
+  mVideoLayer = mPlayerLayerView.layer;
+
+  GeckoAVPlayerControllerForwarder* forwarder =
+      [[[GeckoAVPlayerControllerForwarderClass() alloc] init] autorelease];
+  forwarder.controller = mPlayerController;
+
+  mPlayerViewController =
+      [[AVPlayerViewController alloc] initWithPlayerLayerView:mPlayerLayerView];
+  mPlayerViewController.delegate = self;
+  mPlayerViewController.updatesNowPlayingInfoCenter = NO;
+  [mPlayerViewController setPlayerController:(AVPlayerController*)forwarder];
+
+  UIViewController* rootViewController =
+      [[[UIViewController alloc] init] autorelease];
+  mWindow = [[UIWindow alloc] initWithWindowScene:windowScene];
+  mWindow.windowLevel = UIWindowLevelNormal + 1;
+  mWindow.rootViewController = rootViewController;
+  [rootViewController addChildViewController:mPlayerViewController];
+  mPlayerViewController.view.frame = rootViewController.view.bounds;
+  [rootViewController.view addSubview:mPlayerViewController.view];
+  [mPlayerViewController didMoveToParentViewController:rootViewController];
+  mWindow.hidden = NO;
+
+  mFrameTarget = new VideoFrameTarget(mVideoLayer);
+  [self startVideoFrames:video];
+  [self setPageHidden:YES];
+  return YES;
+}
+
+- (void)startVideoFrames:(NSDictionary*)video {
+  mGeckoChild->StartVideoFrames(
+      [video[@"pid"] intValue], [video[@"videoHandle"] unsignedLongLongValue],
+      [target = mFrameTarget](CFTypeRefPtr<IOSurfaceRef> aSurface) {
+        NS_DispatchToMainThread(NS_NewRunnableFunction(
+            "VideoFrameTarget::ShowFrame",
+            [target, aSurface] { target->ShowFrame(aSurface); }));
+      });
+}
+
+- (void)updateWithState:(NSDictionary*)state {
+  [mPlayerController updateWithState:state];
+  ((GeckoAVPlayerLayer*)mVideoLayer).videoDimensions =
+      mPlayerController.contentDimensions;
+
+  BOOL allowsPictureInPicture = ![state[@"disablePictureInPicture"] boolValue];
+  if (mPlayerViewController.allowsPictureInPicturePlayback ==
+      allowsPictureInPicture) {
+    return;
+  }
+
+  mPlayerViewController.allowsPictureInPicturePlayback = allowsPictureInPicture;
+
+  if (![mPlayerViewController respondsToSelector:@selector(configuration)]) {
+    return;
+  }
+
+  AVPlayerViewControllerConfiguration* configuration =
+      mPlayerViewController.configuration;
+  if (allowsPictureInPicture) {
+    configuration.excludedControls &=
+        ~AVPlayerViewControllerControlsPictureInPicture;
+  } else {
+    configuration.excludedControls |=
+        AVPlayerViewControllerControlsPictureInPicture;
+  }
+  mPlayerViewController.configuration = configuration;
+}
+
+- (void)routeVideoToLayer:(CALayer*)layer {
+  mVideoLayer.contents = nil;
+  mVideoLayer = layer;
+  mFrameTarget->SetLayer(layer);
+}
+
+- (void)exitToRect:(NSDictionary*)rect {
+  if (mState != GeckoVideoFullscreenStateEntering &&
+      mState != GeckoVideoFullscreenStateEntered &&
+      mState != GeckoVideoFullscreenStatePictureInPicture) {
+    return;
+  }
+
+  if (rect) {
+    [self moveInlinePlayerToRect:rect];
+  }
+
+  if (mState == GeckoVideoFullscreenStatePictureInPicture) {
+    if (!rect) {
+      [self stopPictureInPicture];
+    }
+    return;
+  }
+
+  if (mState == GeckoVideoFullscreenStateEntering) {
+    mExitPending = YES;
+    return;
+  }
+
+  mState = GeckoVideoFullscreenStateExiting;
+  [self setPageHidden:NO];
+  [mPlayerViewController
+      exitFullScreenAnimated:YES
+           completionHandler:^(BOOL success, NSError* error) {
+             [self tearDown];
+           }];
+}
+
+- (void)stopPictureInPicture {
+  if (mState != GeckoVideoFullscreenStatePictureInPicture) {
+    return;
+  }
+
+  mState = GeckoVideoFullscreenStateExiting;
+  [mPlayerViewController stopPictureInPicture];
+}
+
+- (void)tearDown {
+  if (!mPlayerViewController) {
+    return;
+  }
+
+  mState = GeckoVideoFullscreenStateNone;
+  if (mGeckoChild) {
+    mGeckoChild->StopVideoFrames();
+  }
+  mFrameTarget->SetLayer(nil);
+  mFrameTarget = nullptr;
+  [self setPageHidden:NO];
+  DispatchToPage(mGeckoChild, u"GeckoView:VideoFullscreen:Close"_ns,
+                 JS::NullHandleValue);
+  mPlayerController.support = nil;
+  mPlayerLayerView.support = nil;
+  mVideoLayer = nil;
+  mWindow.hidden = YES;
+  mSnapshotView = nil;
+
+  [mWindow release];
+  mWindow = nil;
+  [mPlayerViewController release];
+  mPlayerViewController = nil;
+  [mPlayerLayerView release];
+  mPlayerLayerView = nil;
+  [mPlayerController release];
+  mPlayerController = nil;
+}
+
+- (void)setPageHidden:(BOOL)hidden {
+  if (!mGeckoChild) {
+    return;
+  }
+
+  UIView* geckoView = (UIView*)mGeckoChild->GetNativeData(NS_NATIVE_WIDGET);
+  geckoView.alpha = hidden ? 0 : 1;
+  mGeckoChild->SetCoveredByVideoPlayer(hidden);
+}
+
+- (void)play {
+  DispatchToPage(mGeckoChild, u"GeckoView:VideoFullscreen:Play"_ns,
+                 JS::NullHandleValue);
+}
+
+- (void)pause {
+  DispatchToPage(mGeckoChild, u"GeckoView:VideoFullscreen:Pause"_ns,
+                 JS::NullHandleValue);
+}
+
+- (void)seekToTime:(double)time {
+  DispatchToPage(mGeckoChild, u"GeckoView:VideoFullscreen:Seek"_ns, time);
+}
+
+- (void)setPlaybackRate:(double)rate {
+  DispatchToPage(mGeckoChild, u"GeckoView:VideoFullscreen:SetRate"_ns, rate);
+}
+
+- (void)setMuted:(BOOL)muted {
+  DispatchToPage(mGeckoChild, u"GeckoView:VideoFullscreen:SetMuted"_ns,
+                 bool(muted));
+}
+
+- (BOOL)playerViewController:(AVPlayerViewController*)playerViewController
+    shouldExitFullScreenWithReason:
+        (AVPlayerViewControllerExitFullScreenReason)reason {
+  if (reason ==
+      AVPlayerViewControllerExitFullScreenReasonPictureInPictureStarted) {
+    return NO;
+  }
+
+  if (reason == AVPlayerViewControllerExitFullScreenReasonDoneButtonTapped) {
+    [self pause];
+  }
+
+  DispatchToPage(mGeckoChild, u"GeckoViewContent:ExitFullScreen"_ns,
+                 JS::NullHandleValue);
+  return NO;
+}
+
+- (BOOL)playerViewControllerShouldAutomaticallyDismissAtPictureInPictureStart:
+    (AVPlayerViewController*)playerViewController {
+  return NO;
+}
+
+- (void)playerViewControllerDidStartPictureInPicture:
+    (AVPlayerViewController*)playerViewController {
+  if (mState != GeckoVideoFullscreenStateEntered) {
+    return;
+  }
+
+  mState = GeckoVideoFullscreenStatePictureInPicture;
+  [self setPageHidden:NO];
+  DispatchToPage(mGeckoChild, u"GeckoView:VideoFullscreen:PictureInPicture"_ns,
+                 JS::NullHandleValue);
+  [mPlayerViewController.view layoutIfNeeded];
+  [mPlayerViewController
+      exitFullScreenAnimated:YES
+           completionHandler:^(BOOL success, NSError* error) {
+             mWindow.hidden = YES;
+           }];
+  DispatchToPage(mGeckoChild, u"GeckoViewContent:ExitFullScreen"_ns,
+                 JS::NullHandleValue);
+}
+
+- (void)playerViewController:(AVPlayerViewController*)playerViewController
+    restoreUserInterfaceForPictureInPictureStopWithCompletionHandler:
+        (void (^)(BOOL restored))completionHandler {
+  if (mState != GeckoVideoFullscreenStatePictureInPicture) {
+    completionHandler(NO);
+    return;
+  }
+
+  if (EventDispatcher* dispatcher =
+          mGeckoChild ? mGeckoChild->GetEventDispatcher() : nullptr) {
+    dispatcher->DispatchToEmbedder(u"GeckoView:PictureInPictureRestore"_ns);
+  }
+
+  DispatchToPage(mGeckoChild, u"GeckoView:VideoFullscreen:Restore"_ns,
+                 JS::NullHandleValue);
+
+  mState = GeckoVideoFullscreenStateEntering;
+  mExitPending = NO;
+  mWindow.hidden = NO;
+  mPlayerViewController.view.hidden = NO;
+  [mPlayerViewController.view layoutIfNeeded];
+  [self setPageHidden:YES];
+  [mPlayerViewController
+      enterFullScreenAnimated:NO
+            completionHandler:^(BOOL success, NSError* error) {
+              completionHandler(success);
+              if (!success) {
+                [self tearDown];
+                return;
+              }
+
+              mState = GeckoVideoFullscreenStateEntered;
+              if (mExitPending) {
+                [self exitToRect:nil];
+              }
+            }];
+}
+
+- (void)playerViewControllerDidStopPictureInPicture:
+    (AVPlayerViewController*)playerViewController {
+  if (mState == GeckoVideoFullscreenStatePictureInPicture ||
+      mState == GeckoVideoFullscreenStateExiting) {
+    [self tearDown];
+  }
+}
+
+@end
