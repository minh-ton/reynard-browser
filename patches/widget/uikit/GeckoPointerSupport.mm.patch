+@implementation GeckoScrollGestureRecognizer {
+  NSTimeInterval mScrollTimestamp;
+  BOOL mIsContinuousScroll;
+}
+
+- (void)_scrollingChangedWithEvent:(UIEvent*)event API_AVAILABLE(ios(13.4)) {
+  mScrollTimestamp = event.timestamp;
+  mIsContinuousScroll = [event _scrollType] == UIScrollTypeContinuous;
+  [self _setiOSMacUseNonacceleratedDelta:[event _scrollType] ==
+                                         UIScrollTypeContinuous];
+  [super _scrollingChangedWithEvent:event];
+}
+
+- (NSTimeInterval)scrollTimestamp {
+  return mScrollTimestamp;
+}
+
+- (BOOL)isContinuousScroll {
+  return mIsContinuousScroll;
+}
+
+@end
