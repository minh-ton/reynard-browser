+// Use the string tokenizer for characters, words, and sentences. Ask Gecko for
+// lines and paragraphs since these depend on page layout.
+@interface ChildViewTextTokenizer : UITextInputStringTokenizer {
+  ChildView* mTextView;
+}
+- (instancetype)initWithGeckoView:(ChildView*)aView;
+- (UITextStorageDirection)storageDirection:(UITextDirection)aDirection
+                                atPosition:(UITextPosition*)aPosition;
+- (UITextRange*)layoutRangeAtPosition:(UITextPosition*)aPosition
+                          granularity:(UITextGranularity)aGranularity
+                            direction:(UITextDirection)aDirection;
+@end
+
+@implementation ChildViewTextTokenizer
+
+- (instancetype)initWithGeckoView:(ChildView*)aView {
+  self = [super initWithTextInput:aView];
+  if (self) {
+    mTextView = aView;
+  }
+  return self;
+}
+
+- (UITextStorageDirection)storageDirection:(UITextDirection)aDirection
+                                atPosition:(UITextPosition*)aPosition {
+  if (aDirection == UITextStorageDirectionForward ||
+      aDirection == UITextStorageDirectionBackward) {
+    return static_cast<UITextStorageDirection>(aDirection);
+  }
+
+  ChildViewTextPosition* position = [mTextView textPosForPosition:aPosition];
+  RefPtr<widget::TextInputHandler> handler = [mTextView textHandler];
+  if (!position || !handler) {
+    return UITextStorageDirectionForward;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::WritingDirection;
+  request.mDirection = NativeDirection(aDirection);
+  request.mOffset = position.offset;
+  request.mAssociateWithNext =
+      position.affinity == UITextStorageDirectionForward;
+  NativeTextInputReply reply;
+  if (!handler->QueryNativeTextInput(request, reply)) {
+    return UITextStorageDirectionForward;
+  }
+
+  return reply.mBackward ? UITextStorageDirectionBackward
+                         : UITextStorageDirectionForward;
+}
+
+- (UITextRange*)layoutRangeAtPosition:(UITextPosition*)aPosition
+                          granularity:(UITextGranularity)aGranularity
+                            direction:(UITextDirection)aDirection {
+  ChildViewTextPosition* position = [mTextView textPosForPosition:aPosition];
+  RefPtr<widget::TextInputHandler> handler = [mTextView textHandler];
+  if (!position || !handler) {
+    return nil;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = aGranularity == UITextGranularityParagraph
+                       ? NativeTextInputQuery::ParagraphBoundary
+                       : NativeTextInputQuery::LineBoundary;
+  request.mOffset = position.offset;
+  request.mAssociateWithNext = !IsBackwardDirection(aDirection);
+  request.mDirection = NativeTextInputDirection::Backward;
+  NativeTextInputReply start, end;
+  if (!handler->QueryNativeTextInput(request, start)) {
+    return nil;
+  }
+
+  request.mDirection = NativeTextInputDirection::Forward;
+  if (!handler->QueryNativeTextInput(request, end)) {
+    return nil;
+  }
+
+  if (start.mOffset == UINT32_MAX || end.mOffset < start.mOffset) {
+    return nil;
+  }
+
+  ChildViewTextPosition* startPosition = [ChildViewTextPosition
+      positionWithOffset:start.mOffset
+                affinity:start.mAssociateWithNext
+                             ? UITextStorageDirectionForward
+                             : UITextStorageDirectionBackward];
+  ChildViewTextPosition* endPosition = [ChildViewTextPosition
+      positionWithOffset:end.mOffset
+                affinity:end.mAssociateWithNext
+                             ? UITextStorageDirectionForward
+                             : UITextStorageDirectionBackward];
+  return [ChildViewTextRange rangeWithStart:startPosition end:endPosition];
+}
+
+- (UITextRange*)rangeEnclosingPosition:(UITextPosition*)aPosition
+                       withGranularity:(UITextGranularity)aGranularity
+                           inDirection:(UITextDirection)aDirection {
+  if (aGranularity == UITextGranularityLine ||
+      aGranularity == UITextGranularityParagraph) {
+    UITextStorageDirection direction = [self storageDirection:aDirection
+                                                   atPosition:aPosition];
+    UITextRange* range = [self layoutRangeAtPosition:aPosition
+                                         granularity:aGranularity
+                                           direction:direction];
+    if (!range || range.empty) {
+      return nil;
+    }
+
+    NSComparisonResult start = [mTextView comparePosition:aPosition
+                                               toPosition:range.start];
+    NSComparisonResult end = [mTextView comparePosition:aPosition
+                                             toPosition:range.end];
+    // At a boundary, use the line or paragraph on the requested side.
+    BOOL enclosed;
+    if (direction == UITextStorageDirectionBackward) {
+      enclosed = start == NSOrderedDescending && end != NSOrderedDescending;
+    } else {
+      enclosed = start != NSOrderedAscending && end == NSOrderedAscending;
+    }
+    return enclosed ? range : nil;
+  }
+
+  return [super rangeEnclosingPosition:aPosition
+                       withGranularity:aGranularity
+                           inDirection:aDirection];
+}
+
+- (BOOL)isPosition:(UITextPosition*)aPosition
+        atBoundary:(UITextGranularity)aGranularity
+       inDirection:(UITextDirection)aDirection {
+  if (aGranularity != UITextGranularityLine &&
+      aGranularity != UITextGranularityParagraph) {
+    return [super isPosition:aPosition
+                  atBoundary:aGranularity
+                 inDirection:aDirection];
+  }
+
+  UITextStorageDirection direction = [self storageDirection:aDirection
+                                                 atPosition:aPosition];
+  UITextRange* line =
+      [self layoutRangeAtPosition:aPosition
+                      granularity:aGranularity
+                        direction:direction == UITextStorageDirectionBackward
+                                      ? UITextStorageDirectionForward
+                                      : UITextStorageDirectionBackward];
+  UITextPosition* boundary =
+      direction == UITextStorageDirectionBackward ? line.start : line.end;
+  return boundary && [mTextView comparePosition:aPosition
+                                     toPosition:boundary] == NSOrderedSame;
+}
+
+- (UITextPosition*)positionFromPosition:(UITextPosition*)aPosition
+                             toBoundary:(UITextGranularity)aGranularity
+                            inDirection:(UITextDirection)aDirection {
+  if (aGranularity != UITextGranularityLine &&
+      aGranularity != UITextGranularityParagraph) {
+    return [super positionFromPosition:aPosition
+                            toBoundary:aGranularity
+                           inDirection:aDirection];
+  }
+
+  UITextStorageDirection direction = [self storageDirection:aDirection
+                                                 atPosition:aPosition];
+  UITextRange* line = [self layoutRangeAtPosition:aPosition
+                                      granularity:aGranularity
+                                        direction:direction];
+  UITextPosition* boundary =
+      direction == UITextStorageDirectionBackward ? line.start : line.end;
+  if (boundary && [mTextView comparePosition:aPosition
+                                  toPosition:boundary] == NSOrderedSame) {
+    UITextPosition* next =
+        [super positionFromPosition:aPosition
+                         toBoundary:UITextGranularityCharacter
+                        inDirection:direction];
+    if (!next || [mTextView comparePosition:aPosition
+                                 toPosition:next] == NSOrderedSame) {
+      return nil;
+    }
+
+    line = [self layoutRangeAtPosition:next
+                           granularity:aGranularity
+                             direction:direction];
+    boundary =
+        direction == UITextStorageDirectionBackward ? line.start : line.end;
+  }
+  return boundary;
+}
+
+- (BOOL)isPosition:(UITextPosition*)aPosition
+    withinTextUnit:(UITextGranularity)aGranularity
+       inDirection:(UITextDirection)aDirection {
+  if (aGranularity != UITextGranularityLine &&
+      aGranularity != UITextGranularityParagraph) {
+    return [super isPosition:aPosition
+              withinTextUnit:aGranularity
+                 inDirection:aDirection];
+  }
+
+  return [self rangeEnclosingPosition:aPosition
+                      withGranularity:aGranularity
+                          inDirection:aDirection] != nil;
+}
+
+@end
+
+// Let UIKit's undo manager use Gecko's undo history.
+@interface ChildViewUndoManager : NSUndoManager {
+  ChildView* mTextView;
+  BOOL mUndoing;
+  BOOL mRedoing;
+}
+- (instancetype)initWithTextInput:(ChildView*)aView;
+- (void)detachFromTextInput;
+@end
+
+@implementation ChildViewUndoManager
+
+- (instancetype)initWithTextInput:(ChildView*)aView {
+  self = [super init];
+  if (self) {
+    mTextView = aView;
+  }
+  return self;
+}
+
+- (void)detachFromTextInput {
+  mTextView = nil;
+}
+
+- (BOOL)canUndo {
+  return [mTextView canPerformAction:@selector(undo:) withSender:self];
+}
+
+- (BOOL)canRedo {
+  return [mTextView canPerformAction:@selector(redo:) withSender:self];
+}
+
+- (BOOL)isUndoing {
+  return mUndoing;
+}
+
+- (BOOL)isRedoing {
+  return mRedoing;
+}
+
+- (void)undo {
+  [[self retain] autorelease];
+  if (!self.canUndo || mUndoing || mRedoing) {
+    return;
+  }
+
+  mUndoing = YES;
+  [NSNotificationCenter.defaultCenter
+      postNotificationName:NSUndoManagerWillUndoChangeNotification
+                    object:self];
+  [mTextView undo:self];
+  mUndoing = NO;
+  [NSNotificationCenter.defaultCenter
+      postNotificationName:NSUndoManagerDidUndoChangeNotification
+                    object:self];
+}
+
+- (void)redo {
+  [[self retain] autorelease];
+  if (!self.canRedo || mUndoing || mRedoing) {
+    return;
+  }
+
+  mRedoing = YES;
+  [NSNotificationCenter.defaultCenter
+      postNotificationName:NSUndoManagerWillRedoChangeNotification
+                    object:self];
+  [mTextView redo:self];
+  mRedoing = NO;
+  [NSNotificationCenter.defaultCenter
+      postNotificationName:NSUndoManagerDidRedoChangeNotification
+                    object:self];
+}
+
+@end
