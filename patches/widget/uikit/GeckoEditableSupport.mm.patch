+  NSRange range = [self selectedRange];
+  return range.location != NSNotFound && range.length != 0;
+}
+
+- (UITextRange*)selectedTextRange {
+  NSRange range = [self selectedRange];
+  if (range.location == NSNotFound) {
+    return nil;
+  }
+
+  ChildViewTextRange* result = [self textRangeForRange:range];
+  if (!range.length) {
+    result.startPosition.affinity = mEditable.mSelectionAffinity;
+    result.endPosition.affinity = mEditable.mSelectionAffinity;
+  }
+  return result;
+}
+
+- (void)setSelectedTextRange:(UITextRange*)aRange {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler) {
+    return;
+  }
+
+  if (!aRange) {
+    NativeTextInputRequest request;
+    request.mQuery = NativeTextInputQuery::ClearSelection;
+    NativeTextInputReply reply;
+    if (handler->QueryNativeTextInput(request, reply)) {
+      handler->SynchronizeTextInputState();
+      [self selectionGeometryChanged];
+    }
+    return;
+  }
+
+  NSRange range = [self rangeForTextRange:aRange];
+  ChildViewTextPosition* end = [self textPosForPosition:aRange.end];
+  if (range.location == NSNotFound || !end) {
+    return;
+  }
+
+  BOOL forDeletion = mEditable.mPreparingBackwardDeletionSelection;
+  if (!forDeletion && range.length) {
+    UIKeyboardImpl* keyboard =
+        [NSClassFromString(@"UIKeyboardImpl") activeInstance];
+    if ([keyboard inputDelegate] == self) {
+      id<GeckoKeyboardDeletionState> deletionState =
+          [keyboard respondsToSelector:@selector(keyboardStateManager)]
+              ? [keyboard keyboardStateManager]
+              : (id<GeckoKeyboardDeletionState>)keyboard;
+      forDeletion =
+          [deletionState respondsToSelector:@selector(isAutoDeleteActive)] &&
+          [deletionState isAutoDeleteActive];
+    }
+  }
+
+  if (handler->SetSelectedRange(
+          range, end.affinity == UITextStorageDirectionForward, forDeletion)) {
+    mEditable.mSelectionAffinity = end.affinity;
+    // The keyboard selects text before calling deleteBackward. Wait until that
+    // finishes before drawing the selection.
+    [self selectionGeometryChanged];
+  }
+}
+
+- (UITextStorageDirection)selectionAffinity {
+  return mEditable.mSelectionAffinity;
+}
+
+- (void)setSelectionAffinity:(UITextStorageDirection)aAffinity {
+  if (mEditable.mSelectionAffinity == aAffinity) {
+    return;
+  }
+
+  mEditable.mSelectionAffinity = aAffinity;
+  NSRange selection = [self selectedRange];
+  if (selection.location == NSNotFound) {
+    return;
+  }
+
+  if (RefPtr<widget::TextInputHandler> handler = [self textHandler]) {
+    handler->SetSelectedRange(selection,
+                              aAffinity == UITextStorageDirectionForward);
+  }
+
+  [self refreshSelectionUI];
+}
+
+- (NSWritingDirection)baseWritingDirectionForPosition:(UITextPosition*)aPosition
+                                          inDirection:(UITextStorageDirection)
+                                                          aDirection {
+  ChildViewTextPosition* position = [self textPosForPosition:aPosition];
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!position || !handler) {
+    return NSWritingDirectionNatural;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::WritingDirection;
+  request.mOffset = position.offset;
+  request.mAssociateWithNext = aDirection == UITextStorageDirectionForward;
+  NativeTextInputReply reply;
+  if (!handler->QueryNativeTextInput(request, reply)) {
+    return NSWritingDirectionNatural;
+  }
+
+  return reply.mRTL ? NSWritingDirectionRightToLeft
+                    : NSWritingDirectionLeftToRight;
+}
+
+- (void)setBaseWritingDirection:(NSWritingDirection)aDirection
+                       forRange:(UITextRange*)aRange {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  NSRange range = [self rangeForTextRange:aRange];
+  NSRange selection = [self selectedRange];
+  if (!handler || range.location == NSNotFound) {
+    return;
+  }
+
+  if (!NSEqualRanges(range, selection) ||
+      aDirection == NSWritingDirectionNatural) {
+    return;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::SetWritingDirection;
+  request.mDirection = aDirection == NSWritingDirectionRightToLeft
+                           ? NativeTextInputDirection::Backward
+                           : NativeTextInputDirection::Forward;
+  NativeTextInputReply reply;
+  if (handler->QueryNativeTextInput(request, reply)) {
+    handler->SynchronizeTextInputState();
+    [self refreshSelectionUI];
+  }
+}
