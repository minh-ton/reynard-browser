+// MARK: - Text Interaction Delegate
+
+static id<GeckoTextSelectionInteraction> TextSelectionForAssistant(
+    id<GeckoTextInteractionAssistant> aAssistant) {
+  // Newer UIKit keeps selection on its controller instead of the view.
+  if ([aAssistant respondsToSelector:@selector(activeSelectionController)]) {
+    id<GeckoTextSelectionSource> controller =
+        [aAssistant activeSelectionController];
+    if ([controller respondsToSelector:@selector(selection)]) {
+      return controller.selection;
+    }
+  }
+
+  id<GeckoTextSelectionSource> view = [aAssistant textSelectionView];
+  return [view respondsToSelector:@selector(selection)] ? view.selection : nil;
+}
+
+@interface GeckoTextInteractionAssistantDelegate : NSObject {
+  id<GeckoTextInteractionAssistant> mAssistant;
+}
+- (instancetype)initWithAssistant:(id<GeckoTextInteractionAssistant>)aAssistant;
+- (id<GeckoTextRangeAdjustmentInteraction>)rangeAdjustment;
+- (void)attachToInteractions;
+- (void)detach;
+@end
+
+@implementation GeckoTextInteractionAssistantDelegate
+
+- (instancetype)initWithAssistant:
+    (id<GeckoTextInteractionAssistant>)aAssistant {
+  if ((self = [super init])) {
+    mAssistant = [aAssistant retain];
+    [self attachToInteractions];
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [mAssistant release];
+  [super dealloc];
+}
+
+- (id<GeckoTextRangeAdjustmentInteraction>)rangeAdjustment {
+  if (![mAssistant respondsToSelector:@selector(rangeAdjustmentInteraction)]) {
+    return nil;
+  }
+
+  if (![mAssistant respondsToSelector:@selector(textRangeAdjustmentInteraction:
+                                                didBeginAtPoint:)]) {
+    return nil;
+  }
+
+  id<GeckoTextRangeAdjustmentInteraction> adjustment =
+      mAssistant.rangeAdjustmentInteraction;
+  if (![adjustment respondsToSelector:@selector(adjustmentDelegate)] ||
+      ![adjustment respondsToSelector:@selector(setAdjustmentDelegate:)]) {
+    return nil;
+  }
+
+  return adjustment;
+}
+
+- (void)attachToInteractions {
+  [mAssistant interactions].assistantDelegate = self;
+  [self rangeAdjustment].adjustmentDelegate = self;
+}
+
+- (void)detach {
+  UITextInteraction* interaction = [mAssistant interactions];
+  if (interaction.assistantDelegate == self) {
+    interaction.assistantDelegate = mAssistant;
+  }
+
+  id<GeckoTextRangeAdjustmentInteraction> adjustment = [self rangeAdjustment];
+  if (adjustment.adjustmentDelegate == self) {
+    adjustment.adjustmentDelegate = mAssistant;
+  }
+}
+
+- (BOOL)respondsToSelector:(SEL)aSelector {
+  if (aSelector == @selector(textRangeAdjustmentInteraction:didBeginAtPoint:)) {
+    return [mAssistant respondsToSelector:aSelector];
+  }
+
+  return [super respondsToSelector:aSelector] ||
+         [mAssistant respondsToSelector:aSelector];
+}
+
+- (id)forwardingTargetForSelector:(SEL)aSelector {
+  return mAssistant;
+}
+
+- (void)textRangeAdjustmentInteraction:(id)aInteraction
+                       didBeginAtPoint:(CGPoint)aPoint {
+  [mAssistant textRangeAdjustmentInteraction:aInteraction
+                             didBeginAtPoint:aPoint];
+
+  id<GeckoTextSelectionInteraction> selection =
+      TextSelectionForAssistant(mAssistant);
+  id<UITextInput> document = selection.document;
+  UITextRange* range = document.selectedTextRange;
+
+  selection.base = [document textRangeFromPosition:range.start
+                                        toPosition:range.start];
+  selection.initialExtent = [document textRangeFromPosition:range.end
+                                                 toPosition:range.end];
+}
+
