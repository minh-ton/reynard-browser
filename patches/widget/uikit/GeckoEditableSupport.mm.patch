+// MARK: - Text Input Lifecycle
+
+static NSString* KeyboardDismissalNotificationName() {
+  auto* name = static_cast<NSString* const*>(
+      dlsym(RTLD_DEFAULT, "UIKeyboardPrivateDidRequestDismissalNotification"));
+  return name ? *name : nil;
+}
+
+@implementation ChildView (Shared)
+
+- (void)setupTextInput {
+  // UIKit uses these methods to send hardware keyboard events.
+  Protocol* textInputProtocol = objc_getProtocol("UITextInputPrivate");
+  MOZ_RELEASE_ASSERT(textInputProtocol);
+  class_addProtocol(ChildView.class, textInputProtocol);
+
+  mEditable = {};
+  mEditable.mSelectionAffinity = UITextStorageDirectionForward;
+  mEditable.mTokenizer =
+      [[ChildViewTextTokenizer alloc] initWithGeckoView:self];
+  mEditable.mUndoManager =
+      [[ChildViewUndoManager alloc] initWithTextInput:self];
+  mEditable.mTextInputDelegates = [[NSHashTable weakObjectsHashTable] retain];
+
+  Class traitsClass = NSClassFromString(@"UITextInputTraits");
+  MOZ_RELEASE_ASSERT(traitsClass);
+  mEditable.mTextInputTraits = [[traitsClass alloc] init];
+
+  mEditable.mEditableTextInteraction = [[UITextInteraction
+      textInteractionForMode:UITextInteractionModeEditable] retain];
+  mEditable.mEditableTextInteraction.textInput = self;
+  mEditable.mEditableTextInteraction.delegate = self;
+
+  mEditable.mReadOnlyTextInteraction = [[UITextInteraction
+      textInteractionForMode:UITextInteractionModeNonEditable] retain];
+  mEditable.mReadOnlyTextInteraction.textInput = self;
+  mEditable.mReadOnlyTextInteraction.delegate = self;
+
+  [self setupTextDragInteractions];
+  [self updateTextInteractions];
+
+  if (NSString* name = KeyboardDismissalNotificationName()) {
+    [NSNotificationCenter.defaultCenter
+        addObserver:self
+           selector:@selector(keyboardDidRequestDismissal:)
+               name:name
+             object:nil];
+  }
+}
+
+- (void)teardownTextInput {
+  if (NSString* name = KeyboardDismissalNotificationName()) {
+    [NSNotificationCenter.defaultCenter removeObserver:self
+                                                  name:name
+                                                object:nil];
+  }
+
+  [self textStyleMenuDidHide:nil];
+  [self cancelAutoscroll];
+  [self teardownTextDragInteractions];
+  [NSObject cancelPreviousPerformRequestsWithTarget:self];
+  [mEditable.mTextInteractionAssistantDelegate detach];
+
+  for (UITextInteraction* interaction : {mEditable.mEditableTextInteraction,
+                                         mEditable.mReadOnlyTextInteraction}) {
+    interaction.delegate = nil;
+    interaction.textInput = nil;
+    if (interaction.view == self) {
+      [self removeInteraction:interaction];
+    }
+    [interaction release];
+  }
+
+  [mEditable.mTextInteractionAssistantDelegate release];
+  [mEditable.mTokenizer release];
+  [(ChildViewUndoManager*)mEditable.mUndoManager detachFromTextInput];
+  [mEditable.mUndoManager release];
+  [mEditable.mTextInputTraits release];
+  [mEditable.mTextInputDelegates release];
+  [mEditable.mMarkedTextStyle release];
+  [self clearTextAnnotations];
+  [mEditable.mSelectionHandleSuppressionAssertion release];
+  mEditable = {};
+}
+
+- (BOOL)isEditable {
+  return mGeckoChild && !mGeckoChild->Destroyed() &&
+         mGeckoChild->GetInputContext().mIMEState.IsEditable();
+}
+
+- (BOOL)isTextSelectable {
+  return mGeckoChild && !mGeckoChild->Destroyed() &&
+         mGeckoChild->GetInputContext().IsTextSelectable();
+}
+
+- (widget::TextInputHandler*)textHandler {
+  return [self isTextSelectable] ? mGeckoChild->GetTextInputHandler() : nullptr;
+}
+
+- (id<UITextInputDelegate>)inputDelegate {
+  return mEditable.mTextInputDelegates.anyObject;
+}
+
+- (void)setInputDelegate:(id<UITextInputDelegate>)aDelegate {
+  [mEditable.mTextInputDelegates removeAllObjects];
+  if (aDelegate) {
+    [mEditable.mTextInputDelegates addObject:aDelegate];
+  }
+}
+
+- (UIView*)textInputView {
+  return self;
+}
+
+// MARK: - Responder Lifecycle
+
+- (UIView*)inputView {
+  if (mGeckoChild && mGeckoChild->IsSoftwareKeyboardSuppressed()) {
+    static UIView* hiddenInputView = [[UIView alloc] initWithFrame:CGRectZero];
+    return hiddenInputView;
+  }
+
+  return nil;
+}
+
+- (void)scheduleResponderBlur {
+  [self cancelResponderBlur];
+  [self performSelector:@selector(applyResponderBlur)
+             withObject:nil
+             afterDelay:0
+                inModes:@[ NSRunLoopCommonModes ]];
+}
+
+- (void)cancelResponderBlur {
+  [NSObject
+      cancelPreviousPerformRequestsWithTarget:self
+                                     selector:@selector(applyResponderBlur)
+                                       object:nil];
+}
+
+- (void)applyResponderBlur {
+  [self resignFirstResponder];
+}
+
+- (void)dismissSoftwareKeyboard {
+  if (RefPtr<widget::TextInputHandler> handler = [self textHandler]) {
+    [self unmarkText];
+
+    NativeTextInputRequest request;
+    request.mQuery = NativeTextInputQuery::BlurFocusedInput;
+    NativeTextInputReply reply;
+    handler->QueryNativeTextInput(request, reply);
+  }
+
+  [self cancelResponderBlur];
+  [self resignFirstResponder];
+}
+
+- (void)keyboardDidRequestDismissal:(NSNotification*)aNotification {
+  RefPtr<dom::BrowserParent> browser = dom::BrowserParent::GetFocused();
+  nsCOMPtr<nsIWidget> widget =
+      browser ? browser->GetTextInputHandlingWidget() : nullptr;
+
+  if ([self isEditable] && widget == mGeckoChild) {
+    mGeckoChild->DismissSoftwareKeyboard();
+  }
+}
