+- (void)insertDictationResult:(NSArray<UIDictationPhrase*>*)aPhrases {
+  NSMutableString* text = [NSMutableString string];
+  for (UIDictationPhrase* phrase in aPhrases) {
+    [text appendString:phrase.text];
+  }
+
+  [self insertDictationText:text replacingRange:self.selectedTextRange];
+}
+
+- (void)insertDictationText:(NSString*)aText
+             replacingRange:(UITextRange*)aRange {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  NSRange range = [self rangeForTextRange:aRange];
+  if (!handler || range.location == NSNotFound) {
+    return;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::InsertDictation;
+  request.mOffset = range.location;
+  request.mLength = range.length;
+  CopyNSStringToXPCOMString(aText ?: @"", request.mText);
+  NativeTextInputReply reply;
+  if (handler->QueryNativeTextInput(request, reply) &&
+      handler->SynchronizeTextInputState()) {
+    [[self interactionAssistant] selectionChanged];
+    [self refreshSelectionUI];
+  }
+}
+
+- (void)replaceDictatedText:(NSString*)aOldText withText:(NSString*)aNewText {
+  NSRange selection = [self selectedRange];
+  if (selection.location == NSNotFound || selection.length) {
+    return;
+  }
+
+  if (aOldText.length > selection.location) {
+    return;
+  }
+
+  NSRange range =
+      NSMakeRange(selection.location - aOldText.length, aOldText.length);
+  UITextRange* textRange = [self textRangeForRange:range];
+  if (![[self textInRange:textRange] isEqualToString:aOldText]) {
+    return;
+  }
+
+  [self insertDictationText:aNewText replacingRange:textRange];
+}
