+// MARK: - Text Interactions
+
+- (UIEditingInteractionConfiguration)editingInteractionConfiguration {
+  return [self isEditable] ? UIEditingInteractionConfigurationDefault
+                           : UIEditingInteractionConfigurationNone;
+}
+
+- (void)updateTextInteractions {
+  if (!mEditable.mTextDragSession) {
+    mEditable.mTextDragInteraction.enabled = [self isEditable];
+  }
+
+  UITextInteraction* interaction = [self isEditable]
+                                       ? mEditable.mEditableTextInteraction
+                                       : mEditable.mReadOnlyTextInteraction;
+  if (!interaction) {
+    return;
+  }
+
+  BOOL selectable = [self isTextSelectable];
+  for (UITextInteraction* attached : {mEditable.mEditableTextInteraction,
+                                      mEditable.mReadOnlyTextInteraction}) {
+    if (attached.view != self) {
+      continue;
+    }
+
+    if (attached == interaction && selectable) {
+      continue;
+    }
+
+    [self cancelAutoscroll];
+    [[self selectionCommandController] hideSelectionCommands];
+    [[self interactionAssistant] deactivateSelection];
+    mEditable.mSelectionActivated = NO;
+    [mEditable.mTextInteractionAssistantDelegate detach];
+    [self removeInteraction:attached];
+    [mEditable.mTextInteractionAssistantDelegate release];
+    mEditable.mTextInteractionAssistantDelegate = nil;
+  }
+
+  if (!selectable) {
+    return;
+  }
+
+  if (interaction.view != self) {
+    [self addInteraction:interaction];
+    mEditable.mTextInteractionAssistantDelegate =
+        [[GeckoTextInteractionAssistantDelegate alloc]
+            initWithAssistant:[self interactionAssistant]];
+  }
+
+  for (UIGestureRecognizer* gesture in interaction
+           .gesturesForFailureRequirements) {
+    gesture.allowedTouchTypes = @[ @(UITouchTypeDirect), @(UITouchTypePencil) ];
+  }
+
+  [self updateSelectionActivation];
+}
+
+- (void)updateSelectionActivation {
+  id<GeckoTextInteractionAssistant> assistant = [self interactionAssistant];
+  BOOL dragging = mEditable.mTextDragSession || mEditable.mTextDropSession;
+  BOOL shouldActivate = !dragging && [self isTextSelectable];
+  if (shouldActivate) {
+    shouldActivate = [self isFirstResponder] && self.selectedTextRange;
+  }
+
+  const NativeTextInputReply* state = nullptr;
+  if (shouldActivate) {
+    RefPtr<widget::TextInputHandler> handler = [self textHandler];
+    state = handler ? handler->NativeTextInputState() : nullptr;
+    shouldActivate = state && !state->mSuppressSelectionDisplay;
+  }
+
+  if (mGeckoChild) {
+    if (shouldActivate) {
+      mGeckoChild->SetNativeTextInputScrollers(state->mSelectionScrollers);
+    } else {
+      mGeckoChild->SetNativeTextInputScrollers({});
+    }
+  }
+
+  if (@available(iOS 17.0, *)) {
+    UITextSelectionDisplayInteraction* display =
+        [self _selectionDisplayInteraction];
+    // Don't activate again during a handle drag using pointer. UIKit would
+    // reset the selection.
+    if (display.activated == shouldActivate) {
+      return;
+    }
+  } else if (shouldActivate && mEditable.mSelectionActivated) {
+    return;
+  }
+
+  if (shouldActivate) {
+    [assistant activateSelection];
+  } else {
+    // Older UIKit can show its selection view without updating our cache.
+    [assistant deactivateSelection];
+  }
+  mEditable.mSelectionActivated = shouldActivate;
+
+  if (shouldActivate) {
+    // The first tap reaches Gecko before editable gestures are attached.
+    // Reload that selection when UIKit takes over.
+    [assistant selectionChanged];
+  }
+}
+
+- (void)refreshSelectionUI {
+  if (![self isTextSelectable]) {
+    return;
+  }
+
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  NSRange marked;
+  if (handler && handler->MarkedRange(marked)) {
+    // Reload UIKit's stored selection after updating marked text.
+    [TextSelectionForAssistant([self interactionAssistant]) selectionChanged];
+  }
+
+  static_cast<id<GeckoUITextInputTraitsPrivate>>(mEditable.mTextInputTraits)
+      .insertionPointColor = self.insertionPointColor;
+
+  if (@available(iOS 17.0, *)) {
+    [(UITextSelectionDisplayInteraction*)[self _selectionDisplayInteraction]
+        setNeedsSelectionUpdate];
+  } else {
+    [(id<GeckoTextSelectionView>)[[self interactionAssistant] textSelectionView]
+        updateSelectionRects];
+  }
+
+  [self updateSelectionActivation];
+  [self updateEditMenu];
+
+  if (@available(iOS 16.0, *)) {
+    id<GeckoTextInteractionAssistant> assistant = [self interactionAssistant];
+    if (![assistant respondsToSelector:@selector(_editMenuAssistant)]) {
+      return;
+    }
+
+    id<GeckoTextEditMenuAssistant> menuAssistant =
+        [assistant _editMenuAssistant];
+    if (![menuAssistant _editMenuIsVisible]) {
+      return;
+    }
+
+    // Update selection views before asking UIKit to position its menu.
+    if (@available(iOS 17.0, *)) {
+      [(UITextSelectionDisplayInteraction*)[self _selectionDisplayInteraction]
+          layoutManagedSubviews];
+    }
+
+    // UIKit can wrap its edit menu in UITextContextMenuInteraction.
+    id menu = [menuAssistant menuInteraction];
+    if ([menu respondsToSelector:@selector(editMenuInteraction)]) {
+      menu = [(id<GeckoTextContextMenuInteraction>)menu editMenuInteraction];
+    }
+
+    if ([menu isKindOfClass:UIEditMenuInteraction.class]) {
+      [(UIEditMenuInteraction*)menu updateVisibleMenuPositionAnimated:NO];
+    }
+  }
+}
+
+- (void)asyncScrollStateChanged:(BOOL)aScrolling {
+  if (mEditable.mAsyncScrollInProgress == aScrolling) {
+    return;
+  }
+
+  mEditable.mAsyncScrollInProgress = aScrolling;
+  if (aScrolling) {
+    if ([self isTextSelectable] && [self isFirstResponder] &&
+        ![self isInteractingWithText]) {
+      [[self selectionCommandController] hideSelectionCommands];
+    }
+
+    return;
+  }
+
+  if (RefPtr<widget::TextInputHandler> handler = [self textHandler]) {
+    handler->InvalidateTextInputGeometry();
+  }
+
+  [self refreshSelectionUI];
+}
+
+- (void)selectionGeometryChanged {
+  if (![self isTextSelectable]) {
+    return;
+  }
+
+  if (mEditable.mPendingSelectionGeometryRefresh) {
+    return;
+  }
+
+  mEditable.mPendingSelectionGeometryRefresh = YES;
+  [self performSelector:@selector(applySelectionGeometryChange)
+             withObject:nil
+             afterDelay:0
+                inModes:@[ NSRunLoopCommonModes ]];
+}
+
+- (void)applySelectionGeometryChange {
+  mEditable.mPendingSelectionGeometryRefresh = NO;
+
+  if (![self isTextSelectable] || ![self isFirstResponder]) {
+    return;
+  }
+
+  if (RefPtr<widget::TextInputHandler> handler = [self textHandler]) {
+    handler->NativeTextInputState();
+  }
+
+  [self refreshSelectionUI];
+}
+
+- (void)refreshCompositorSelection {
+  if (![self isTextSelectable] || ![self isFirstResponder]) {
+    return;
+  }
+
+  if (@available(iOS 17.0, *)) {
+    UITextSelectionDisplayInteraction* display =
+        [self _selectionDisplayInteraction];
+    [display layoutManagedSubviews];
+  } else {
+    [(id<GeckoTextSelectionView>)[[self interactionAssistant] textSelectionView]
+        updateSelectionRects];
+  }
+}
+
+- (void)setSelectionHandlesVisible:(BOOL)aVisible {
+  if (aVisible) {
+    [mEditable.mSelectionHandleSuppressionAssertion release];
+    mEditable.mSelectionHandleSuppressionAssertion = nil;
+    return;
+  }
+
+  if (mEditable.mSelectionHandleSuppressionAssertion) {
+    return;
+  }
+
+  id display = nil;
+  SEL selector;
+  if (@available(iOS 17.0, *)) {
+    display = [self _selectionDisplayInteraction];
+    selector = NSSelectorFromString(@"_obtainGrabberSuppressionAssertion");
+  } else {
+    display = [[self interactionAssistant] textSelectionView];
+    selector = NSSelectorFromString(@"obtainGrabberSuppressionAssertion");
+  }
+
+  if ([display respondsToSelector:selector]) {
+    mEditable.mSelectionHandleSuppressionAssertion =
+        [[display performSelector:selector] retain];
+  }
+}
+
+- (BOOL)interactionShouldBegin:(UITextInteraction*)aInteraction
+                       atPoint:(CGPoint)aPoint {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler) {
+    return NO;
+  }
+
+  if (!std::isfinite(aPoint.x) || !std::isfinite(aPoint.y)) {
+    return NO;
+  }
+
+  handler->InvalidateTextInputState();
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::HitTest;
+  request.mPoint = UIKitPointsToDevPixels(aPoint, self.contentScaleFactor);
+  NativeTextInputReply reply;
+  if (!handler->QueryNativeTextInput(request, reply) ||
+      !reply.mHitSelectableContent) {
+    return NO;
+  }
+
+  [self setSelectionHandlesVisible:YES];
+  [mEditable.mTextInteractionAssistantDelegate attachToInteractions];
+  return YES;
+}
+
+- (void)interactionWillBegin:(UITextInteraction*)aInteraction {
+  if ([self isEditable] && mGeckoChild->IsSoftwareKeyboardSuppressed() &&
+      !mGeckoChild->IsVirtualKeyboardDisabled()) {
+    // Native gestures may not send a click to Gecko. Reopen the keyboard for
+    // an already-focused field.
+    InputContext context = mGeckoChild->GetInputContext();
+    InputContextAction action(InputContextAction::CAUSE_TOUCH,
+                              InputContextAction::FOCUS_NOT_CHANGED);
+    mGeckoChild->SetInputContext(context, action);
+    return;
+  }
+
+  [self becomeFirstResponder];
+}
+
+- (void)interactionDidEnd:(UITextInteraction*)aInteraction {
+  [self cancelAutoscroll];
+  [self refreshSelectionUI];
+}
+
+- (void)beginFloatingCursorAtPoint:(CGPoint)aPoint {
+  if (![self isEditable]) {
+    return;
+  }
+
+  [self setSelectionHandlesVisible:YES];
+  mEditable.mFloatingCursorActive = YES;
+  mEditable.mFloatingCursorPoint = aPoint;
+  [[self interactionAssistant] beginFloatingCursorAtPoint:aPoint];
+}
+
+- (void)updateFloatingCursorAtPoint:(CGPoint)aPoint {
+  mEditable.mFloatingCursorPoint = aPoint;
+  [[self interactionAssistant] updateFloatingCursorAtPoint:aPoint];
+  [self startAutoscroll:aPoint];
+}
+
+- (void)endFloatingCursor {
+  mEditable.mFloatingCursorActive = NO;
+  [self cancelAutoscroll];
+  [[self interactionAssistant] endFloatingCursor];
+  [self refreshSelectionUI];
+}
+
+// MARK: - Text Autoscrolling
+
+- (BOOL)isInteractingWithText {
+  if (mEditable.mFloatingCursorActive ||
+      mEditable.mEditableTextInteraction.inGesture ||
+      mEditable.mReadOnlyTextInteraction.inGesture) {
+    return YES;
+  }
+
+  id<GeckoTextInteractionAssistant> assistant = [self interactionAssistant];
+  return [assistant currentDraggedHandle] != 0;
+}
+
+- (void)startAutoscroll:(CGPoint)aPoint {
+  if (![self isTextSelectable] || !self.isFirstResponder) {
+    [self cancelAutoscroll];
+    return;
+  }
+
+  id<GeckoTextInteractionAssistant> assistant = [self interactionAssistant];
+  id<GeckoTextRangeAdjustmentInteraction> adjustment = nil;
+
+  // Older UIKit doesn't have these helpers but they still gives the adjusted
+  // point.
+  if ([assistant respondsToSelector:@selector(rangeAdjustmentInteraction)] &&
+      [assistant
+          respondsToSelector:
+              @selector(_rangeAdjustmentPointInTextInputCoordinateSpace:)]) {
+    adjustment = [assistant rangeAdjustmentInteraction];
+  }
+
+  if (mEditable.mFloatingCursorActive) {
+    aPoint = mEditable.mFloatingCursorPoint;
+  } else if ([adjustment respondsToSelector:@selector(hasActiveTouch)] &&
+             adjustment.hasActiveTouch) {
+    // Don't let other hit tests change the dragged handle's position.
+    aPoint = [assistant
+        _rangeAdjustmentPointInTextInputCoordinateSpace:adjustment.extentPoint];
+  }
+
+  if (!std::isfinite(aPoint.x) || !std::isfinite(aPoint.y)) {
+    [self cancelAutoscroll];
+    return;
+  }
+
+  CGRect clip = [self _selectionClipRect];
+  if (CGRectIsEmpty(clip)) {
+    [self cancelAutoscroll];
+    return;
+  }
+
+  if (mEditable.mFloatingCursorActive) {
+    // Start near the edge, as WebKit does, even if UIKit bounds the cursor
+    // inside the field. Keep the original point for updating the selection.
+    const CGFloat horizontalMargin = std::min(CGFloat(20), clip.size.width / 4);
+    const CGFloat verticalMargin = std::min(CGFloat(20), clip.size.height / 4);
+    const CGRect interior = CGRectInset(clip, horizontalMargin, verticalMargin);
+    if (aPoint.x < CGRectGetMinX(interior)) {
+      aPoint.x = std::min(aPoint.x, CGRectGetMinX(clip) - horizontalMargin);
+    } else if (aPoint.x > CGRectGetMaxX(interior)) {
+      aPoint.x = std::max(aPoint.x, CGRectGetMaxX(clip) + horizontalMargin);
+    }
+
+    if (aPoint.y < CGRectGetMinY(interior)) {
+      aPoint.y = std::min(aPoint.y, CGRectGetMinY(clip) - verticalMargin);
+    } else if (aPoint.y > CGRectGetMaxY(interior)) {
+      aPoint.y = std::max(aPoint.y, CGRectGetMaxY(clip) + verticalMargin);
+    }
+  }
+
+  if (CGRectContainsPoint(clip, aPoint)) {
+    [self cancelAutoscroll];
+    return;
+  }
+
+  mEditable.mTextAutoscrollPoint = aPoint;
+  if (!mEditable.mTextAutoscrollTimer) {
+    mEditable.mTextAutoscrollTimer =
+        [[NSTimer timerWithTimeInterval:0.03
+                                 target:self
+                               selector:@selector(updateTextAutoscroll:)
+                               userInfo:nil
+                                repeats:YES] retain];
+    [NSRunLoop.mainRunLoop addTimer:mEditable.mTextAutoscrollTimer
+                            forMode:NSRunLoopCommonModes];
+  }
+}
+
+- (void)cancelAutoscroll {
+  [mEditable.mTextAutoscrollTimer invalidate];
+  [mEditable.mTextAutoscrollTimer release];
+  mEditable.mTextAutoscrollTimer = nil;
+}
+
+- (void)updateTextAutoscroll:(NSTimer*)aTimer {
+  if (!self.isFirstResponder || ![self isInteractingWithText]) {
+    [self cancelAutoscroll];
+    return;
+  }
+
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::ScrollAtPoint;
+  request.mPoint = UIKitPointsToDevPixels(mEditable.mTextAutoscrollPoint,
+                                          self.contentScaleFactor);
+  NativeTextInputReply reply;
+  if (!handler || !handler->QueryNativeTextInput(request, reply) ||
+      !reply.mScrolled) {
+    [self cancelAutoscroll];
+    return;
+  }
+
+  handler->InvalidateTextInputGeometry();
+  id<GeckoTextInteractionAssistant> assistant = [self interactionAssistant];
+  if (mEditable.mFloatingCursorActive) {
+    [assistant updateFloatingCursorAtPoint:mEditable.mFloatingCursorPoint];
+  } else {
+    id<GeckoTextSelectionInteraction> selection =
+        TextSelectionForAssistant(assistant);
+    if (selection.selectedRange.empty) {
+      [selection setSelectionWithPoint:mEditable.mTextAutoscrollPoint];
+      [selection commit];
+    } else {
+      [assistant updateSelectionWithPoint:mEditable.mTextAutoscrollPoint];
+    }
+  }
+
+  [self refreshSelectionUI];
+}
+
+- (void)scrollSelectionToVisible:(BOOL)aAnimated {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler || [self isInteractingWithText]) {
+    return;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::ScrollSelectionIntoView;
+  request.mAnimated = aAnimated;
+  NativeTextInputReply reply;
+  if (handler->QueryNativeTextInput(request, reply)) {
+    handler->InvalidateTextInputGeometry();
+    [self selectionGeometryChanged];
+  }
+}
+
+// MARK: - Text Positions and Ranges
+
+- (NSUInteger)documentLength {
+  uint32_t length = 0;
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  return handler && handler->TextLength(length) ? length : 0;
+}
+
+- (ChildViewTextPosition*)textPosForPosition:(UITextPosition*)aPosition {
+  if (![aPosition isKindOfClass:ChildViewTextPosition.class]) {
+    return nil;
+  }
+
+  ChildViewTextPosition* position =
+      static_cast<ChildViewTextPosition*>(aPosition);
+  return position.offset <= [self documentLength] ? position : nil;
+}
+
+- (NSRange)rangeForTextRange:(UITextRange*)aRange {
+  ChildViewTextPosition* start = [self textPosForPosition:aRange.start];
+  ChildViewTextPosition* end = [self textPosForPosition:aRange.end];
+  if (!start || !end) {
+    return NSMakeRange(NSNotFound, 0);
+  }
+
+  if (end.offset < start.offset) {
+    return NSMakeRange(NSNotFound, 0);
+  }
+
+  return NSMakeRange(start.offset, end.offset - start.offset);
+}
+
+- (ChildViewTextRange*)textRangeForRange:(NSRange)aRange {
+  NSUInteger length = [self documentLength];
+  if (aRange.location == NSNotFound || aRange.location > length) {
+    return nil;
+  }
+
+  if (aRange.length > length - aRange.location) {
+    return nil;
+  }
+
+  ChildViewTextPosition* start =
+      [ChildViewTextPosition positionWithOffset:aRange.location];
+  ChildViewTextPosition* end = [ChildViewTextPosition
+      positionWithOffset:NSMaxRange(aRange)
+                affinity:aRange.length ? UITextStorageDirectionBackward
+                                       : UITextStorageDirectionForward];
+  return [ChildViewTextRange rangeWithStart:start end:end];
+}
+
+- (UITextPosition*)beginningOfDocument {
+  return [ChildViewTextPosition positionWithOffset:0];
+}
+
+- (UITextPosition*)endOfDocument {
+  return
+      [ChildViewTextPosition positionWithOffset:[self documentLength]
+                                       affinity:UITextStorageDirectionBackward];
+}
+
+- (UITextRange*)textRangeFromPosition:(UITextPosition*)aFrom
+                           toPosition:(UITextPosition*)aTo {
+  ChildViewTextPosition* start = [self textPosForPosition:aFrom];
+  ChildViewTextPosition* end = [self textPosForPosition:aTo];
+  if (!start || !end) {
+    return nil;
+  }
+
+  return start.offset <= end.offset
+             ? [ChildViewTextRange rangeWithStart:start end:end]
+             : [ChildViewTextRange rangeWithStart:end end:start];
+}
+
+- (UITextPosition*)positionFromPosition:(UITextPosition*)aPosition
+                                 offset:(NSInteger)aOffset {
+  ChildViewTextPosition* position = [self textPosForPosition:aPosition];
+  if (!position) {
+    return nil;
+  }
+
+  if (!aOffset) {
+    return position;
+  }
+
+  NSUInteger length = [self documentLength];
+  if (aOffset < 0) {
+    NSUInteger distance = NSUInteger(-(aOffset + 1)) + 1;
+    if (distance > position.offset) {
+      return nil;
+    }
+  } else if (NSUInteger(aOffset) > length - position.offset) {
+    return nil;
+  }
+
+  return [ChildViewTextPosition
+      positionWithOffset:position.offset + aOffset
+                affinity:aOffset < 0 ? UITextStorageDirectionBackward
+                                     : UITextStorageDirectionForward];
+}
+
+- (UITextPosition*)positionFromPosition:(UITextPosition*)aPosition
+                            inDirection:(UITextLayoutDirection)aDirection
+                                 offset:(NSInteger)aOffset {
+  ChildViewTextPosition* position = [self textPosForPosition:aPosition];
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!position || !handler) {
+    return nil;
+  }
+
+  if (aOffset == NSIntegerMin) {
+    return nil;
+  }
+
+  if (!aOffset) {
+    return position;
+  }
+
+  if (aOffset < 0) {
+    switch (aDirection) {
+      case UITextLayoutDirectionLeft:
+        aDirection = UITextLayoutDirectionRight;
+        break;
+      case UITextLayoutDirectionRight:
+        aDirection = UITextLayoutDirectionLeft;
+        break;
+      case UITextLayoutDirectionUp:
+        aDirection = UITextLayoutDirectionDown;
+        break;
+      default:
+        aDirection = UITextLayoutDirectionUp;
+        break;
+    }
+    aOffset = -aOffset;
+  }
+
+  if (NSUInteger(aOffset) > [self documentLength]) {
+    return nil;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::Move;
+  request.mDirection = NativeDirection(aDirection);
+  request.mOffset = position.offset;
+  request.mCount = aOffset;
+  request.mAssociateWithNext =
+      position.affinity == UITextStorageDirectionForward;
+  NativeTextInputReply reply;
+  if (!handler->QueryNativeTextInput(request, reply)) {
+    return nil;
+  }
+
+  if (reply.mOffset == UINT32_MAX) {
+    return nil;
+  }
+
+  return [ChildViewTextPosition
+      positionWithOffset:reply.mOffset
+                affinity:reply.mAssociateWithNext
+                             ? UITextStorageDirectionForward
+                             : UITextStorageDirectionBackward];
+}
+
+- (UITextRange*)characterRangeByExtendingPosition:(UITextPosition*)aPosition
+                                      inDirection:
+                                          (UITextLayoutDirection)aDirection {
+  UITextPosition* other = [self positionFromPosition:aPosition
+                                         inDirection:aDirection
+                                              offset:1];
+  return other ? [self textRangeFromPosition:aPosition toPosition:other] : nil;
+}
+
+- (NSComparisonResult)comparePosition:(UITextPosition*)aPosition
+                           toPosition:(UITextPosition*)aOther {
+  ChildViewTextPosition* position = [self textPosForPosition:aPosition];
+  ChildViewTextPosition* other = [self textPosForPosition:aOther];
+  if (position.offset < other.offset) {
+    return NSOrderedAscending;
+  }
+
+  if (position.offset > other.offset) {
+    return NSOrderedDescending;
+  }
+
+  return NSOrderedSame;
+}
+
+- (NSInteger)offsetFromPosition:(UITextPosition*)aFrom
+                     toPosition:(UITextPosition*)aTo {
+  ChildViewTextPosition* from = [self textPosForPosition:aFrom];
+  ChildViewTextPosition* to = [self textPosForPosition:aTo];
+  return from && to ? NSInteger(to.offset) - NSInteger(from.offset) : 0;
+}
+
+- (UITextPosition*)positionWithinRange:(UITextRange*)aRange
+                     atCharacterOffset:(NSInteger)aOffset {
+  NSRange range = [self rangeForTextRange:aRange];
+  if (range.location == NSNotFound || aOffset < 0 ||
+      NSUInteger(aOffset) > range.length) {
+    return nil;
+  }
+
+  if (!aOffset) {
+    return aRange.start;
+  }
+
+  if (NSUInteger(aOffset) == range.length) {
+    return aRange.end;
+  }
+
+  return [ChildViewTextPosition positionWithOffset:range.location + aOffset];
+}
+
+- (NSInteger)characterOffsetOfPosition:(UITextPosition*)aPosition
+                           withinRange:(UITextRange*)aRange {
+  NSRange range = [self rangeForTextRange:aRange];
+  ChildViewTextPosition* position = [self textPosForPosition:aPosition];
+  if (!position || range.location == NSNotFound) {
+    return NSNotFound;
+  }
+
+  if (position.offset < range.location || position.offset > NSMaxRange(range)) {
+    return NSNotFound;
+  }
+
+  return position.offset - range.location;
+}
