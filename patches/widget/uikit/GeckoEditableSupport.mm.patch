+  if (range.location == NSNotFound) {
+    range = [self selectedRange];
+  }
+
+  [self insertText:aText.string];
+  [self setTextAnnotations:aText
+                   inRange:NSMakeRange(range.location, aText.length)];
+}
+
+- (void)replaceRange:(UITextRange*)aRange
+    withAttributedText:(NSAttributedString*)aText {
+  NSRange range = [self rangeForTextRange:aRange];
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler || !handler->ReplaceRange(range, aText.string)) {
+    return;
+  }
+
+  [self setTextAnnotations:aText
+                   inRange:NSMakeRange(range.location, aText.length)];
+  [self scrollSelectionToVisible:NO];
+  [self refreshSelectionUI];
+}
+
+- (void)replaceRange:(UITextRange*)aRange
+         withAnnotatedString:(NSAttributedString*)aText
+    relativeReplacementRange:(NSRange)aReplacementRange {
+  NSRange range = [self rangeForTextRange:aRange];
+  NSString* oldText = [self textInRange:aRange];
+  if (!oldText || range.location == NSNotFound) {
+    return;
+  }
+
+  // NSNotFound means only the keyboard's extra info changed, not the text.
+  if (aReplacementRange.location != NSNotFound) {
+    if (aReplacementRange.location > oldText.length) {
+      return;
+    }
+
+    if (aReplacementRange.length >
+        oldText.length - aReplacementRange.location) {
+      return;
+    }
+
+    NSUInteger unchangedLength = oldText.length - aReplacementRange.length;
+    if (aText.length < unchangedLength) {
+      return;
+    }
+
+    NSUInteger replacementLength = aText.length - unchangedLength;
+    NSRange replacementRange =
+        NSMakeRange(aReplacementRange.location, replacementLength);
+    NSString* replacement = [aText.string substringWithRange:replacementRange];
+    NSMutableString* expectedText = [[oldText mutableCopy] autorelease];
+    [expectedText replaceCharactersInRange:aReplacementRange
+                                withString:replacement];
+    if (![expectedText isEqualToString:aText.string]) {
+      return;
+    }
+
+    RefPtr<widget::TextInputHandler> handler = [self textHandler];
+    NSRange target = NSMakeRange(range.location + aReplacementRange.location,
+                                 aReplacementRange.length);
+    if (!handler || !handler->ReplaceRange(target, replacement)) {
+      return;
+    }
+  }
+
+  [self setTextAnnotations:aText
+                   inRange:NSMakeRange(range.location, aText.length)];
+  if (aReplacementRange.location != NSNotFound) {
+    [self scrollSelectionToVisible:NO];
+  }
+  [self refreshSelectionUI];
+}
+
+- (void)removeAnnotation:(NSAttributedStringKey)aAnnotation
+                forRange:(UITextRange*)aRange {
+  NSRange range = [self rangeForTextRange:aRange];
+  NSMutableAttributedString* annotations = [self textAnnotations];
+  if (!annotations || range.location == NSNotFound ||
+      range.location > annotations.length) {
+    return;
+  }
+
+  if (range.length > annotations.length - range.location) {
+    return;
+  }
+
+  [annotations removeAttribute:aAnnotation range:range];
+}
