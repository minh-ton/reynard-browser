+// MARK: - Selection Scrolling
+
+bool TextInputHandler::SelectionUsesScroller(
+    const layers::ScrollableLayerGuid& aGuid) const {
+  return mNativeTextInputState &&
+         mNativeTextInputState->mSelectionScrollers.Contains(aGuid);
+}
+
+void TextInputHandler::UpdateSelectionScrollState(bool aSelectionMoved) {
+  RefPtr<TextInputHandler> self(this);
+  if (Destroyed()) {
+    return;
+  }
+
+  ChildView* view =
+      static_cast<ChildView*>(mWidget->GetNativeData(NS_NATIVE_WIDGET));
+  const bool scrolling =
+      mNativeTextInputState &&
+      mWidget->IsAsyncScrolling(mNativeTextInputState->mSelectionScrollers);
+  AutoRestore<bool> updating(mUpdatingSelectionFromCompositor);
+  mUpdatingSelectionFromCompositor |= aSelectionMoved;
+  [view asyncScrollStateChanged:scrolling];
+
+  if (!aSelectionMoved) {
+    if (mNativeTextInputState && view->mEditable.mSelectionActivated) {
+      if ([view isFirstResponder] &&
+          !mNativeTextInputState->mSuppressSelectionDisplay) {
+        mWidget->SetNativeTextInputScrollers(
+            mNativeTextInputState->mSelectionScrollers);
+      } else {
+        mWidget->SetNativeTextInputScrollers({});
+      }
+    }
+    return;
+  }
+
+  if (mNativeTextInputState && !mNativeTextInputStateDirty) {
+    [view refreshCompositorSelection];
+  }
+}
+
+gfx::Matrix TextInputHandler::SelectionScrollTransform(
+    const nsTArray<NativeTextInputScrollReference>& aReferences) const {
+  LayoutDevicePoint translation;
+  LayoutDevicePoint origin;
+  float zoom = 1.0f;
+  for (const auto& reference : aReferences) {
+    const auto* update =
+        mWidget->GetNativeTextInputScrollUpdate(reference.mGuid);
+    if (!update) {
+      continue;
+    }
+
+    // Don't move newer geometry back to an older scroll position.
+    if (update->mGeneration < reference.mGeneration) {
+      continue;
+    }
+
+    const CSSPoint offset = reference.mFixed
+                                ? update->mVisualOffset - update->mLayoutOffset
+                                : update->mVisualOffset;
+    const CSSPoint delta = offset - reference.mOffset;
+    translation -=
+        reference.mXAxis * float(delta.x) + reference.mYAxis * float(delta.y);
+
+    if (reference.mZoom > 0.0f) {
+      zoom = update->mZoom / reference.mZoom;
+      origin = reference.mOrigin;
+    }
+  }
+
+  const LayoutDevicePoint offset = origin * (1.0f - zoom) + translation * zoom;
+  return gfx::Matrix(zoom, 0, 0, zoom, offset.x, offset.y);
+}
+
+LayoutDeviceRect TextInputHandler::TransformSelectionRect(
+    const LayoutDeviceIntRect& aRect,
+    const nsTArray<NativeTextInputScrollReference>& aReferences) const {
+  const gfx::Matrix transform = SelectionScrollTransform(aReferences);
+  return LayoutDeviceRect(aRect.x * transform._11 + transform._31,
+                          aRect.y * transform._22 + transform._32,
+                          aRect.width * transform._11,
+                          aRect.height * transform._22);
+}
+
+bool TextInputHandler::EditorRect(LayoutDeviceRect& aRect) {
+  RefPtr<TextInputHandler> self(this);
+  const NativeTextInputReply* state = NativeTextInputState();
+  if (!state) {
+    return false;
+  }
+
+  aRect = TransformSelectionRect(state->mRect, state->mScrollReferences);
+  for (const auto& clip : state->mClipRects) {
+    aRect = aRect.Intersect(
+        TransformSelectionRect(clip.mRect, clip.mScrollReferences));
+  }
+
+  return true;
+}
