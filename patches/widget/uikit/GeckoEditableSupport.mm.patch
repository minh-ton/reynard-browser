+// MARK: - UIKit Text Helpers
+
+namespace {
+
+NativeTextInputDirection NativeDirection(UITextDirection aDirection) {
+  switch (aDirection) {
+    case UITextStorageDirectionBackward:
+      return NativeTextInputDirection::Backward;
+    case UITextLayoutDirectionLeft:
+      return NativeTextInputDirection::Left;
+    case UITextLayoutDirectionRight:
+      return NativeTextInputDirection::Right;
+    case UITextLayoutDirectionUp:
+      return NativeTextInputDirection::Up;
+    case UITextLayoutDirectionDown:
+      return NativeTextInputDirection::Down;
+    default:
+      return NativeTextInputDirection::Forward;
+  }
+}
+
+bool IsBackwardDirection(UITextDirection aDirection) {
+  return aDirection == UITextStorageDirectionBackward ||
+         aDirection == UITextLayoutDirectionLeft ||
+         aDirection == UITextLayoutDirectionUp;
+}
+
+TextRangeStyle CompositionStyle(NSDictionary* aAttributes,
+                                UITraitCollection* aTraits) {
+  TextRangeStyle style;
+  auto color = [&](NSString* aKey, uint8_t aFlag, nscolor& aResult) {
+    UIColor* value = aAttributes[aKey];
+    if (!value) {
+      return;
+    }
+
+    CGFloat red, green, blue, alpha;
+    if ([[value resolvedColorWithTraitCollection:aTraits] getRed:&red
+                                                           green:&green
+                                                            blue:&blue
+                                                           alpha:&alpha]) {
+      auto component = [](CGFloat aValue) {
+        return uint8_t(std::clamp(aValue, CGFloat(0), CGFloat(1)) * 255);
+      };
+      aResult = NS_RGBA(component(red), component(green), component(blue),
+                        component(alpha));
+      style.mDefinedStyles |= aFlag;
+    }
+  };
+  color(NSForegroundColorAttributeName,
+        TextRangeStyle::DEFINED_FOREGROUND_COLOR, style.mForegroundColor);
+  color(NSBackgroundColorAttributeName,
+        TextRangeStyle::DEFINED_BACKGROUND_COLOR, style.mBackgroundColor);
+  color(NSUnderlineColorAttributeName, TextRangeStyle::DEFINED_UNDERLINE_COLOR,
+        style.mUnderlineColor);
+
+  NSNumber* underline = aAttributes[NSUnderlineStyleAttributeName];
+  if (underline) {
+    NSInteger value = underline.integerValue;
+    NSInteger weight = value & 0xFF;
+    style.mDefinedStyles |= TextRangeStyle::DEFINED_LINESTYLE;
+    style.mIsBoldLine = weight == NSUnderlineStyleThick;
+    if (weight == NSUnderlineStyleNone) {
+      style.mLineStyle = TextRangeStyle::LineStyle::None;
+    } else if (weight == NSUnderlineStyleDouble) {
+      style.mLineStyle = TextRangeStyle::LineStyle::Double;
+    } else if ((value & 0xF00) == NSUnderlinePatternDot) {
+      style.mLineStyle = TextRangeStyle::LineStyle::Dotted;
+    } else if ((value & 0xF00) != NSUnderlinePatternSolid) {
+      style.mLineStyle = TextRangeStyle::LineStyle::Dashed;
+    } else {
+      style.mLineStyle = TextRangeStyle::LineStyle::Solid;
+    }
+  } else if (style.IsForegroundColorDefined() ||
+             style.IsBackgroundColorDefined()) {
+    // Setting colors here prevents Gecko from adding its own underline.
+    style.mDefinedStyles |= TextRangeStyle::DEFINED_LINESTYLE;
+    style.mLineStyle = TextRangeStyle::LineStyle::None;
+  }
+  return style;
+}
+
+already_AddRefed<TextRangeArray> CompositionStyles(NSAttributedString* aText,
+                                                   NSDictionary* aDefaults,
+                                                   UITraitCollection* aTraits) {
+  RefPtr<TextRangeArray> styles = new TextRangeArray();
+  NSUInteger offset = 0;
+  while (offset < aText.length) {
+    NSRange range;
+    NSDictionary* attributes = [aText attributesAtIndex:offset
+                                         effectiveRange:&range];
+    NSMutableDictionary* combined =
+        [NSMutableDictionary dictionaryWithDictionary:aDefaults ?: @{}];
+    [combined addEntriesFromDictionary:attributes];
+    TextRange style;
+    style.mStartOffset = range.location;
+    style.mEndOffset = NSMaxRange(range);
+    style.mRangeStyle = CompositionStyle(combined, aTraits);
+    styles->AppendElement(style);
+    offset = NSMaxRange(range);
+  }
+  return styles.forget();
+}
+
+CGRect UIKitSelectionGeometry(widget::TextInputHandler& aHandler,
+                              const NativeTextInputRect& aRect, CGFloat aScale,
+                              CGAffineTransform& aTransform,
+                              bool aCaret = false) {
+  gfx::Matrix transform = aRect.mTransform;
+  transform *= aHandler.SelectionScrollTransform(aRect.mScrollReferences);
+  LayoutDeviceRect rect = aRect.mUntransformedRect;
+  const gfx::Point center =
+      transform.TransformPoint(rect.Center().ToUnknownPoint());
+  if (aCaret && aRect.mVertical) {
+    // UIKit draws an upright caret, even in vertical text.
+    std::swap(rect.width, rect.height);
+    gfx::Matrix rotation(0, -1, 1, 0, 0, 0);
+    transform = rotation * transform;
+  }
+
+  // UIKit clips the rect before applying its transform. Keep its position in
+  // the text view and rotate around that position.
+  rect.MoveTo(LayoutDevicePoint(center.x, center.y) -
+              LayoutDevicePoint(rect.width, rect.height) / 2.0f);
+  const CGFloat x = center.x / aScale;
+  const CGFloat y = center.y / aScale;
+  aTransform = CGAffineTransformMake(transform._11, transform._12,
+                                     transform._21, transform._22,
+                                     x - transform._11 * x - transform._21 * y,
+                                     y - transform._12 * x - transform._22 * y);
+  return DevPixelsToUIKitPoints(rect, aScale);
+}
