+// MARK: - Editing Commands
+
+- (BOOL)canPerformAction:(SEL)aAction withSender:(id)aSender {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler) {
+    return NO;
+  }
+
+  NSRange selection = [self selectedRange];
+  BOOL selected = selection.location != NSNotFound && selection.length;
+  BOOL editable = [self isEditable];
+
+  BOOL formatsText = aAction == @selector(toggleBoldface:) ||
+                     aAction == @selector(toggleItalics:) ||
+                     aAction == @selector(toggleUnderline:);
+
+  // Hide other actions while the old formatting submenu is open.
+  if (mEditable.mShowingTextStyleOptions && !formatsText) {
+    return NO;
+  }
+
+  if (formatsText || aAction == @selector(_showTextStyleOptions:)) {
+    const NativeTextInputReply* state = handler->NativeTextInputState();
+    if (!state || !state->mCanFormat) {
+      return NO;
+    }
+
+    if (formatsText) {
+      return YES;
+    }
+
+    if (@available(iOS 16.0, *)) {
+      return NO;
+    }
+
+    return selected;
+  }
+
+  if (aAction == @selector(_transpose)) {
+    return editable && !selected && [self hasText];
+  }
+
+  if (aAction == @selector(undo:) || aAction == @selector(redo:)) {
+    const NativeTextInputReply* state = handler->NativeTextInputState();
+    if (!editable || !state) {
+      return NO;
+    }
+
+    return aAction == @selector(undo:) ? state->mCanUndo : state->mCanRedo;
+  }
+
+  if (aAction == @selector(copy:)) {
+    return selected && !self.secureTextEntry;
+  }
+
+  if (aAction == @selector(cut:)) {
+    return editable && selected && !self.secureTextEntry;
+  }
+
+  if (aAction == @selector(paste:)) {
+    return editable && selection.location != NSNotFound &&
+           UIPasteboard.generalPasteboard.hasStrings;
+  }
+
+  if (aAction == @selector(delete:)) {
+    return editable && selected;
+  }
+
+  if (aAction == @selector(replace:)) {
+    return editable && !self.secureTextEntry;
+  }
+
+  if (aAction == @selector(select:)) {
+    return !selected && [self hasText] && !self.secureTextEntry;
+  }
+
+  if (aAction == @selector(selectAll:)) {
+    if (![self hasText]) {
+      return NO;
+    }
+
+    NSUInteger length = [self documentLength];
+    return length && !(selection.location == 0 && selection.length == length);
+  }
+
+  return [super canPerformAction:aAction withSender:aSender];
+}
+
+- (void)copy:(id)aSender {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (handler && [self canPerformAction:@selector(copy:) withSender:aSender]) {
+    handler->RunCommand(eContentCommandCopy, false);
+  }
+}
+
+- (void)cut:(id)aSender {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (handler && [self canPerformAction:@selector(cut:) withSender:aSender]) {
+    handler->RunCommand(eContentCommandCut, false);
+    [self refreshSelectionUI];
+  }
+}
+
+- (void)paste:(id)aSender {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (handler && [self canPerformAction:@selector(paste:) withSender:aSender]) {
+    handler->RunCommand(eContentCommandPaste, false);
+    [self refreshSelectionUI];
+  }
+}
+
+- (void)delete:(id)aSender {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (handler && [self canPerformAction:@selector(delete:)
+                             withSender:aSender]) {
+    handler->RunCommand(eContentCommandDelete, false);
+    [self refreshSelectionUI];
+  }
+}
+
+- (void)replace:(id)aSender {
+  if (![self canPerformAction:@selector(replace:) withSender:aSender]) {
+    return;
+  }
+
+  UIKeyboardImpl* keyboard =
+      [NSClassFromString(@"UIKeyboardImpl") activeInstance];
+  if ([keyboard inputDelegate] == self) {
+    [keyboard replaceText:aSender];
+  }
+}
+
+- (void)select:(id)aSender {
+  if (![self canPerformAction:@selector(select:) withSender:aSender]) {
+    return;
+  }
+
+  UITextRange* range = self.selectedTextRange;
+  if (!range || !range.empty) {
+    return;
+  }
+
+  UITextRange* word =
+      [self.tokenizer rangeEnclosingPosition:range.start
+                             withGranularity:UITextGranularityWord
+                                 inDirection:UITextStorageDirectionForward];
+  if (!word) {
+    word =
+        [self.tokenizer rangeEnclosingPosition:range.start
+                               withGranularity:UITextGranularityWord
+                                   inDirection:UITextStorageDirectionBackward];
+  }
+
+  if (word && !word.empty) {
+    self.selectedTextRange = word;
+    [[self selectionCommandController] showSelectionCommands];
+  }
+}
