+// MARK: - Password Autofill
+
+@protocol ChildViewCredentialDelegate <NSObject>
+- (nullable UITextContentType)autofillTextContentType;
+- (nullable NSString*)autofillOrigin;
+- (BOOL)acceptsLoginCredentials;
+- (void)didSelectAutofillUsername:(nullable NSString*)aUsername
+                         password:(nullable NSString*)aPassword;
+- (void)didSelectOneTimeCode:(NSString*)aOneTimeCode;
+@end
+
+@protocol CredentialSuggestion <NSObject>
+@property(nonatomic, readonly, nullable) NSString* username;
+@property(nonatomic, readonly, nullable) NSString* password;
+@end
+
+@interface ChildView (PasswordAutofill)
+- (void)setAutofillDelegate:(nullable id<ChildViewCredentialDelegate>)aDelegate;
+- (void)activatePasswordInputForAutofill;
+- (nullable NSURL*)activeAutofillURL;
+@end
+
+@implementation ChildView (PasswordAutofill)
+
+- (void)setAutofillDelegate:(id<ChildViewCredentialDelegate>)aDelegate {
+  mEditable.mCredentialDelegate = aDelegate;
+}
+
+- (UITextContentType)textContentType {
+  return [mEditable.mCredentialDelegate autofillTextContentType];
+}
+
+- (void)activatePasswordInputForAutofill {
+  [self cancelResponderBlur];
+  [self becomeFirstResponder];
+  [self reloadInputViews];
+}
+
+- (NSURL*)activeAutofillURL {
+  id<ChildViewCredentialDelegate> credentialDelegate =
+      mEditable.mCredentialDelegate;
+  if (!credentialDelegate) {
+    return nil;
+  }
+
+  NSString* autofillOrigin = [credentialDelegate autofillOrigin];
+  if (!autofillOrigin || !mGeckoChild || mGeckoChild->Destroyed()) {
+    return nil;
+  }
+
+  const widget::InputContext& context = mGeckoChild->GetInputContext();
+  if (!context.mURI) {
+    return nil;
+  }
+
+  nsAutoCString spec;
+  if (NS_FAILED(context.mURI->GetSpec(spec))) {
+    return nil;
+  }
+
+  NSString* urlString =
+      [[[NSString alloc] initWithBytes:spec.BeginReading()
+                                length:spec.Length()
+                              encoding:NSUTF8StringEncoding] autorelease];
+  NSURL* autofillURL = [NSURL URLWithString:urlString];
+  NSString* scheme = autofillURL.scheme.lowercaseString;
+  if (!autofillURL ||
+      (![scheme isEqualToString:@"http"] &&
+       ![scheme isEqualToString:@"https"]) ||
+      !CredentialOriginsMatch(autofillURL, autofillOrigin)) {
+    return nil;
+  }
+
+  return autofillURL;
+}
+
+- (NSDictionary*)_autofillContext {
+  NSURL* autofillURL = [self activeAutofillURL];
+  if (!autofillURL) {
+    return nil;
+  }
+
+  // https://github.com/WebKit/WebKit/blob/f82ca57ad9b7224c783cac937d15415af50d380f/Source/WebKit/UIProcess/ios/WKContentViewInteraction.mm#L11803
+  //
+  // Initially, I thought getting the credential chip to show is impossible
+  // since we can't set Associated Domains inside the app's settings, but
+  // looking at _TIKeyboardStateAutofillContextAssociatedDomainsKey and
+  // _AFAutoFillContextAssociatedDomainsKey by reversing AutoFillCore, seems
+  // like supplying the lowercased host to the _AssociatedDomains field is
+  // enough to make them show up!
+
+  BOOL acceptsLoginCredentials =
+      [mEditable.mCredentialDelegate acceptsLoginCredentials];
+  NSMutableDictionary* context =
+      [NSMutableDictionary dictionaryWithDictionary:@{
+        @"_WKAutofillContextVersion" : @2,
+        @"_WebViewURL" : autofillURL,
+        @"_AssociatedDomains" : @[ autofillURL.host.lowercaseString ],
+        // show the credential chip for the current domain instead of the
+        // generic "Passwords" chip
+      }];
+  if (acceptsLoginCredentials) {
+    context[@"_acceptsLoginCredentials"] = @YES;
+  }
+  return context;
+}
+
+- (void)insertTextSuggestion:(id)aSuggestion {
+  // https://github.com/WebKit/WebKit/blob/f82ca57ad9b7224c783cac937d15415af50d380f/Source/WebKit/UIProcess/ios/WKContentViewInteraction.mm#L6578
+  Class suggestionClass = NSClassFromString(@"UITextAutofillSuggestion");
+  if (!suggestionClass || ![aSuggestion isKindOfClass:suggestionClass] ||
+      ![aSuggestion respondsToSelector:@selector(username)] ||
+      ![aSuggestion respondsToSelector:@selector(password)] ||
+      ![mEditable.mCredentialDelegate acceptsLoginCredentials] ||
+      ![self activeAutofillURL]) {
+    return;
+  }
+
+  // Hand to Swift, Gecko remains the only DOM-filling mechanism
+  id<CredentialSuggestion> suggestion = aSuggestion;
+  [mEditable.mCredentialDelegate didSelectAutofillUsername:suggestion.username
+                                                  password:suggestion.password];
+}
+
+@end
