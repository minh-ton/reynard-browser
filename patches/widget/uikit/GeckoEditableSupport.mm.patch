+
+- (void)deleteBackward {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler || handler->HandlePhysicalDeleteBackward()) {
+    return;
+  }
+
+  NSRange marked;
+  NSRange selection = [self selectedRange];
+  if (handler->MarkedRange(marked) && selection.location != NSNotFound) {
+    NSString* text = [self textInRange:[self textRangeForRange:marked]];
+    if (!text) {
+      return;
+    }
+
+    if (selection.location < marked.location ||
+        NSMaxRange(selection) > NSMaxRange(marked)) {
+      return;
+    }
+
+    NSRange deletion =
+        NSMakeRange(selection.location - marked.location, selection.length);
+    if (!deletion.length && deletion.location) {
+      deletion =
+          [text rangeOfComposedCharacterSequenceAtIndex:deletion.location - 1];
+    }
+    if (deletion.length) {
+      NSString* replacement = [text stringByReplacingCharactersInRange:deletion
+                                                            withString:@""];
+      [self setMarkedText:replacement
+            selectedRange:NSMakeRange(deletion.location, 0)];
+    }
+    return;
+  }
+
+  if (handler->HandleCommand(Command::DeleteCharBackward)) {
+    handler->SynchronizeTextInputState();
+    [self scrollSelectionToVisible:NO];
+    [self refreshSelectionUI];
+  }
+}
