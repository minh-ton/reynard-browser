+- (void)_expandSelectionToBackwardDeletionCluster {
+  AutoRestore<BOOL> preparing(mEditable.mPreparingBackwardDeletionSelection);
+  mEditable.mPreparingBackwardDeletionSelection = YES;
+  [super _expandSelectionToBackwardDeletionCluster];
