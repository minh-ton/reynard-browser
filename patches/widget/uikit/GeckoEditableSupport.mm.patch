+bool TextInputHandler::QueryNativeTextInput(
+    const NativeTextInputRequest& aRequest, NativeTextInputReply& aReply) {
+  if (Destroyed() || !mWidget->GetInputContext().IsTextSelectable()) {
+    return false;
+  }
+
+  RefPtr<dom::BrowserParent> browser = dom::BrowserParent::GetFocused();
+  if (!browser) {
+    return false;
+  }
+
+  nsCOMPtr<nsIWidget> widget = browser->GetTextInputHandlingWidget();
+  if (widget != mWidget) {
+    return false;
+  }
+
+  RefPtr<TextInputHandler> self(this);
+  const uint64_t focusGeneration = mNativeTextInputFocusGeneration;
+
+  bool hasCachedGeometry = false;
+  const bool geometryQuery =
+      aRequest.mQuery == NativeTextInputQuery::Caret ||
+      aRequest.mQuery == NativeTextInputQuery::SelectionHighlightRects;
+  if (geometryQuery && mNativeTextInputState && !mNativeTextInputStateDirty) {
+    aReply = NativeTextInputReply();
+    aReply.mSucceeded = true;
+    aReply.mEditable = mNativeTextInputState->mEditable;
+    aReply.mSelectable = mNativeTextInputState->mSelectable;
+
+    if (aRequest.mQuery == NativeTextInputQuery::Caret) {
+      for (const auto& caret : mNativeTextInputState->mCaretRects) {
+        if (caret.mStartOffset == aRequest.mOffset &&
+            caret.mAssociateWithNext == aRequest.mAssociateWithNext) {
+          aReply.mRect = caret.mRect;
+          aReply.mRTL = caret.mRTL;
+          aReply.mScrollReferences = caret.mScrollReferences.Clone();
+          aReply.mCaretRects.AppendElement(caret);
+          hasCachedGeometry = true;
+          break;
+        }
+      }
+    } else if (aRequest.mOffset == mNativeTextInputState->mSelectionStart &&
+               aRequest.mLength == mNativeTextInputState->mSelectionLength) {
+      aReply.mRects = mNativeTextInputState->mRects.Clone();
+      hasCachedGeometry = true;
+    }
+  }
+
+  if (!hasCachedGeometry) {
+    if (mUpdatingSelectionFromCompositor) {
+      return false;
+    }
+
+    if (!browser->QueryNativeTextInput(aRequest, aReply)) {
+      return false;
+    }
+  }
+
+  if (aRequest.mQuery == NativeTextInputQuery::BlurFocusedInput) {
+    return !Destroyed();
+  }
+
+  if (Destroyed() || !mWidget->GetInputContext().IsTextSelectable()) {
+    return false;
+  }
+
+  if (!aReply.mSelectable || dom::BrowserParent::GetFocused() != browser) {
+    return false;
+  }
+
+  return focusGeneration == mNativeTextInputFocusGeneration;
+}
+
+void TextInputHandler::InvalidateTextInputState(bool aFocusChanged) {
+  if (aFocusChanged) {
+    ++mNativeTextInputFocusGeneration;
+    ChildView* view =
+        static_cast<ChildView*>(mWidget->GetNativeData(NS_NATIVE_WIDGET));
+    if (view) {
+      [view cancelAutoscroll];
+      view->mEditable.mFloatingCursorActive = NO;
+    }
+
+    if (!mWidget->GetInputContext().IsTextSelectable()) {
+      mWidget->SetNativeTextInputScrollers({});
+    }
+  }
+
+  mNativeTextInputStateDirty = true;
+  InvalidateTextInputGeometry();
+}
+
+void TextInputHandler::InvalidateTextInputGeometry() {
+  mNativeTextInputGeometryDirty = true;
+}
+
+const NativeTextInputReply* TextInputHandler::NativeTextInputState() {
+  RefPtr<TextInputHandler> self(this);
+  if (mUpdatingSelectionFromCompositor) {
+    return mNativeTextInputState.isSome() ? &mNativeTextInputState.ref()
+                                          : nullptr;
+  }
+
+  if (mNativeTextInputStateDirty && !mSynchronizingNativeTextInputState) {
+    if (!SynchronizeTextInputState(true)) {
+      return nullptr;
+    }
+  }
+
+  if (mNativeTextInputState && mNativeTextInputGeometryDirty &&
+      !mSynchronizingNativeTextInputState) {
+    if (mWidget->IsAsyncScrolling(mNativeTextInputState->mSelectionScrollers)) {
+      return &mNativeTextInputState.ref();
+    }
+
+    AutoRestore<bool> synchronizing(mSynchronizingNativeTextInputState);
+    mSynchronizingNativeTextInputState = true;
+
+    NativeTextInputRequest request;
+    request.mQuery = NativeTextInputQuery::Appearance;
+    request.mOffset = mNativeTextInputState->mSelectionStart;
+    request.mLength = mNativeTextInputState->mSelectionLength;
+    NativeTextInputReply reply;
+
+    if (!QueryNativeTextInput(request, reply) || !mNativeTextInputState) {
+      return nullptr;
+    }
+
+    mNativeTextInputState->mRect = reply.mRect;
+    mNativeTextInputState->mCaretColor = reply.mCaretColor;
+    mNativeTextInputState->mCaretColorIsAuto = reply.mCaretColorIsAuto;
+    mNativeTextInputState->mSuppressSelectionDisplay =
+        reply.mSuppressSelectionDisplay;
+    mNativeTextInputState->mSelectionScrollers =
+        std::move(reply.mSelectionScrollers);
+    mNativeTextInputState->mScrollReferences =
+        std::move(reply.mScrollReferences);
+    mNativeTextInputState->mClipRects = std::move(reply.mClipRects);
+    mNativeTextInputState->mCaretRects = std::move(reply.mCaretRects);
+    mNativeTextInputState->mRects = std::move(reply.mRects);
+    mNativeTextInputGeometryDirty = false;
+    UpdateSelectionScrollState();
+    if (Destroyed()) {
+      return nullptr;
+    }
+  }
+
+  return mNativeTextInputState.isSome() ? &mNativeTextInputState.ref()
+                                        : nullptr;
+}
+
+bool TextInputHandler::SynchronizeTextInputState(bool aNotifyInputDelegate) {
+  if (mSynchronizingNativeTextInputState) {
+    mNativeTextInputStateDirty = true;
+    return false;
+  }
+
+  RefPtr<TextInputHandler> self(this);
+  AutoRestore<bool> synchronizing(mSynchronizingNativeTextInputState);
+  mSynchronizingNativeTextInputState = true;
+  NativeTextInputRequest request;
+  NativeTextInputReply reply;
+  if (!QueryNativeTextInput(request, reply)) {
+    mNativeTextInputState.reset();
+    mNativeTextInputStateDirty = true;
+    return false;
+  }
+
+  const uint64_t focusGeneration = mNativeTextInputFocusGeneration;
+  const bool hadCachedState = mNativeTextInputState.isSome();
+  bool textChanged = false;
+  bool selectionChanged = false;
+  if (mNativeTextInputState) {
+    textChanged = !mNativeTextInputState->mText.Equals(reply.mText);
+    selectionChanged =
+        mNativeTextInputState->mSelectionStart != reply.mSelectionStart ||
+        mNativeTextInputState->mSelectionLength != reply.mSelectionLength ||
+        mNativeTextInputState->mAssociateWithNext != reply.mAssociateWithNext;
+  }
+
+  mNativeTextInputStateDirty = false;
+  mNativeTextInputGeometryDirty = false;
+
+  ChildView* view =
+      [[static_cast<ChildView*>(mWidget->GetNativeData(NS_NATIVE_WIDGET))
+          retain] autorelease];
+  id<UITextInputDelegate> delegate = [[view.inputDelegate retain] autorelease];
+
+  // UIKit handles notifications for its own edits. For changes from Gecko, keep
+  // the old text until the will-change callbacks finish.
+  if (aNotifyInputDelegate) {
+    if (textChanged) {
+      [delegate textWillChange:view];
+    }
+    if (selectionChanged) {
+      [delegate selectionWillChange:view];
+    }
+  }
+
+  const bool currentFocus =
+      !Destroyed() && focusGeneration == mNativeTextInputFocusGeneration;
+  if (view && currentFocus) {
+    view->mEditable.mSelectionAffinity = reply.mAssociateWithNext
+                                             ? UITextStorageDirectionForward
+                                             : UITextStorageDirectionBackward;
+  }
+  if (currentFocus) {
+    mNativeTextInputState = Some(std::move(reply));
+    UpdateSelectionScrollState();
+  }
+
+  if (aNotifyInputDelegate) {
+    if (textChanged) {
+      [delegate textDidChange:view];
+    }
+    if (selectionChanged) {
+      [delegate selectionDidChange:view];
+    }
+  }
+
+  if (!currentFocus || Destroyed()) {
+    return false;
+  }
+
+  // The callbacks can change focus again after we update the cache.
+  if (focusGeneration != mNativeTextInputFocusGeneration) {
+    return false;
+  }
+
+  if (aNotifyInputDelegate && (selectionChanged || !hadCachedState)) {
+    [[view interactionAssistant] selectionChanged];
+  }
+
+  return !Destroyed() && focusGeneration == mNativeTextInputFocusGeneration;
+}
+
+bool TextInputHandler::SelectedRange(NSRange& aRange) {
+  RefPtr<TextInputHandler> self(this);
+  aRange = NSMakeRange(NSNotFound, 0);
+  if (mSelectedRangeOverride) {
+    aRange = *mSelectedRangeOverride;
+    return true;
+  }
+
+  const NativeTextInputReply* state = NativeTextInputState();
+  if (!state || state->mSelectionStart == UINT32_MAX) {
+    return false;
+  }
+
+  aRange = NSMakeRange(state->mSelectionStart, state->mSelectionLength);
+  return true;
+}
+
+bool TextInputHandler::MarkedRange(NSRange& aRange) {
+  aRange = HasMarkedText() ? mMarkedRange : NSMakeRange(NSNotFound, 0);
+  return HasMarkedText();
+}
+
+bool TextInputHandler::SetSelectedRange(const NSRange& aRange,
+                                        bool aAssociateWithNext,
+                                        bool aForDeletion) {
+  RefPtr<TextInputHandler> self(this);
+  if (Destroyed() || aRange.location == NSNotFound) {
+    return false;
+  }
+
+  if (aRange.location > UINT32_MAX ||
+      aRange.length > UINT32_MAX - aRange.location) {
+    return false;
+  }
+
+  if (!PrepareCurrentKeyForIME()) {
+    return false;
+  }
+
+  bool selectingMarkedText = false;
+  if (HasMarkedText()) {
+    selectingMarkedText = aRange.location >= mMarkedRange.location &&
+                          NSMaxRange(aRange) <= NSMaxRange(mMarkedRange);
+    if (!selectingMarkedText && !UnmarkText()) {
+      return false;
+    }
+  }
+
+  ChildView* view =
+      static_cast<ChildView*>(mWidget->GetNativeData(NS_NATIVE_WIDGET));
+  if (aForDeletion || (!selectingMarkedText && [view isInteractingWithText])) {
+    NativeTextInputRequest request;
+    request.mQuery = aForDeletion ? NativeTextInputQuery::PrepareDeletion
+                                  : NativeTextInputQuery::SetSelection;
+    request.mOffset = aRange.location;
+    request.mLength = aRange.length;
+    request.mAssociateWithNext = aAssociateWithNext;
+    NativeTextInputReply reply;
+    if (!QueryNativeTextInput(request, reply)) {
+      MarkCurrentKeyEventFailed();
+      return false;
+    }
+  } else {
+    WidgetSelectionEvent event(true, eSetSelection, mWidget);
+    event.mOffset = static_cast<uint32_t>(aRange.location);
+    event.mLength = static_cast<uint32_t>(aRange.length);
+    event.mExpandToClusterBoundary = false;
+    event.mAssociateWithNext = Some(aAssociateWithNext);
+    mWidget->DispatchWindowEvent(event);
+    if (!event.mSucceeded) {
+      MarkCurrentKeyEventFailed();
+      return false;
+    }
+  }
+
+  if (selectingMarkedText && HasMarkedText()) {
+    // Move the caret within marked text without replacing the composition.
+    mSelectedRangeOverride = Some(aRange);
+  }
+
+  if (!SynchronizeTextInputState()) {
+    return false;
+  }
+
+  return mNativeTextInputState->mSelectionStart == aRange.location &&
+         mNativeTextInputState->mSelectionLength == aRange.length;
+}
+
+bool TextInputHandler::TextLength(uint32_t& aLength) {
+  RefPtr<TextInputHandler> self(this);
+  const NativeTextInputReply* state = NativeTextInputState();
+  aLength = state ? state->mText.Length() : 0;
+  return state;
+}
+
+bool TextInputHandler::TextInRange(const NSRange& aRange, nsString& aText) {
+  RefPtr<TextInputHandler> self(this);
+  aText.Truncate();
+  const NativeTextInputReply* state = NativeTextInputState();
+  if (!state || aRange.location == NSNotFound ||
+      aRange.location > state->mText.Length()) {
+    return false;
+  }
+
+  aText.Assign(
+      Substring(state->mText, aRange.location,
+                std::min(aRange.length,
+                         NSUInteger(state->mText.Length() - aRange.location))));
+  return true;
+}
+
+bool TextInputHandler::ReplaceRange(const NSRange& aRange, NSString* aText) {
+  RefPtr<TextInputHandler> self(this);
+  if (Destroyed() || aRange.location == NSNotFound) {
+    return false;
+  }
+
+  const uint64_t focusGeneration = mNativeTextInputFocusGeneration;
+  if (!PrepareCurrentKeyForIME()) {
+    return false;
+  }
+
+  if (HasMarkedText() && !UnmarkText()) {
+    return false;
+  }
+
+  if (Destroyed() || focusGeneration != mNativeTextInputFocusGeneration) {
+    return false;
+  }
+
+  uint32_t length;
+  if (!TextLength(length)) {
+    return false;
+  }
+
+  if (aRange.location > length || aRange.length > length - aRange.location) {
+    return false;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::ReplaceText;
+  request.mOffset = aRange.location;
+  request.mLength = aRange.length;
+  CopyNSStringToXPCOMString(aText ?: @"", request.mText);
+  request.mText.ReplaceSubstring(u"\r\n"_ns, u"\n"_ns);
+  request.mText.ReplaceSubstring(u"\r"_ns, u"\n"_ns);
+  NativeTextInputReply reply;
+  return QueryNativeTextInput(request, reply) && SynchronizeTextInputState();
+}
+
+bool TextInputHandler::RunCommand(EventMessage aMessage, bool aOnlyEnabledCheck,
+                                  bool* aIsEnabled) {
+  RefPtr<TextInputHandler> self(this);
+  if (Destroyed()) {
+    return false;
+  }
+
+  WidgetContentCommandEvent event(true, aMessage, mWidget, aOnlyEnabledCheck);
+  mWidget->DispatchWindowEvent(event);
+  if (aIsEnabled) {
+    *aIsEnabled = event.mIsEnabled;
+  }
+
+  if (!event.mSucceeded) {
+    MarkCurrentKeyEventFailed();
+    return false;
+  }
+
+  if (aOnlyEnabledCheck) {
+    return true;
+  }
+
+  switch (aMessage) {
+    case eContentCommandDelete:
+    case eContentCommandUndo:
+    case eContentCommandRedo:
+      return SynchronizeTextInputState(true);
+    default:
+      // These commands finish later. Gecko notifies UIKit of their changes.
+      return true;
+  }
+}
