+- (id<UITextInputTraits>)textInputTraits {
+  id<GeckoUITextInputTraitsPrivate> traits =
+      static_cast<id<GeckoUITextInputTraitsPrivate>>(
+          mEditable.mTextInputTraits);
+  [traits takeTraitsFrom:self];
+  traits.insertionPointColor = self.insertionPointColor;
+  traits.isSingleLineDocument = NO;
+  traits.learnsCorrections = NO;
+  if ([traits respondsToSelector:@selector(setShortcutConversionType:)]) {
+    traits.shortcutConversionType = self.secureTextEntry
+                                        ? UITextShortcutConversionTypeNo
+                                        : UITextShortcutConversionTypeDefault;
+  }
+
+  if (mGeckoChild && !mGeckoChild->Destroyed()) {
+    const InputContext& context = mGeckoChild->GetInputContext();
+    if (context.mIMEState.IsEditable()) {
+      traits.isSingleLineDocument = context.GetNativeKeyBindingsType() ==
+                                    NativeKeyBindingsType::SingleLineEditor;
+      traits.learnsCorrections =
+          !context.mInPrivateBrowsing && !context.mHasBeenPassword;
+    }
+  }
+  return traits;
+}
+
+- (void)takeTraitsFrom:(id<UITextInputTraits>)aTraits {
+  [static_cast<id<GeckoUITextInputTraitsPrivate>>(mEditable.mTextInputTraits)
+      takeTraitsFrom:aTraits];
+}
+
+- (UIKeyboardType)keyboardType {
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return UIKeyboardTypeDefault;
+  }
+
+  return UIKitUtils::GetUIKeyboardType(mGeckoChild->GetInputContext());
+}
+
+- (UIReturnKeyType)returnKeyType {
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return UIReturnKeyDefault;
+  }
+
+  return UIKitUtils::GetUIReturnKeyType(mGeckoChild->GetInputContext());
+}
+
+- (UITextAutocapitalizationType)autocapitalizationType {
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return UITextAutocapitalizationTypeNone;
+  }
+
+  return UIKitUtils::GetUITextAutocapitalizationType(
+      mGeckoChild->GetInputContext());
+}
+
+- (UITextAutocorrectionType)autocorrectionType {
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return UITextAutocorrectionTypeDefault;
+  }
+
+  return UIKitUtils::GetUITextAutocorrectionType(
+      mGeckoChild->GetInputContext());
+}
+
+- (UITextInlinePredictionType)inlinePredictionType API_AVAILABLE(ios(17.0)) {
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return UITextInlinePredictionTypeNo;
+  }
+
+  if (!mGeckoChild->GetInputContext().mWritingSuggestionsEnabled) {
+    return UITextInlinePredictionTypeNo;
+  }
+
+  if (self.secureTextEntry) {
+    return UITextInlinePredictionTypeNo;
+  }
+
+  if (self.autocorrectionType == UITextAutocorrectionTypeNo) {
+    return UITextInlinePredictionTypeNo;
+  }
+
+  // UIKit disables default inline predictions for custom text views, so we cant
+  // use type default here.
+  return UITextInlinePredictionTypeYes;
+}
+
+- (UITextSpellCheckingType)spellCheckingType {
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return UITextSpellCheckingTypeDefault;
+  }
+
+  const InputContext& context = mGeckoChild->GetInputContext();
+  return context.mSpellCheckingEnabled && !context.IsPasswordEditor()
+             ? UITextSpellCheckingTypeDefault
+             : UITextSpellCheckingTypeNo;
+}
+
+- (UITextSmartQuotesType)smartQuotesType {
+  return self.spellCheckingType == UITextSpellCheckingTypeNo
+             ? UITextSmartQuotesTypeNo
+             : UITextSmartQuotesTypeDefault;
+}
+
+- (UITextSmartDashesType)smartDashesType {
+  return self.spellCheckingType == UITextSpellCheckingTypeNo
+             ? UITextSmartDashesTypeNo
+             : UITextSmartDashesTypeDefault;
+}
+
+- (BOOL)isSecureTextEntry {
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return NO;
+  }
+
+  return mGeckoChild->GetInputContext().IsPasswordEditor();
+}
