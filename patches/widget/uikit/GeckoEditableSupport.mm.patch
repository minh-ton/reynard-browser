+  }
+
+  RefPtr<TextRangeArray> styles =
+      CompositionStyles(aText, self.markedTextStyle, self.traitCollection);
+  if (handler->SetMarkedText(aText.string, aRange, styles)) {
+    handler->SynchronizeTextInputState();
+    [self scrollSelectionToVisible:NO];
+    [self refreshSelectionUI];
+  }
+}
