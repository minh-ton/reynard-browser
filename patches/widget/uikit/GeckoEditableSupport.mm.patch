+- (void)_transpose {
+  if (![self isEditable]) {
+    return;
+  }
+
+  UITextRange* range = self.selectedTextRange;
+  if (!range || !range.empty) {
+    return;
+  }
+
+  UITextRange* paragraph =
+      [self.tokenizer rangeEnclosingPosition:range.start
+                             withGranularity:UITextGranularityParagraph
+                                 inDirection:UITextStorageDirectionBackward];
+
+  if (!paragraph) {
+    return;
+  }
+
+  // At a paragraph end, swap the last two characters instead.
+  BOOL atEnd = [self comparePosition:range.start
+                          toPosition:paragraph.end] == NSOrderedSame;
+  UITextPosition* end = range.end;
+
+  if (!atEnd) {
+    end = [self.tokenizer positionFromPosition:end
+                                    toBoundary:UITextGranularityCharacter
+                                   inDirection:UITextStorageDirectionForward];
+  }
+
+  if (!end) {
+    return;
+  }
+
+  UITextPosition* middle =
+      [self.tokenizer positionFromPosition:end
+                                toBoundary:UITextGranularityCharacter
+                               inDirection:UITextStorageDirectionBackward];
+  if (!middle) {
+    return;
+  }
+
+  UITextPosition* start =
+      [self.tokenizer positionFromPosition:middle
+                                toBoundary:UITextGranularityCharacter
+                               inDirection:UITextStorageDirectionBackward];
+  if (!start) {
+    return;
+  }
+
+  if ([self comparePosition:start
+                 toPosition:paragraph.start] == NSOrderedAscending) {
+    return;
+  }
+
+  if ([self comparePosition:end
+                 toPosition:paragraph.end] == NSOrderedDescending) {
+    return;
+  }
+
+  UITextRange* firstRange = [self textRangeFromPosition:start
+                                             toPosition:middle];
+  UITextRange* secondRange = [self textRangeFromPosition:middle toPosition:end];
+
+  NSString* first = [self textInRange:firstRange];
+  NSString* second = [self textInRange:secondRange];
+  if (!first.length || !second.length) {
+    return;
+  }
+
+  [self replaceRange:[self textRangeFromPosition:start toPosition:end]
+            withText:[second stringByAppendingString:first]];
+}
+
