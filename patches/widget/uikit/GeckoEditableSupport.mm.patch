+- (void)_showTextStyleOptions:(id)aSender {
+  if (@available(iOS 16.0, *)) {
+    return;
+  } else {
+    if (![self canPerformAction:_cmd withSender:aSender]) {
+      return;
+    }
+
+    mEditable.mShowingTextStyleOptions = YES;
+    [NSNotificationCenter.defaultCenter
+        addObserver:self
+           selector:@selector(textStyleMenuDidHide:)
+               name:UIMenuControllerDidHideMenuNotification
+             object:nil];
+
+    NSBundle* bundle = [NSBundle bundleForClass:UIView.class];
+    auto item = [&](NSString* aTitle, SEL aAction) {
+      NSString* title = [bundle localizedStringForKey:aTitle
+                                                value:aTitle
+                                                table:nil];
+      UIMenuItem* menuItem =
+          [[[UIMenuItem alloc] initWithTitle:title action:aAction] autorelease];
+      menuItem.dontDismiss = YES;
+      return menuItem;
+    };
+
+    UIMenuController* menu = UIMenuController.sharedMenuController;
+    menu.menuItems = @[
+      item(@"Bold", @selector(toggleBoldface:)),
+      item(@"Italic", @selector(toggleItalics:)),
+      item(@"Underline", @selector(toggleUnderline:))
+    ];
+
+    [menu showMenuFromView:self
+                      rect:[self firstRectForRange:self.selectedTextRange]];
+  }
+}
+
+- (void)textStyleMenuDidHide:(NSNotification*)aNotification {
+  if (@available(iOS 16.0, *)) {
+    return;
+  } else {
+    if (!mEditable.mShowingTextStyleOptions) {
+      return;
+    }
+
+    mEditable.mShowingTextStyleOptions = NO;
+    UIMenuController.sharedMenuController.menuItems = nil;
+    [NSNotificationCenter.defaultCenter
+        removeObserver:self
+                  name:UIMenuControllerDidHideMenuNotification
+                object:nil];
+  }
+}
