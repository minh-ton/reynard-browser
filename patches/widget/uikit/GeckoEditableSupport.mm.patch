+// MARK: - Text Geometry and Hit Testing
+
+- (CGRect)_selectionClipRect {
+  CGRect bounds = self.bounds;
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  LayoutDeviceRect editor;
+  if (handler && handler->EditorRect(editor)) {
+    bounds = CGRectIntersection(
+        bounds, DevPixelsToUIKitPoints(editor, self.contentScaleFactor));
+  }
+  return CGRectIsNull(bounds) ? CGRectZero : bounds;
+}
+
+- (UIColor*)insertionPointColor {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  const NativeTextInputReply* state =
+      handler ? handler->NativeTextInputState() : nullptr;
+  if (!state) {
+    return self.tintColor;
+  }
+
+  const nscolor color = state->mCaretColor;
+  if (state->mCaretColorIsAuto && NS_GET_A(color)) {
+    return self.tintColor;
+  }
+
+  return [UIColor colorWithRed:NS_GET_R(color) / 255.0
+                         green:NS_GET_G(color) / 255.0
+                          blue:NS_GET_B(color) / 255.0
+                         alpha:NS_GET_A(color) / 255.0];
+}
+
+- (CGRect)caretRectForPosition:(UITextPosition*)aPosition
+                     transform:(CGAffineTransform*)aTransform {
+  *aTransform = CGAffineTransformIdentity;
+
+  ChildViewTextPosition* position = [self textPosForPosition:aPosition];
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!position || !handler) {
+    return CGRectZero;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::Caret;
+  request.mOffset = position.offset;
+  request.mAssociateWithNext =
+      position.affinity == UITextStorageDirectionForward;
+  NativeTextInputReply reply;
+  if (!handler->QueryNativeTextInput(request, reply)) {
+    return CGRectZero;
+  }
+
+  if (@available(iOS 17.4, *)) {
+    const auto& caret = reply.mCaretRects[0];
+    return UIKitSelectionGeometry(*handler, caret, self.contentScaleFactor,
+                                  *aTransform, /* aCaret */ true);
+  }
+
+  CGRect rect = DevPixelsToUIKitPoints(
+      handler->TransformSelectionRect(reply.mRect, reply.mScrollReferences),
+      self.contentScaleFactor);
+  if (@available(iOS 17.0, *)) {
+    return rect;
+  }
+
+  // Workaround for tiny caret width on older iOS versions.
+  if (rect.size.width <= rect.size.height) {
+    rect = CGRectInset(rect, (rect.size.width - 2.0) / 2.0, 0);
+  } else {
+    rect = CGRectInset(rect, 0, (rect.size.height - 2.0) / 2.0);
+  }
+  return rect;
+}
+
+- (CGRect)caretRectForPosition:(UITextPosition*)aPosition {
+  CGAffineTransform transform;
+  return [self caretRectForPosition:aPosition transform:&transform];
+}
+
+- (CGAffineTransform)caretTransformForPosition:(UITextPosition*)aPosition
+    API_AVAILABLE(ios(17.4)) {
+  CGAffineTransform transform;
+  [self caretRectForPosition:aPosition transform:&transform];
+  return transform;
+}
+
+- (NSArray<UITextSelectionRect*>*)selectionRectsForRange:(UITextRange*)aRange {
+  NSRange range = [self rangeForTextRange:aRange];
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler || range.location == NSNotFound || !range.length) {
+    return @[];
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::SelectionHighlightRects;
+  request.mOffset = range.location;
+  request.mLength = range.length;
+  NativeTextInputReply reply;
+  if (!handler->QueryNativeTextInput(request, reply)) {
+    return @[];
+  }
+
+  NSMutableArray<UITextSelectionRect*>* rects =
+      [NSMutableArray arrayWithCapacity:reply.mRects.Length()];
+  for (const auto& rect : reply.mRects) {
+    CGRect highlight;
+    CGAffineTransform transform = CGAffineTransformIdentity;
+    if (@available(iOS 17.4, *)) {
+      highlight = UIKitSelectionGeometry(*handler, rect,
+                                         self.contentScaleFactor, transform);
+    } else {
+      highlight = DevPixelsToUIKitPoints(
+          handler->TransformSelectionRect(rect.mRect, rect.mScrollReferences),
+          self.contentScaleFactor);
+    }
+
+    ChildViewTextSelectionRect* result =
+        [ChildViewTextSelectionRect selectionRectWithRect:highlight
+                                            containsStart:rect.mContainsStart
+                                              containsEnd:rect.mContainsEnd];
+    result.transformValue = transform;
+    result.writingDirectionValue = rect.mRTL ? NSWritingDirectionRightToLeft
+                                             : NSWritingDirectionLeftToRight;
+    result.verticalValue = rect.mVertical;
+    [rects addObject:result];
+  }
+  return rects;
+}
+
+- (CGRect)firstRectForRange:(UITextRange*)aRange {
+  NSRange range = [self rangeForTextRange:aRange];
+  if (range.location == NSNotFound) {
+    return CGRectZero;
+  }
+
+  if (!range.length) {
+    CGAffineTransform transform;
+    CGRect rect = [self caretRectForPosition:aRange.start transform:&transform];
+    return CGRectApplyAffineTransform(rect, transform);
+  }
+
+  NSArray<UITextSelectionRect*>* rects = [self selectionRectsForRange:aRange];
+  UITextSelectionRect* first = rects.firstObject;
+  for (UITextSelectionRect* rect in rects) {
+    if (rect.containsStart) {
+      first = rect;
+      break;
+    }
+  }
+
+  if (!first) {
+    return CGRectZero;
+  }
+  if (@available(iOS 17.4, *)) {
+    return CGRectApplyAffineTransform(first.rect, first.transform);
+  }
+  return first.rect;
+}
+
+- (UITextPosition*)closestPositionToPoint:(CGPoint)aPoint {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler) {
+    return nil;
+  }
+
+  if (!std::isfinite(aPoint.x) || !std::isfinite(aPoint.y)) {
+    return nil;
+  }
+
+  if (!mEditable.mFloatingCursorActive && [self isInteractingWithText]) {
+    [self startAutoscroll:aPoint];
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::HitTest;
+  request.mPoint = UIKitPointsToDevPixels(aPoint, self.contentScaleFactor);
+  NativeTextInputReply reply;
+
+  if (!handler->QueryNativeTextInput(request, reply)) {
+    return nil;
+  }
+
+  if (reply.mOffset == UINT32_MAX) {
+    return nil;
+  }
+
+  return [ChildViewTextPosition
+      positionWithOffset:reply.mOffset
+                affinity:reply.mAssociateWithNext
+                             ? UITextStorageDirectionForward
+                             : UITextStorageDirectionBackward];
+}
+
+- (UITextPosition*)closestPositionToPoint:(CGPoint)aPoint
+                              withinRange:(UITextRange*)aRange {
+  NSRange range = [self rangeForTextRange:aRange];
+  ChildViewTextPosition* position =
+      [self textPosForPosition:[self closestPositionToPoint:aPoint]];
+  if (!position || range.location == NSNotFound) {
+    return nil;
+  }
+
+  if (position.offset < range.location) {
+    return aRange.start;
+  }
+
+  if (position.offset > NSMaxRange(range)) {
+    return aRange.end;
+  }
+
+  return position;
+}
+
+- (UITextPosition*)_findPleasingWordBoundaryFromPosition:
+    (UITextPosition*)aPosition {
+  if (![self isEditable]) {
+    return [super _findPleasingWordBoundaryFromPosition:aPosition];
+  }
+
+  // UIKit calls this after a single tap. Keep the position Gecko found instead
+  // of moving the caret to the start or end of the word.
+  return aPosition;
+}
+
+- (UITextRange*)characterRangeAtPoint:(CGPoint)aPoint {
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler) {
+    return nil;
+  }
+
+  if (!std::isfinite(aPoint.x) || !std::isfinite(aPoint.y)) {
+    return nil;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::HitTest;
+  request.mPoint = UIKitPointsToDevPixels(aPoint, self.contentScaleFactor);
+  NativeTextInputReply reply;
+  if (!handler->QueryNativeTextInput(request, reply) ||
+      reply.mCharacterOffset == UINT32_MAX) {
+    return nil;
+  }
+
+  UITextPosition* position =
+      [ChildViewTextPosition positionWithOffset:reply.mCharacterOffset];
+  return [self.tokenizer rangeEnclosingPosition:position
+                                withGranularity:UITextGranularityCharacter
+                                    inDirection:UITextStorageDirectionForward];
+}
+
+- (UITextPosition*)positionWithinRange:(UITextRange*)aRange
+                   farthestInDirection:(UITextLayoutDirection)aDirection {
+  NSRange range = [self rangeForTextRange:aRange];
+  RefPtr<widget::TextInputHandler> handler = [self textHandler];
+  if (!handler || range.location == NSNotFound) {
+    return nil;
+  }
+
+  if (!range.length) {
+    return aRange.start;
+  }
+
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::SelectionRects;
+  request.mOffset = range.location;
+  request.mLength = range.length;
+  NativeTextInputReply reply;
+  if (!handler->QueryNativeTextInput(request, reply)) {
+    return nil;
+  }
+
+  BOOL backward = aDirection == UITextLayoutDirectionLeft ||
+                  aDirection == UITextLayoutDirectionUp;
+  BOOL vertical = aDirection == UITextLayoutDirectionUp ||
+                  aDirection == UITextLayoutDirectionDown;
+  int32_t best = backward ? INT32_MAX : INT32_MIN;
+  NSUInteger offset = backward ? range.location : NSMaxRange(range);
+  BOOL associateWithNext = backward;
+  for (const auto& rect : reply.mRects) {
+    const int32_t firstEdge = vertical ? rect.mRect.Y() : rect.mRect.X();
+    const int32_t lastEdge = vertical ? rect.mRect.YMost() : rect.mRect.XMost();
+    const int32_t edge = backward ? firstEdge : lastEdge;
+    bool startsAtEdge = backward;
+    if (vertical == rect.mVertical && rect.mRTL) {
+      startsAtEdge = !startsAtEdge;
+    }
+    NSUInteger candidate = startsAtEdge ? rect.mStartOffset : rect.mEndOffset;
+    bool better = backward ? edge < best : edge > best;
+    if (edge == best) {
+      better = backward ? candidate < offset : candidate > offset;
+    }
+
+    if (better) {
+      best = edge;
+      offset = candidate;
+      associateWithNext = startsAtEdge;
+    }
+  }
+  offset = std::clamp(offset, range.location, NSMaxRange(range));
+  return [ChildViewTextPosition
+      positionWithOffset:offset
+                affinity:associateWithNext ? UITextStorageDirectionForward
+                                           : UITextStorageDirectionBackward];
+}
