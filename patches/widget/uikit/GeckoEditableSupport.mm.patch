+
+void nsWindow::NotifyNativeTextInputScrollUpdates(
+    mozilla::ipc::ByteBuf&& aData) {
+  const CheckedInt<int> length(aData.mLen);
+  if (!length.isValid() || length.value() < IPC::Message::HeaderSize()) {
+    return;
+  }
+
+  const char* bytes = reinterpret_cast<const char*>(aData.mData);
+  if (IPC::Message::MessageSize(bytes, bytes + aData.mLen) != aData.mLen) {
+    return;
+  }
+
+  IPC::Message message(bytes, length.value());
+  IPC::MessageReader reader(message);
+  nsTArray<NativeTextInputScrollUpdate> updates;
+  if (!IPC::ReadParam(&reader, &updates)) {
+    return;
+  }
+
+  bool selectionMoved = false;
+  if (mTextInputHandler) {
+    auto hasChangedSelectionScroller = [&](const auto& aCurrent,
+                                           const auto& aPrevious) {
+      for (const auto& update : aCurrent) {
+        if (!mTextInputHandler->SelectionUsesScroller(update.mGuid)) {
+          continue;
+        }
+
+        if (!aPrevious.Contains(update)) {
+          return true;
+        }
+      }
+      return false;
+    };
+
+    selectionMoved =
+        hasChangedSelectionScroller(updates, mNativeTextInputScrollUpdates) ||
+        hasChangedSelectionScroller(mNativeTextInputScrollUpdates, updates);
+  }
+
+  mNativeTextInputScrollUpdates = std::move(updates);
+  if (selectionMoved) {
+    mTextInputHandler->UpdateSelectionScrollState(true);
+  }
+}
+
+const NativeTextInputScrollUpdate* nsWindow::GetNativeTextInputScrollUpdate(
+    const ScrollableLayerGuid& aGuid) const {
+  for (const auto& update : mNativeTextInputScrollUpdates) {
+    if (update.mGuid == aGuid) {
+      return &update;
+    }
+  }
+  return nullptr;
+}
+
+bool nsWindow::IsAsyncScrolling(
+    const nsTArray<ScrollableLayerGuid>& aScrollers) const {
+  for (const auto& scroller : aScrollers) {
+    const auto* update = GetNativeTextInputScrollUpdate(scroller);
+    if (update && update->mScrolling) {
+      return true;
+    }
+  }
+  return false;
+}
