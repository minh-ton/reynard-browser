+
+  if (@available(iOS 16.0, *)) {
+    return;
+  } else {
+    if (mEditable.mShowingTextStyleOptions && ![self hasSelection]) {
+      [UIMenuController.sharedMenuController hideMenuFromView:self];
+    }
+  }
