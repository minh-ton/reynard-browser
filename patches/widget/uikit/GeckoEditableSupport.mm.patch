+// MARK: - Text Annotations
+
+- (NSMutableAttributedString*)textAnnotations {
+  UITextRange* range =
+      [self textRangeForRange:NSMakeRange(0, [self documentLength])];
+  NSString* text = [self textInRange:range];
+  if (!text) {
+    return nil;
+  }
+
+  if (!mEditable.mTextAnnotations) {
+    mEditable.mTextAnnotations =
+        [[NSMutableAttributedString alloc] initWithString:text];
+    return mEditable.mTextAnnotations;
+  }
+
+  NSString* oldText = mEditable.mTextAnnotations.string;
+  if ([oldText isEqualToString:text]) {
+    return mEditable.mTextAnnotations;
+  }
+
+  // Keep the keyboard's extra info on unchanged text while typing.
+  NSUInteger start = 0;
+  NSUInteger oldEnd = oldText.length;
+  NSUInteger end = text.length;
+  while (start < oldEnd && start < end &&
+         [oldText characterAtIndex:start] == [text characterAtIndex:start]) {
+    ++start;
+  }
+  while (oldEnd > start && end > start &&
+         [oldText characterAtIndex:oldEnd - 1] ==
+             [text characterAtIndex:end - 1]) {
+    --oldEnd;
+    --end;
+  }
+
+  // Clear the keyboard's info for this text if any part was edited.
+  NSUInteger offset = start;
+  while (offset < oldEnd) {
+    NSRange annotatedRange;
+    [mEditable.mTextAnnotations attributesAtIndex:offset
+                                   effectiveRange:&annotatedRange];
+    [mEditable.mTextAnnotations setAttributes:@{} range:annotatedRange];
+    offset = NSMaxRange(annotatedRange);
+  }
+
+  NSAttributedString* replacement = [[[NSAttributedString alloc]
+      initWithString:[text substringWithRange:NSMakeRange(start, end - start)]]
+      autorelease];
+  [mEditable.mTextAnnotations
+      replaceCharactersInRange:NSMakeRange(start, oldEnd - start)
+          withAttributedString:replacement];
+  return mEditable.mTextAnnotations;
+}
+
+- (void)clearTextAnnotations {
+  [mEditable.mTextAnnotations release];
+  mEditable.mTextAnnotations = nil;
+}
+
+- (void)setTextAnnotations:(NSAttributedString*)aText inRange:(NSRange)aRange {
+  NSMutableAttributedString* annotations = [self textAnnotations];
+  if (!annotations || aRange.location == NSNotFound ||
+      aRange.location > annotations.length) {
+    return;
+  }
+
+  if (aRange.length > annotations.length - aRange.location ||
+      aRange.length != aText.length) {
+    return;
+  }
+
+  NSString* text = [annotations.string substringWithRange:aRange];
+  if ([text isEqualToString:aText.string]) {
+    // Keep the keyboard's extra info here without adding it to the DOM.
+    [annotations replaceCharactersInRange:aRange withAttributedString:aText];
+  }
+}
+
+- (NSAttributedString*)attributedTextInRange:(UITextRange*)aRange {
+  NSRange range = [self rangeForTextRange:aRange];
+  NSMutableAttributedString* annotations = [self textAnnotations];
+  if (!annotations || range.location == NSNotFound ||
+      range.location > annotations.length) {
+    return nil;
+  }
+
+  if (range.length > annotations.length - range.location) {
+    return nil;
+  }
+
+  return [annotations attributedSubstringFromRange:range];
+}
+
