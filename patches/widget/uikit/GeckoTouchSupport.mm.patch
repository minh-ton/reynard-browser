+#import "GeckoTouchSupport.h"
+
+#import <objc/message.h>
+
+#include "GeckoEditableSupport.h"
+#include "GeckoPencilSupport.h"
+#include "GeckoPointerSupport.h"
+#include "InputData.h"
+#include "TouchResampler.h"
+#include "gfxPlatform.h"
+#include "nsThreadUtils.h"
+#include "nsWindow.h"
+
+#include "mozilla/TouchEvents.h"
+#include "mozilla/VsyncDispatcher.h"
+
+using namespace mozilla;
+using namespace mozilla::widget;
+using mozilla::dom::Touch;
+
+@interface ChildView : UIView {
+ @public
+  nsWindow* mGeckoChild;
+  GeckoEditableState mEditable;
+  GeckoPencilSupport* mPencilSupport;
+  GeckoTouchSupport* mTouchSupport;
+}
+- (void)setSelectionHandlesVisible:(BOOL)visible;
+- (void)resolveCaretMenuIfPending;
+@end
+
+@interface GeckoTouchSupport ()
+- (NSSet<UITouch*>*)directTouchesFromTouches:(NSSet<UITouch*>*)touches;
+- (NSSet<UITouch*>*)indirectPointerTouchesFromTouches:(NSSet<UITouch*>*)touches;
+- (void)sendTouchEvent:(EventMessage)type
+               touches:(NSSet<UITouch*>*)touches
+             withEvent:(UIEvent*)uiEvent;
+- (void)consumeTouchEvents;
+- (void)notifyFrame:(TimeStamp)timestamp;
+- (void)stopVsyncObserver;
+- (void)touchesBegan:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event;
+- (void)touchesCancelled:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event;
+- (void)touchesEnded:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event;
+- (void)touchesMoved:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event;
+@end
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wunguarded-availability-new"
+
+static bool SupportsPointerInput() {
+  NSOperatingSystemVersion version = {13, 4, 0};
+  return [NSProcessInfo.processInfo isOperatingSystemAtLeastVersion:version];
+}
+
+static TimeStamp GeckoTimeStampForUIKitTimestamp(NSTimeInterval aTimestamp) {
+  NSTimeInterval age = NSProcessInfo.processInfo.systemUptime - aTimestamp;
+  return TimeStamp::Now() - TimeDuration::FromSeconds(age);
+}
+
+static bool IsIndirectPointerTouch(UITouch* aTouch) {
+  return SupportsPointerInput() && aTouch.type == UITouchTypeIndirectPointer;
+}
+
+#pragma clang diagnostic pop
+
+class GeckoTouchVsyncObserver final : public VsyncObserver {
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(GeckoTouchVsyncObserver, override)
+
+ public:
+  explicit GeckoTouchVsyncObserver(GeckoTouchSupport* aTouchSupport)
+      : mTouchSupport(aTouchSupport) {}
+
+  void NotifyVsync(const VsyncEvent& aVsync) override {
+    MOZ_ASSERT(NS_IsMainThread());
+    GeckoTouchSupport* touchSupport = [mTouchSupport retain];
+    [touchSupport notifyFrame:aVsync.mTime];
+    [touchSupport release];
+  }
+
+  void ClearOwner() {
+    MOZ_ASSERT(NS_IsMainThread());
+    mTouchSupport = nil;
+  }
+
+ private:
+  ~GeckoTouchVsyncObserver() = default;
+
+  GeckoTouchSupport* mTouchSupport;  // Main thread only.
+};
+
+@implementation GeckoTouchSupport {
+  ChildView* mView;
+  nsWindow* mGeckoChild;
+  GeckoPointerSupport* mPointerSupport;
+  GeckoPencilSupport* mPencilSupport;
+  id<GeckoViewInteractionDelegate> mInteractionDelegate;
+  NSMapTable<UITouch*, NSNumber*>* mTouches;
+  int mNextTouchID;
+  uint64_t mTouchSequenceID;
+  TouchResampler mTouchResampler;
+  RefPtr<VsyncDispatcher> mVsyncDispatcher;
+  RefPtr<GeckoTouchVsyncObserver> mVsyncObserver;
+}
+
+- (instancetype)initWithView:(ChildView*)view
+                  geckoChild:(nsWindow*)geckoChild
+              pointerSupport:(GeckoPointerSupport*)pointerSupport
+               pencilSupport:(GeckoPencilSupport*)pencilSupport {
+  self = [super init];
+  if (!self) {
+    return nil;
+  }
+
+  mView = view;
+  mGeckoChild = geckoChild;
+  mPointerSupport = pointerSupport;
+  mPencilSupport = pencilSupport;
+  mTouches = [[NSMapTable alloc] init];
+  mNextTouchID = 0;
+  return self;
+}
+
+- (void)setInteractionDelegate:
+    (id<GeckoViewInteractionDelegate>)interactionDelegate {
+  mInteractionDelegate = interactionDelegate;
+  [mPencilSupport setInteractionDelegate:interactionDelegate];
+}
+
+- (NSSet<UITouch*>*)directTouchesFromTouches:(NSSet<UITouch*>*)touches {
+  NSMutableSet<UITouch*>* directTouches = [NSMutableSet set];
+  for (UITouch* touch in touches) {
+    if (touch.view != mView) {
+      continue;
+    }
+
+    if (!IsIndirectPointerTouch(touch) && touch.type != UITouchTypePencil) {
+      [directTouches addObject:touch];
+    }
+  }
+  return directTouches;
+}
+
+- (NSSet<UITouch*>*)indirectPointerTouchesFromTouches:
+    (NSSet<UITouch*>*)touches {
+  NSMutableSet<UITouch*>* pointerTouches = [NSMutableSet set];
+  for (UITouch* touch in touches) {
+    if (IsIndirectPointerTouch(touch)) {
+      [pointerTouches addObject:touch];
+    }
+  }
+  return pointerTouches;
+}
+
+- (void)sendTouchEvent:(EventMessage)type
+               touches:(NSSet<UITouch*>*)touches
+             withEvent:(UIEvent*)uiEvent {
+  if (!mGeckoChild) {
+    return;
+  }
+
+  WidgetTouchEvent event(true, type, mGeckoChild);
+  event.mTimeStamp = GeckoTimeStampForUIKitTimestamp(uiEvent.timestamp);
+  event.mTouches.SetCapacity(touches.count);
+
+  for (UITouch* touch in touches) {
+    LayoutDeviceIntPoint location = UIKitPointsToDevPixels(
+        [touch locationInView:mView], mView.contentScaleFactor);
+    LayoutDeviceIntPoint radius = UIKitPointsToDevPixels(
+        CGPointMake(touch.majorRadius, touch.majorRadius),
+        mView.contentScaleFactor);
+    NSNumber* value = [mTouches objectForKey:touch];
+    if (!value) {
+      continue;
+    }
+
+    int id = [value intValue];
+    auto touchPoint = MakeRefPtr<Touch>(id, location, radius, 0.0f, 1.0f);
+    event.mRefPoint = location;
+    event.mTouches.AppendElement(touchPoint);
+  }
+
+  MultiTouchInput input(event);
+  for (UITouch* touch in touches) {
+    NSNumber* value = [mTouches objectForKey:touch];
+    if (!value) {
+      continue;
+    }
+
+    SingleTouchData& touchData =
+        input.mTouches[input.IndexOfTouch(value.intValue)];
+    CGPoint location = [touch locationInView:mView];
+    touchData.mScreenPoint = ScreenPoint(location.x * mView.contentScaleFactor,
+                                         location.y * mView.contentScaleFactor);
+
+    if (type != eTouchMove) {
+      continue;
+    }
+
+    NSArray<UITouch*>* coalescedTouches =
+        [uiEvent coalescedTouchesForTouch:touch];
+
+    for (NSUInteger i = 0; i + 1 < coalescedTouches.count; i++) {
+      UITouch* sample = coalescedTouches[i];
+      CGPoint location = [sample locationInView:mView];
+      LayoutDeviceIntPoint radius = UIKitPointsToDevPixels(
+          CGPointMake(sample.majorRadius, sample.majorRadius),
+          mView.contentScaleFactor);
+      touchData.mHistoricalData.AppendElement(
+          SingleTouchData::HistoricalTouchData{
+              GeckoTimeStampForUIKitTimestamp(sample.timestamp),
+              ScreenPoint(location.x * mView.contentScaleFactor,
+                          location.y * mView.contentScaleFactor),
+              {},  // mLocalScreenPoint will be computed later by APZ
+              ScreenSize(float(radius.x), float(radius.y)),
+              0.0f,
+              1.0f});
+    }
+  }
+
+  if (input.mTouches.IsEmpty()) {
+    return;
+  }
+
+  if (type == eTouchCancel) {
+    // Gecko cancels the whole gesture, including fingers still down in UIKit.
+    [mTouches removeAllObjects];
+    mNextTouchID = 0;
+  }
+
+  mTouchResampler.ProcessEvent(std::move(input));
+  if (mTouchResampler.InTouchingState() && !mVsyncObserver) {
+    mVsyncObserver = new GeckoTouchVsyncObserver(self);
+    mVsyncDispatcher = gfxPlatform::GetPlatform()->GetGlobalVsyncDispatcher();
+    mVsyncDispatcher->AddInputObserver(mVsyncObserver);
+  }
+  [self consumeTouchEvents];
+
+  if (!mTouchResampler.InTouchingState()) {
+    [self stopVsyncObserver];
+  }
+}
+
+- (void)consumeTouchEvents {
+  auto outgoing = mTouchResampler.ConsumeOutgoingEvents();
+  while (!outgoing.empty() && mGeckoChild) {
+    MultiTouchInput input = std::move(outgoing.front().mEvent);
+    outgoing.pop();
+    if (input.mType == MultiTouchInput::MULTITOUCH_START) {
+      mGeckoChild->DispatchTouchStart(input, mTouchSequenceID);
+    } else {
+      mGeckoChild->DispatchTouchInput(input);
+    }
+  }
+}
+
+- (void)notifyFrame:(TimeStamp)timestamp {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // Sample slightly in the past to account for delayed touch delivery.
+  mTouchResampler.NotifyFrame(timestamp - TimeDuration::FromMilliseconds(5));
+  [self consumeTouchEvents];
+}
+
+- (void)stopVsyncObserver {
+  if (mVsyncObserver) {
+    mVsyncObserver->ClearOwner();
+    mVsyncDispatcher->RemoveInputObserver(mVsyncObserver);
+    mVsyncObserver = nullptr;
+    mVsyncDispatcher = nullptr;
+  }
+}
+
+- (void)touchesBegan:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+  [mPencilSupport touchesBegan:[mPencilSupport pencilTouchesFromTouches:touches]
+                     withEvent:event];
+  [mPointerSupport
+      handlePointerInputBegan:[self indirectPointerTouchesFromTouches:touches]
+                    withEvent:event];
+
+  NSSet<UITouch*>* directTouches = [self directTouchesFromTouches:touches];
+  if (directTouches.count == 0 || !mGeckoChild) {
+    return;
+  }
+
+  if (mTouches.count == 0) {
+    [mInteractionDelegate touchSequenceDidBegin:++mTouchSequenceID];
+  }
+  for (UITouch* touch in directTouches) {
+    [mTouches setObject:[NSNumber numberWithInt:mNextTouchID++] forKey:touch];
+  }
+  [self sendTouchEvent:eTouchStart
+               touches:[self directTouchesFromTouches:event.allTouches]
+             withEvent:event];
+}
+
+- (void)touchesCancelled:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+  [mPencilSupport
+      touchesCancelled:[mPencilSupport pencilTouchesFromTouches:touches]
+             withEvent:event];
+  [mPointerSupport handlePointerInputCancelled:
+                       [self indirectPointerTouchesFromTouches:touches]];
+
+  NSSet<UITouch*>* directTouches = [self directTouchesFromTouches:touches];
+  if (directTouches.count == 0 || !mGeckoChild) {
+    return;
+  }
+
+  NSSet<UITouch*>* activeTouches =
+      [NSSet setWithArray:mTouches.keyEnumerator.allObjects];
+  if (![activeTouches intersectsSet:directTouches]) {
+    return;
+  }
+
+  const uint64_t sequenceID = mTouchSequenceID;
+  [self sendTouchEvent:eTouchCancel touches:activeTouches withEvent:event];
+  [mInteractionDelegate touchSequenceDidEnd:sequenceID];
+}
+
+- (void)touchesEnded:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+  [mPencilSupport touchesEnded:[mPencilSupport pencilTouchesFromTouches:touches]
+                     withEvent:event];
+  [mPointerSupport
+      handlePointerInputEnded:[self indirectPointerTouchesFromTouches:touches]
+                    withEvent:event];
+
+  NSSet<UITouch*>* directTouches = [self directTouchesFromTouches:touches];
+  if (directTouches.count == 0 || !mGeckoChild || mTouches.count == 0) {
+    return;
+  }
+
+  [self sendTouchEvent:eTouchEnd touches:directTouches withEvent:event];
+  for (UITouch* touch in directTouches) {
+    [mTouches removeObjectForKey:touch];
+  }
+  if (mTouches.count == 0) {
+    mNextTouchID = 0;
+    [mInteractionDelegate touchSequenceDidEnd:mTouchSequenceID];
+  }
+}
+
+- (void)touchesMoved:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+  [mPencilSupport touchesMoved:[mPencilSupport pencilTouchesFromTouches:touches]
+                     withEvent:event];
+  [mPointerSupport
+      handlePointerInputMoved:[self indirectPointerTouchesFromTouches:touches]
+                    withEvent:event];
+
+  NSSet<UITouch*>* directTouches =
+      [self directTouchesFromTouches:event.allTouches];
+  if (directTouches.count == 0 || !mGeckoChild) {
+    return;
+  }
+
+  [self sendTouchEvent:eTouchMove touches:directTouches withEvent:event];
+}
+
+- (void)resolveTouchSequence:(uint64_t)sequenceId
+                    handling:(GeckoInputHandling)handling
+             scrollableEdges:(GeckoScrollableEdges)scrollableEdges
+              overscrollAxes:(GeckoOverscrollAxes)overscrollAxes {
+  if ([mPencilSupport resolveTouchSequence:sequenceId
+                                  handling:handling
+                           scrollableEdges:scrollableEdges
+                            overscrollAxes:overscrollAxes]) {
+    return;
+  }
+  if (sequenceId != mTouchSequenceID || mTouches.count == 0) {
+    return;
+  }
+
+  [mInteractionDelegate touchSequence:sequenceId
+                   didResolveHandling:handling
+                      scrollableEdges:scrollableEdges
+                       overscrollAxes:overscrollAxes];
+}
+
+- (void)compositorScrollPositionDidChange:(double)scrollY zoom:(double)zoom {
+  [mInteractionDelegate compositorScrollPositionDidChange:scrollY zoom:zoom];
+}
+
+- (void)widgetDestroyed {
+  [self stopVsyncObserver];
+  mTouchResampler = TouchResampler();
+  mGeckoChild = nullptr;
+  mInteractionDelegate = nil;
+  mNextTouchID = 0;
+  [mTouches release];
+  mTouches = nil;
+}
+
+- (void)dealloc {
+  [self stopVsyncObserver];
+  [mTouches release];
+  mView = nil;
+  mPointerSupport = nil;
+  mPencilSupport = nil;
+  [super dealloc];
+}
+
+@end
+
+// MARK: - ChildView (Touch)
+
+@implementation ChildView (Touch)
+
+- (void)touchesBegan:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+  BOOL hasDirectTouch = NO;
+  for (UITouch* touch in touches) {
+    if (touch.type == UITouchTypeDirect) {
+      hasDirectTouch = YES;
+      break;
+    }
+  }
+
+  BOOL hasPrimaryPointerPress = NO;
+  if ([event respondsToSelector:@selector(buttonMask)]) {
+    UIEventButtonMask buttonMask =
+        reinterpret_cast<UIEventButtonMask (*)(id, SEL)>(objc_msgSend)(
+            event, @selector(buttonMask));
+    hasPrimaryPointerPress = buttonMask & 1;
+  }
+
+  // The page may keep its hidden input focused after the keyboard is dismissed.
+  if ((hasDirectTouch || hasPrimaryPointerPress) && !self.isFirstResponder) {
+    [self becomeFirstResponder];
+  }
+
+  if (touches.count > 0) {
+    BOOL hasPencilTouch =
+        [mPencilSupport pencilTouchesFromTouches:touches].count > 0;
+    [self setSelectionHandlesVisible:hasDirectTouch || hasPencilTouch];
+  }
+
+  [super touchesBegan:touches withEvent:event];
+
+  if (mGeckoChild) {
+    [mTouchSupport touchesBegan:touches withEvent:event];
+  }
+}
+
+- (void)touchesCancelled:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+  [super touchesCancelled:touches withEvent:event];
+  [mTouchSupport touchesCancelled:touches withEvent:event];
+}
+
+- (void)touchesEnded:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+  [super touchesEnded:touches withEvent:event];
+  if (!mGeckoChild) {
+    return;
+  }
+  [mTouchSupport touchesEnded:touches withEvent:event];
+}
+
+- (void)touchesMoved:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+  [super touchesMoved:touches withEvent:event];
+  if (!mGeckoChild) {
+    return;
+  }
+  [mTouchSupport touchesMoved:touches withEvent:event];
+}
+
+@end
