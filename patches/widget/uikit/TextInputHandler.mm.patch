+bool TextInputHandler::DispatchCurrentKeyDown(bool aProcessedByIME) {
+  KeyEventState* currentKeyEvent = CurrentKeyEvent();
+  if (!currentKeyEvent || currentKeyEvent->mKeyDownDispatched) {
+    return currentKeyEvent && !currentKeyEvent->mKeyDownHandled;
+  }
+  if (Destroyed()) {
+    return false;
+  }
+
+  nsresult rv = mDispatcher->BeginNativeInputTransaction();
+  if (NS_FAILED(rv)) {
+    currentKeyEvent->mGeckoTransactionFailed = true;
+    return false;
+  }
+
+  WidgetKeyboardEvent keydownEvent(true, eKeyDown, mWidget);
+  mKeyboardSupport->InitKeyEvent(currentKeyEvent->mEvent, keydownEvent,
+                                 currentKeyEvent->mUniqueId, aProcessedByIME,
+                                 nullptr, currentKeyEvent->mForceRepeat);
+  if (currentKeyEvent->mForceRepeat) {
+    keydownEvent.mModifiers = mKeyboardSupport->CurrentModifiers();
+  }
+  nsEventStatus status = nsEventStatus_eIgnore;
+  currentKeyEvent->mKeyDownDispatched = mDispatcher->DispatchKeyboardEvent(
+      eKeyDown, keydownEvent, status, currentKeyEvent);
+  if (!currentKeyEvent->mKeyDownDispatched) {
+    currentKeyEvent->mGeckoTransactionFailed = true;
+  }
+  currentKeyEvent->mKeyDownHandled = status == nsEventStatus_eConsumeNoDefault;
+  return currentKeyEvent->mKeyDownDispatched &&
+         !currentKeyEvent->mKeyDownHandled && !Destroyed();
+}
+
+bool TextInputHandler::DispatchCurrentKeyPress() {
+  KeyEventState* currentKeyEvent = CurrentKeyEvent();
+  if (!currentKeyEvent || currentKeyEvent->mKeyPressDispatched ||
+      currentKeyEvent->mKeyDownHandled ||
+      currentKeyEvent->mInputMethodHandled ||
+      currentKeyEvent->mCompositionDispatched || Destroyed()) {
+    return false;
+  }
+
+  nsresult rv = mDispatcher->BeginNativeInputTransaction();
+  if (NS_FAILED(rv)) {
+    currentKeyEvent->mGeckoTransactionFailed = true;
+    return false;
+  }
+
+  WidgetKeyboardEvent keypressEvent(true, eKeyPress, mWidget);
+  const nsAString* insertString = currentKeyEvent->mInsertString.IsEmpty()
+                                      ? nullptr
+                                      : &currentKeyEvent->mInsertString;
+  mKeyboardSupport->InitKeyEvent(currentKeyEvent->mEvent, keypressEvent,
+                                 currentKeyEvent->mUniqueId, false,
+                                 insertString, currentKeyEvent->mForceRepeat);
+  if (currentKeyEvent->mForceRepeat) {
+    keypressEvent.mModifiers = mKeyboardSupport->CurrentModifiers();
+  }
+  nsEventStatus status = nsEventStatus_eIgnore;
+  currentKeyEvent->mKeyPressDispatched =
+      mDispatcher->MaybeDispatchKeypressEvents(keypressEvent, status,
+                                               currentKeyEvent, true);
+  currentKeyEvent->mKeyPressHandled = status == nsEventStatus_eConsumeNoDefault;
+  return currentKeyEvent->mKeyPressDispatched;
+}
+
+bool TextInputHandler::PrepareCurrentKeyForIME() {
+  KeyEventState* currentKeyEvent = CurrentKeyEvent();
+  if (!currentKeyEvent) {
+    return true;
+  }
+  bool shouldContinue = DispatchCurrentKeyDown(true);
+  if (currentKeyEvent->mGeckoTransactionFailed) {
+    return false;
+  }
+  currentKeyEvent->mInputMethodHandled = true;
+  return shouldContinue && !currentKeyEvent->mKeyPressPreventedByContent;
+}
+
+void TextInputHandler::MarkCurrentKeyEventFailed() {
+  if (KeyEventState* currentKeyEvent = CurrentKeyEvent()) {
+    currentKeyEvent->mGeckoTransactionFailed = true;
+  }
+}
