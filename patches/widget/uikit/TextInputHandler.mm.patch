+bool TextInputHandler::GetEditCommands(const WidgetKeyboardEvent& aEvent,
+                                       nsTArray<CommandInt>& aCommands) {
+  KeyEventState* currentKeyEvent = CurrentKeyEvent();
+  if (!currentKeyEvent || !currentKeyEvent->mCommand ||
+      currentKeyEvent->mUniqueId != aEvent.mUniqueId) {
+    return true;
+  }
+  aCommands.AppendElement(
+      static_cast<CommandInt>(currentKeyEvent->mCommand.value()));
+  return true;
+}
 
 nsresult TextInputHandler::NotifyIME(TextEventDispatcher* aTextEventDispatcher,
                                      const IMENotification& aNotification) {
+  if (Destroyed() || aTextEventDispatcher != mDispatcher) {
+    return NS_OK;
+  }
+
+  switch (aNotification.mMessage) {
+    case REQUEST_TO_COMMIT_COMPOSITION:
+      UnmarkText();
+      break;
+    case REQUEST_TO_CANCEL_COMPOSITION:
+      CancelMarkedText();
+      break;
+    case NOTIFY_IME_OF_BLUR:
+      ClearCompositionState();
+      [[fallthrough]];
+    case NOTIFY_IME_OF_FOCUS:
+      mNativeTextInputState.reset();
+      InvalidateTextInputState(true);
+      [static_cast<ChildView*>(mWidget->GetNativeData(NS_NATIVE_WIDGET))
+          clearTextAnnotations];
+      [[fallthrough]];
+    case NOTIFY_IME_OF_TEXT_CHANGE:
+    case NOTIFY_IME_OF_SELECTION_CHANGE:
+    case NOTIFY_IME_OF_POSITION_CHANGE: {
+      if (aNotification.mMessage == NOTIFY_IME_OF_POSITION_CHANGE) {
+        InvalidateTextInputGeometry();
+      } else if (aNotification.mMessage == NOTIFY_IME_OF_TEXT_CHANGE ||
+                 aNotification.mMessage == NOTIFY_IME_OF_SELECTION_CHANGE) {
+        InvalidateTextInputState();
+      }
+      ChildView* view =
+          static_cast<ChildView*>(mWidget->GetNativeData(NS_NATIVE_WIDGET));
+      if (view) {
+        [view selectionGeometryChanged];
+      }
+      break;
+    }
+    default:
+      break;
+  }
+
   return NS_OK;
 }
 
