+bool TextInputHandler::DispatchPhysicalKeyDown(WebEvent* aEvent,
+                                               bool aForceRepeat,
+                                               bool aHasCurrentNativeEvent,
+                                               Maybe<Command>& aCommand) {
+  if (Destroyed()) {
+    return false;
+  }
+
+  RefPtr<nsWindow> widget(mWidget);
+  auto state = MakeUnique<KeyEventState>(
+      aEvent, mKeyboardSupport->NextUniqueId(), aForceRepeat);
+  KeyEventState* currentKeyEvent = state.get();
+  mCurrentKeyEvents.AppendElement(std::move(state));
+
+  const bool useInputMethod = aHasCurrentNativeEvent &&
+                              widget->GetInputContext().mIMEState.IsEditable();
+  const bool hasShiftModifier =
+      mKeyboardSupport->CurrentModifiers() & MODIFIER_SHIFT;
+  UIKeyboardImpl* keyboard = nil;
+  if (useInputMethod) {
+    Class keyboardClass = NSClassFromString(@"UIKeyboardImpl");
+    MOZ_RELEASE_ASSERT(keyboardClass);
+    keyboard = [keyboardClass sharedInstance];
+    MOZ_RELEASE_ASSERT(keyboard);
+    if (!hasShiftModifier) {
+      currentKeyEvent->mInterpretingInputMethod = true;
+      const bool inputMethodHandled =
+          [keyboard handleKeyInputMethodCommandForCurrentEvent];
+      currentKeyEvent->mInterpretingInputMethod = false;
+      currentKeyEvent->mInputMethodHandled |= inputMethodHandled;
+    }
+  }
+
+  if (!currentKeyEvent->mKeyDownDispatched && !Destroyed()) {
+    DispatchCurrentKeyDown(currentKeyEvent->mInputMethodHandled);
+  }
+
+  auto dispatchInput = [&] {
+    if (currentKeyEvent->mInputMethodHandled ||
+        currentKeyEvent->mCompositionDispatched) {
+      return;
+    }
+
+    if (currentKeyEvent->mKeyPressPreventedByContent ||
+        currentKeyEvent->mGeckoTransactionFailed) {
+      return;
+    }
+
+    if (hasShiftModifier ||
+        (aEvent.modifierFlags & WebEventFlagMaskCommandKey)) {
+      return;
+    }
+
+    NSString* characters = aEvent.characters;
+    if (!characters.length) {
+      return;
+    }
+
+    switch ([characters characterAtIndex:0]) {
+      case kBackspaceCharacter:
+      case kDeleteCharacter:
+        [keyboard deleteFromInputWithFlags:aEvent.keyboardFlags];
+        currentKeyEvent->mInputMethodHandled = true;
+        break;
+      case kEnterCharacter:
+      case kCarriageReturnCharacter:
+      case kNewlineCharacter:
+        if (IsCharacterKeyEvent(aEvent)) {
+          [keyboard addInputString:@"\n" withFlags:0 withInputManagerHint:nil];
+          currentKeyEvent->mInputMethodHandled = true;
+        }
+        break;
+      default:
+        if (IsCharacterKeyEvent(aEvent)) {
+          [keyboard addInputString:characters
+                         withFlags:aEvent.keyboardFlags
+              withInputManagerHint:aEvent.inputManagerHint];
+          currentKeyEvent->mInputMethodHandled = true;
+        }
+        break;
+    }
+  };
+
+  auto canDispatchKeyInput = [&] {
+    if (currentKeyEvent->mInputMethodHandled ||
+        currentKeyEvent->mCompositionDispatched) {
+      return false;
+    }
+
+    return !currentKeyEvent->mKeyDownHandled && !Destroyed();
+  };
+
+  if (aForceRepeat && aCommand && canDispatchKeyInput()) {
+    if (widget->GetInputContext().mIMEState.IsEditable()) {
+      HandleCommand(aCommand.value());
+    }
+  }
+
+  if (useInputMethod &&
+      !(aEvent.keyboardFlags & WebEventKeyboardInputModifierFlagsChanged) &&
+      canDispatchKeyInput()) {
+    const bool isCharacterEvent = IsCharacterKeyEvent(aEvent);
+    if (!isCharacterEvent) {
+      currentKeyEvent->mInputMethodHandled |=
+          [keyboard handleKeyTextCommandForCurrentEvent];
+    }
+
+    if (isCharacterEvent && !hasShiftModifier &&
+        !currentKeyEvent->mGeckoTransactionFailed && canDispatchKeyInput()) {
+      currentKeyEvent->mInputMethodHandled |=
+          [keyboard handleKeyAppCommandForCurrentEvent];
+    }
+
+    dispatchInput();
+  }
+
+  if (canDispatchKeyInput()) {
+    DispatchCurrentKeyPress();
+  }
+
+  const bool dispatched = currentKeyEvent->mKeyDownDispatched ||
+                          currentKeyEvent->mKeyPressDispatched ||
+                          currentKeyEvent->mInputMethodHandled ||
+                          currentKeyEvent->mCompositionDispatched;
+  const bool handled =
+      !currentKeyEvent->mGeckoTransactionFailed && !Destroyed() && dispatched;
+  aCommand = currentKeyEvent->mCommand;
+  MOZ_ASSERT(mCurrentKeyEvents.LastElement().get() == currentKeyEvent);
+  mCurrentKeyEvents.RemoveLastElement();
+  return handled;
+}
