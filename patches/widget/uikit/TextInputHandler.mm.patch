+        mForceRepeat(aForceRepeat) {}
+
+  ~KeyEventState() { [mEvent release]; }
+
+  WebEvent* mEvent;
+  nsString mInsertString;
+  uint32_t mUniqueId;
+  bool mForceRepeat;
+  bool mKeyDownDispatched = false;
+  bool mKeyDownHandled = false;
+  bool mKeyPressDispatched = false;
+  bool mKeyPressHandled = false;
+  bool mKeyPressPreventedByContent = false;
+  bool mInputMethodHandled = false;
+  bool mInterpretingInputMethod = false;
+  bool mCompositionDispatched = false;
+  bool mGeckoTransactionFailed = false;
+  Maybe<Command> mCommand;
