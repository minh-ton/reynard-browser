+enum : unichar {
+  kEnterCharacter = 0x03,
+  kBackspaceCharacter = 0x08,
+  kNewlineCharacter = 0x0A,
+  kCarriageReturnCharacter = 0x0D,
+  kDeleteCharacter = 0x7F,
+};
