+MOZ_CAN_RUN_SCRIPT_BOUNDARY nsresult nsDocShell::MaybeHandlePreNavigation(
+    nsIURI* aURI, uint32_t aLoadFlags, uint32_t aLoadType,
+    nsIPrincipal* aTriggeringPrincipal, bool aHasValidUserGestureActivation,
+    bool aBrowserUIActivation) {
+  if (!mBrowsingContext->IsTopContent() || !aURI ||
+      !(aURI->SchemeIs("http") || aURI->SchemeIs("https"))) {
+    return NS_OK;
+  }
+
+  const bool isLinkNavigation =
+      LOAD_TYPE_HAS_FLAGS(aLoadType, nsIWebNavigation::LOAD_FLAGS_IS_LINK);
+  const bool isHistoryOrReload =
+      (aLoadType &
+       (nsIDocShell::LOAD_CMD_RELOAD | nsIDocShell::LOAD_CMD_HISTORY |
+        nsIDocShell::LOAD_CMD_PUSHSTATE)) != 0;
+  const bool isBrowserUI =
+      aBrowserUIActivation ||
+      (aLoadFlags & nsIWebNavigation::LOAD_FLAGS_FROM_EXTERNAL);
+  const bool isUserInitiatedNavigation =
+      isLinkNavigation && !isHistoryOrReload && !isBrowserUI &&
+      aTriggeringPrincipal && !aTriggeringPrincipal->IsSystemPrincipal() &&
+      aHasValidUserGestureActivation;
+
+  nsCOMPtr<nsILoadURIDelegate> loadURIDelegate = GetLoadURIDelegate();
+  if (!loadURIDelegate) {
+    return NS_OK;
+  }
+
+  bool handled = false;
+  MOZ_TRY(loadURIDelegate->PreNavigation(aURI, aLoadFlags, aTriggeringPrincipal,
+                                         aHasValidUserGestureActivation,
+                                         isUserInitiatedNavigation, &handled));
+  return handled ? NS_ERROR_ABORT : NS_OK;
+}
