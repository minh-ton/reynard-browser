+void CanonicalBrowsingContext::AdoptPreview(CanonicalBrowsingContext& aPreview,
+                                            ErrorResult& aRv) {
+  RefPtr<Element> owner = GetEmbedderElement();
+  RefPtr<Element> previewElement = aPreview.GetEmbedderElement();
+  nsCOMPtr<nsFrameLoaderOwner> previewOwner = do_QueryInterface(previewElement);
+  RefPtr<nsFrameLoader> frameLoader =
+      previewOwner ? previewOwner->GetFrameLoader() : nullptr;
+  RefPtr<nsSHistory> shistory = static_cast<nsSHistory*>(GetSessionHistory());
+  RefPtr<SessionHistoryEntry> entry = aPreview.GetActiveSessionHistoryEntry();
+
+  bool areTopLevel = IsTop() && aPreview.IsTop() && &aPreview != this;
+  bool hasRemotePreview = frameLoader && frameLoader->GetBrowserParent();
+  bool hasCommittedPreview = entry && aPreview.mLoadingEntries.IsEmpty();
+  bool sharesStorage = OriginAttributesRef() == aPreview.OriginAttributesRef();
+  if (!mozilla::BFCacheInParent() || !areTopLevel || !owner || !shistory ||
+      !hasRemotePreview || !hasCommittedPreview || !sharesStorage) {
+    aRv.Throw(NS_ERROR_INVALID_ARG);
+    return;
+  }
+
+  aPreview.DeactivateDocuments();
+
+  previewOwner->SetFrameLoader(nullptr);
+  if (nsSubDocumentFrame* previewFrame =
+          do_QueryFrame(previewElement->GetPrimaryFrame())) {
+    previewFrame->ResetFrameLoader(nsSubDocumentFrame::RetainPaintData::No);
+  }
+  frameLoader->MoveToOwner(owner);
+
+  aPreview.mSessionHistory = nullptr;
+  aPreview.mWebProgress = nullptr;
+  RefPtr<ChildSHistory> previewChildSHistory = aPreview.ForgetChildSHistory();
+
+  // AddEntry makes the new entry current.
+  entry->SetShistory(nullptr);
+  aRv = shistory->AddEntry(entry);
+  if (aRv.Failed()) {
+    return;
+  }
+  int32_t index = shistory->Index();
+  shistory->InternalSetRequestedIndex(index - 1);
+  shistory->UpdateIndex();
+
+  entry->SetFrameLoader(frameLoader);
+  nsTArray<nsSHistory::LoadEntryResult> loadResults;
+  aRv = shistory->GotoIndex(/* aSourceBrowsingContext */ nullptr, index,
+                            loadResults, /* aSameEpoch */ false,
+                            /* aLoadCurrentEntry */ false,
+                            /* aUserActivation */ true);
+  if (aRv.Failed()) {
+    return;
+  }
+
+  for (const nsSHistory::LoadEntryResult& loadResult : loadResults) {
+    loadResult.mLoadState->SetNotifiedBeforeUnloadListeners(true);
+  }
+  nsSHistory::LoadURIs(loadResults, /* aCheckForCancelation */ false);
+}
