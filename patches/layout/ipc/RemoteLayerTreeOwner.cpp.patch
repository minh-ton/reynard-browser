diff --git a/layout/ipc/RemoteLayerTreeOwner.cpp b/layout/ipc/RemoteLayerTreeOwner.cpp
index 577c9aa49ab6..27c6230bc744 100644
--- a/layout/ipc/RemoteLayerTreeOwner.cpp
+++ b/layout/ipc/RemoteLayerTreeOwner.cpp
@@ -116,14 +116,34 @@ void RemoteLayerTreeOwner::Destroy() {
 void RemoteLayerTreeOwner::EnsureLayersConnected(
     Maybe<CompositorOptions>& aCompositorOptions) {
   RefPtr<WindowRenderer> renderer = GetWindowRenderer(mBrowserParent);
-  if (!renderer || !renderer->GetCompositorBridgeChild()) {
+  PCompositorBridgeChild* compositor =
+      renderer ? renderer->GetCompositorBridgeChild() : nullptr;
+  if (!compositor) {
+    aCompositorOptions = Nothing();
+    return;
+  }
+
+  // Do not report compositor options on failed reconnect attempts.
+  // I found out that BrowserChild::ReinitRendering weirdly treats options
+  // presence as success.
+  mLayersConnected = compositor->SendNotifyChildRecreated(
+      mLayersId, GetEmbedderLayersId(mBrowserParent), &mCompositorOptions);
+  if (!mLayersConnected) {
+    aCompositorOptions = Nothing();
+    return;
+  }
+
+  //  During GPU/compositor recovery, ensure the recreated child
+  // layertree is readopted onto the current root compositor. Without this,
+  // display lists can flow to the child pipeline while composition targets a
+  // new root pipeline that has no display list yet.
+  if (!compositor->SendAdoptChild(mLayersId,
+                                  GetEmbedderLayersId(mBrowserParent))) {
+    mLayersConnected = false;
     aCompositorOptions = Nothing();
     return;
   }
 
-  mLayersConnected =
-      renderer->GetCompositorBridgeChild()->SendNotifyChildRecreated(
-          mLayersId, GetEmbedderLayersId(mBrowserParent), &mCompositorOptions);
   LAYERTREE_LOG("Layer tree {:x} reconnected {}", mLayersId, mLayersConnected);
   aCompositorOptions = Some(mCompositorOptions);
 }
