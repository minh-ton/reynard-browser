+#if defined(XP_IOS)
+static bool IsInNativeTextSelectionContext(const nsIFrame* aFrame) {
+  nsIContent* content = aFrame->GetContent();
+  if (!content) {
+    return false;
+  }
+
+  nsIContent* control =
+      content->IsInNativeAnonymousSubtree()
+          ? content->GetClosestNativeAnonymousSubtreeRootParentOrHost()
+          : content;
+  if (auto* textControl = TextControlElement::FromNodeOrNull(control)) {
+    return textControl->IsSingleLineTextControlOrTextArea() &&
+           !textControl->IsDisabled();
+  }
+
+  return content->GetInclusiveEditableAncestor() != nullptr;
+}
+#endif
