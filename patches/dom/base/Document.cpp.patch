@@ -17385,9 +17385,29 @@ void Document::AddPendingFullscreenEvent(
 // https://fullscreen.spec.whatwg.org/#run-the-fullscreen-steps
 void Document::RunFullscreenSteps() {
   auto events = std::move(mPendingFullscreenEvents);
+#ifdef MOZ_WIDGET_UIKIT
+  const bool hasFullscreenChange = std::any_of(
+      events.cbegin(), events.cend(), [](const auto& aEvent) {
+        return aEvent->Type() == FullscreenEventType::Change;
+      });
+#endif
   for (auto& event : events) {
     event->Dispatch(this);
   }
+#ifdef MOZ_WIDGET_UIKIT
+  if (hasFullscreenChange) {
+    // UIKit resizes the viewport before fullscreenchange, while Android's
+    // immersive layout also produces a resize after the transition.
+    RefPtr<PresShell> presShell = GetPresShell();
+    NS_DispatchToCurrentThread(NS_NewRunnableFunction(
+        "Document::ScheduleUIKitFullscreenResizeEvent",
+        [presShell = std::move(presShell)]() {
+          if (presShell) {
+            presShell->ScheduleResizeEventIfNeeded();
+          }
+        }));
+  }
+#endif
 }
 
