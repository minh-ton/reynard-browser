+mozilla::ipc::IPCResult BrowserChild::RecvQueryNativeTextInput(
+    const NativeTextInputRequest& aRequest, NativeTextInputReply* aReply) {
+  RefPtr<Document> document = GetTopLevelDocument();
+  nsCOMPtr<nsPIDOMWindowOuter> focusedWindow;
+  if (document) {
+    nsFocusManager::GetFocusedDescendant(document->GetWindow(),
+                                         nsFocusManager::eIncludeAllDescendants,
+                                         getter_AddRefs(focusedWindow));
+    if (focusedWindow && focusedWindow->GetDoc()) {
+      document = focusedWindow->GetDoc();
+    }
+  }
+
+  RefPtr<PresShell> shell = document ? document->GetPresShell() : nullptr;
+  if (shell && shell->GetPresContext()) {
+    ContentEventHandler handler(shell->GetPresContext());
+    if (NS_FAILED(handler.QueryNativeTextInput(aRequest, *aReply))) {
+      *aReply = NativeTextInputReply();
+    }
+  }
+
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult BrowserChild::RecvStartNativeTextDrag(
+    const LayoutDeviceIntPoint& aPoint,
+    StartNativeTextDragResolver&& aResolve) {
+  NativeTextInputRequest request;
+  request.mQuery = NativeTextInputQuery::StartTextDrag;
+  request.mPoint = aPoint;
+  NativeTextInputReply reply;
+  RecvQueryNativeTextInput(request, &reply);
+  aResolve(reply.mSucceeded);
+  return IPC_OK();
+}
