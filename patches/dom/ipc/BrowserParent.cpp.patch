+mozilla::ipc::IPCResult BrowserParent::RecvNativeTextInputPositionChanged() {
+#ifdef MOZ_WIDGET_UIKIT
+  RefPtr<BrowserParent> focused = GetFocused();
+  // A parent can scroll and move this editor. Ignore other documents.
+  for (BrowserParent* ancestor = focused; ancestor;) {
+    if (ancestor == this) {
+      if (nsCOMPtr<nsIWidget> widget = focused->GetTextInputHandlingWidget()) {
+        widget->NotifyIME(IMENotification(NOTIFY_IME_OF_POSITION_CHANGE));
+      }
+      break;
+    }
+
+    BrowserBridgeParent* bridge = ancestor->GetBrowserBridgeParent();
+    ancestor = bridge ? bridge->Manager() : nullptr;
+  }
+#endif
+  return IPC_OK();
+}
