+bool BrowserParent::QueryNativeTextInput(const NativeTextInputRequest& aRequest,
+                                         NativeTextInputReply& aReply) {
+  nsCOMPtr<nsIWidget> widget = GetTextInputHandlingWidget();
+  nsCOMPtr<nsIWidget> browserWidget = GetWidget();
+  if (mIsDestroyed || !widget || !browserWidget) {
+    return false;
+  }
+
+  const LayoutDeviceIntPoint offset =
+      browserWidget != widget
+          ? nsLayoutUtils::WidgetToWidgetOffset(browserWidget, widget)
+          : LayoutDeviceIntPoint();
+  NativeTextInputRequest request(aRequest);
+  request.mPoint = TransformParentToChild(request.mPoint) - offset;
+  if (!SendQueryNativeTextInput(request, &aReply) || !aReply.mSucceeded) {
+    return false;
+  }
+
+  auto transformReferences =
+      [&](nsTArray<NativeTextInputScrollReference>& aReferences) {
+        for (auto& reference : aReferences) {
+          const LayoutDevicePoint origin =
+              TransformChildToParent(reference.mOrigin + offset);
+          reference.mXAxis = TransformChildToParent(reference.mOrigin +
+                                                    reference.mXAxis + offset) -
+                             origin;
+          reference.mYAxis = TransformChildToParent(reference.mOrigin +
+                                                    reference.mYAxis + offset) -
+                             origin;
+          reference.mOrigin = origin;
+        }
+      };
+  auto transformRects = [&](nsTArray<NativeTextInputRect>& aRects) {
+    for (auto& rect : aRects) {
+      rect.mRect = TransformChildToParent(rect.mRect + offset);
+      transformReferences(rect.mScrollReferences);
+    }
+  };
+
+  transformReferences(aReply.mScrollReferences);
+  if (!aReply.mRect.IsEmpty()) {
+    aReply.mRect = TransformChildToParent(aReply.mRect + offset);
+  }
+
+  transformRects(aReply.mRects);
+  transformRects(aReply.mClipRects);
+  transformRects(aReply.mCaretRects);
+
+  return true;
+}
