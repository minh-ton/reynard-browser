+mozilla::ipc::IPCResult HangMonitorChild::RecvSetProcessBackground(
+    const bool& aIsBackground) {
+  MOZ_RELEASE_ASSERT(IsOnThread());
+#ifdef XP_IOS
+  const int priority = aIsBackground ? PRIO_DARWIN_BG : 0;
+  if (setpriority(PRIO_DARWIN_PROCESS, 0, priority) == -1) {
+    MOZ_LOG(gQoSLog, LogLevel::Warning,
+            ("setpriority(PRIO_DARWIN_PROCESS, 0, %d) failed: errno=%d",
+             priority, errno));
+  }
+#endif
+  return IPC_OK();
+}
