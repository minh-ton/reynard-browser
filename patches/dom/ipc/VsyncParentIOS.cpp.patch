+#include "VsyncParentIOS.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "mozilla/Atomics.h"
+#include "mozilla/Services.h"
+#include "nsIObserver.h"
+#include "nsIObserverService.h"
+#include "nsString.h"
+#include "nsXULAppAPI.h"
+
+namespace mozilla::dom {
+
+static Atomic<bool, Relaxed> sIsLowPowerModeEnabled(false);
+static Atomic<bool, Relaxed> sIsThermalMitigationEnabled(false);
+
+class SystemPowerStateObserver final : public nsIObserver {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIOBSERVER
+
+ private:
+  ~SystemPowerStateObserver() = default;
+};
+
+NS_IMPL_ISUPPORTS(SystemPowerStateObserver, nsIObserver)
+
+NS_IMETHODIMP
+SystemPowerStateObserver::Observe(nsISupports* aSubject, const char* aTopic,
+                                  const char16_t* aData) {
+  nsDependentString state(aData);
+  if (!strcmp(aTopic, "system-power-state-changed")) {
+    sIsLowPowerModeEnabled = state.EqualsLiteral("low-power");
+  } else {
+    sIsThermalMitigationEnabled =
+        state.EqualsLiteral("serious") || state.EqualsLiteral("critical");
+  }
+
+  return NS_OK;
+}
+
+void VsyncParentIOS::Initialize() {
+  if (!XRE_IsParentProcess()) {
+    return;
+  }
+
+  nsCOMPtr<nsIObserverService> observerService = services::GetObserverService();
+  RefPtr<SystemPowerStateObserver> observer = new SystemPowerStateObserver();
+  observerService->AddObserver(observer, "system-power-state-changed", false);
+  observerService->AddObserver(observer, "system-thermal-state-changed", false);
+}
+
+int32_t VsyncParentIOS::GetFrameRateDivisor(const TimeDuration& aVsyncRate) {
+  double fullSpeedRatio = 1000.0 / aVsyncRate.ToMilliseconds() / 60.0;
+  int32_t divisor = std::max(1, int32_t(std::ceil(fullSpeedRatio - 0.5)));
+  if (sIsLowPowerModeEnabled || sIsThermalMitigationEnabled) {
+    divisor *= 2;
+  }
+
+  return divisor;
+}
+
+}  // namespace mozilla::dom
