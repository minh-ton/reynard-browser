+
+#include <CoreLocation/CLLocationManager.h>
+#include <CoreLocation/CLLocationManagerDelegate.h>
+#import <UIKit/UIKit.h>
+
+#include "GeolocationSystem.h"
+#include "mozilla/WeakPtr.h"
+#include "nsThreadUtils.h"
+
+namespace mozilla::dom::geolocation {
+class UIKitGeolocationPermissionRequest;
+}
+
+@interface LocationPermissionDelegate : NSObject <CLLocationManagerDelegate> {
+ @private
+  mozilla::WeakPtr<mozilla::dom::geolocation::UIKitGeolocationPermissionRequest>
+      mRequest;
+}
+- (id)initWithRequest:
+    (mozilla::WeakPtr<
+        mozilla::dom::geolocation::UIKitGeolocationPermissionRequest>)aRequest;
+- (void)locationManagerDidChangeAuthorization:(CLLocationManager*)manager;
+- (void)locationManager:(CLLocationManager*)manager
+    didChangeAuthorizationStatus:(CLAuthorizationStatus)status;
+- (void)sceneDidBecomeActive:(NSNotification*)notification;
+@end
+
+namespace mozilla::dom::geolocation {
+
+class UIKitGeolocationPermissionRequest final
+    : public SystemGeolocationPermissionRequest,
+      public SupportsWeakPtr {
+ public:
+  NS_INLINE_DECL_REFCOUNTING(UIKitGeolocationPermissionRequest, override);
+
+  void Init(ParentRequestResolver&& aResolver, bool aSystemWillPrompt) {
+    MOZ_ASSERT(NS_IsMainThread());
+
+    mLocationManager = [[CLLocationManager alloc] init];
+    if (!mLocationManager) {
+      aResolver(GeolocationPermissionStatus::Error);
+      return;
+    }
+
+    mLocationManager.delegate =
+        [[LocationPermissionDelegate alloc] initWithRequest:WeakPtr(this)];
+    if (!mLocationManager.delegate) {
+      [mLocationManager release];
+      mLocationManager = nil;
+      aResolver(GeolocationPermissionStatus::Error);
+      return;
+    }
+
+    mResolver = std::move(aResolver);
+    mSystemWillPrompt = aSystemWillPrompt;
+    mIsRunning = true;
+    mSelfReference = this;
+
+    if (aSystemWillPrompt) {
+      [mLocationManager requestWhenInUseAuthorization];
+      return;
+    }
+
+    NSURL* url = [NSURL URLWithString:UIApplicationOpenSettingsURLString];
+    UIApplication* application = [UIApplication sharedApplication];
+    if (!url || !application || ![application canOpenURL:url]) {
+      Finish(GeolocationPermissionStatus::Error);
+      return;
+    }
+
+    [[NSNotificationCenter defaultCenter]
+        addObserver:mLocationManager.delegate
+           selector:@selector(sceneDidBecomeActive:)
+               name:UISceneDidActivateNotification
+             object:nil];
+
+    WeakPtr<UIKitGeolocationPermissionRequest> weakRequest(this);
+    [application openURL:url
+        options:@{}
+        completionHandler:^(BOOL success) {
+          RefPtr<UIKitGeolocationPermissionRequest> request(weakRequest);
+          if (request && !request->IsStopped() && !success) {
+            request->Finish(GeolocationPermissionStatus::Error);
+          }
+        }];
+  }
+
+  void Stop() override {
+    MOZ_ASSERT(NS_IsMainThread());
+    if (!mIsRunning) {
+      return;
+    }
+    CLAuthorizationStatus status = [CLLocationManager authorizationStatus];
+    Finish(PermissionIsGranted(status) ? GeolocationPermissionStatus::Granted
+                                       : GeolocationPermissionStatus::Canceled);
+  }
+
+  bool IsStopped() const { return !mIsRunning; }
+
+  static bool PermissionIsGranted(CLAuthorizationStatus aStatus) {
+    switch (aStatus) {
+      case kCLAuthorizationStatusAuthorizedAlways:
+      case kCLAuthorizationStatusAuthorizedWhenInUse:
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  bool AuthorizationChangeCompletesRequest() {
+    CLAuthorizationStatus status = [CLLocationManager authorizationStatus];
+    if (PermissionIsGranted(status)) {
+      return true;
+    }
+    return mSystemWillPrompt && (status == kCLAuthorizationStatusDenied ||
+                                 status == kCLAuthorizationStatusRestricted);
+  }
+
+ protected:
+  virtual ~UIKitGeolocationPermissionRequest() { Stop(); }
+
+  void Finish(GeolocationPermissionStatus aStatus) {
+    MOZ_ASSERT(NS_IsMainThread());
+    RefPtr<UIKitGeolocationPermissionRequest> deathGrip(this);
+    mIsRunning = false;
+
+    [[NSNotificationCenter defaultCenter]
+        removeObserver:mLocationManager.delegate
+                  name:UISceneDidActivateNotification
+                object:nil];
+    [mLocationManager.delegate release];
+    mLocationManager.delegate = nil;
+    [mLocationManager release];
+    mLocationManager = nil;
+
+    mResolver(aStatus);
+    mSelfReference = nullptr;
+  }
+
+  ParentRequestResolver mResolver;
+  RefPtr<UIKitGeolocationPermissionRequest> mSelfReference;
+  CLLocationManager* mLocationManager = nil;
+  bool mSystemWillPrompt = false;
+  bool mIsRunning = false;
+};
+
+SystemGeolocationPermissionBehavior GetGeolocationPermissionBehavior() {
+  CLAuthorizationStatus status = [CLLocationManager authorizationStatus];
+  switch (status) {
+    case kCLAuthorizationStatusDenied:
+      return SystemGeolocationPermissionBehavior::GeckoWillPromptUser;
+    case kCLAuthorizationStatusNotDetermined:
+      return SystemGeolocationPermissionBehavior::SystemWillPromptUser;
+    case kCLAuthorizationStatusAuthorizedAlways:
+    case kCLAuthorizationStatusAuthorizedWhenInUse:
+      return SystemGeolocationPermissionBehavior::NoPrompt;
+    case kCLAuthorizationStatusRestricted:
+    default:
+      return SystemGeolocationPermissionBehavior::NoPrompt;
+  }
+}
+
+already_AddRefed<SystemGeolocationPermissionRequest>
+RequestLocationPermissionFromUser(BrowsingContext* aBrowsingContext,
+                                  ParentRequestResolver&& aResolver) {
+  auto permission = GetGeolocationPermissionBehavior();
+  if (permission == SystemGeolocationPermissionBehavior::NoPrompt) {
+    aResolver(GeolocationPermissionStatus::Granted);
+    return nullptr;
+  }
+
+  RefPtr<UIKitGeolocationPermissionRequest> permissionRequest =
+      new UIKitGeolocationPermissionRequest();
+  permissionRequest->Init(
+      std::move(aResolver),
+      permission == SystemGeolocationPermissionBehavior::SystemWillPromptUser);
+  if (permissionRequest->IsStopped()) {
+    return nullptr;
+  }
+  return permissionRequest.forget();
+}
+
+}  // namespace mozilla::dom::geolocation
+
+@implementation LocationPermissionDelegate
+
+- (id)initWithRequest:
+    (mozilla::WeakPtr<
+        mozilla::dom::geolocation::UIKitGeolocationPermissionRequest>)aRequest {
+  if ((self = [super init])) {
+    mRequest = aRequest;
+  }
+  return self;
+}
+
+- (void)handleAuthorizationChange {
+  RefPtr<mozilla::dom::geolocation::UIKitGeolocationPermissionRequest> request(
+      mRequest);
+  if (request && request->AuthorizationChangeCompletesRequest()) {
+    request->Stop();
+  }
+}
+
+- (void)locationManagerDidChangeAuthorization:(CLLocationManager*)aManager {
+  [self handleAuthorizationChange];
+}
+
+- (void)locationManager:(CLLocationManager*)aManager
+    didChangeAuthorizationStatus:(CLAuthorizationStatus)aStatus {
+  [self handleAuthorizationChange];
+}
+
+- (void)sceneDidBecomeActive:(NSNotification*)aNotification {
+  RefPtr<mozilla::dom::geolocation::UIKitGeolocationPermissionRequest> request(
+      mRequest);
+  if (request) {
+    request->Stop();
+  }
+}
+@end
