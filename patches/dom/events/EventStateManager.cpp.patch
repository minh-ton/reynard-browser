+void EventStateManager::StartNativeDragGesture(WidgetMouseEvent& aEvent,
+                                               nsIFrame* aTargetFrame) {
+  BeginTrackingDragGesture(mPresContext, aEvent, aTargetFrame);
+  ContinueNativeDragGesture();
+}
+
+void EventStateManager::ContinueNativeDragGesture() {
+  nsIFrame* frame = mGestureDownFrameOwner
+                        ? mGestureDownFrameOwner->GetPrimaryFrame()
+                        : nullptr;
+  if (!frame) {
+    return;
+  }
+
+  nsCOMPtr<nsIWidget> widget = frame->GetNearestWidget();
+  if (!widget) {
+    return;
+  }
+
+  WidgetMouseEvent event(true, eMouseMove, widget, WidgetMouseEvent::eReal);
+  event.mRefPoint = mGestureDownPoint - widget->WidgetToScreenOffset();
+  event.mInputSource = MouseEvent_Binding::MOZ_SOURCE_TOUCH;
+  RefPtr<nsPresContext> context = mPresContext;
+
+  GenerateDragGesture(context, event, true);
+}
