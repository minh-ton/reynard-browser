+static bool IsEditableTextDropTarget(nsIContent* aContent) {
+  if (!aContent) {
+    return false;
+  }
+
+  nsIContent* control =
+      aContent->IsInNativeAnonymousSubtree()
+          ? aContent->GetClosestNativeAnonymousSubtreeRootParentOrHost()
+          : aContent;
+  if (const auto* textControl = TextControlElement::FromNode(control)) {
+    return textControl->IsSingleLineTextControlOrTextArea() &&
+           !textControl->IsDisabledOrReadOnly();
+  }
+
+  return aContent->IsEditable();
+}
