+          nsContentUtils::GetDragSession(shell->GetPresContext());
+      NS_ENSURE_TRUE(session, NS_ERROR_NOT_AVAILABLE);
+      break;
+    }
+    case NativeTextInputQuery::ScrollSelectionIntoView: {
+      NS_ENSURE_TRUE(aReply.mSelectable, NS_ERROR_NOT_AVAILABLE);
+      ScrollFlags flags = ScrollFlags::ScrollOverflowHidden;
+      if (aRequest.mAnimated) {
+        flags |= ScrollFlags::ScrollSmooth;
+      }
+
+      rv = MOZ_KnownLive(mSelection)
+               ->ScrollIntoView(nsISelectionController::SELECTION_FOCUS_REGION,
+                                AxisScrollParams(), AxisScrollParams(), flags,
+                                SelectionScrollMode::SyncNoFlush);
+      NS_ENSURE_SUCCESS(rv, rv);
+      break;
+    }
+    case NativeTextInputQuery::ScrollAtPoint: {
+      NS_ENSURE_TRUE(aReply.mSelectable, NS_ERROR_NOT_AVAILABLE);
+      RefPtr<PresShell> shell = mDocument->GetPresShell();
+      NS_ENSURE_TRUE(shell, NS_ERROR_NOT_AVAILABLE);
+      nsRect caret;
+      nsIFrame* frame = mSelection->GetSelectionAnchorGeometry(
+          nsISelectionController::SELECTION_FOCUS_REGION, &caret);
+      NS_ENSURE_TRUE(frame, NS_ERROR_NOT_AVAILABLE);
+
+      // Scroll toward the dragged handle, even if the selection end is still
+      // visible.
+      nsPoint point = nsLayoutUtils::GetEventCoordinatesRelativeTo(
+          widget, aRequest.mPoint, RelativeTo{frame});
+      aReply.mScrolled =
+          shell->ScrollFrameIntoView(frame, Some(nsRect(point, nsSize())),
+                                     AxisScrollParams(), AxisScrollParams(),
+                                     ScrollFlags::ScrollOverflowHidden |
+                                         ScrollFlags::ScrollFirstAncestorOnly);
