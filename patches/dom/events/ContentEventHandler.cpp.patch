+static nsTextControlFrame* GetFocusedTextControlFrameForRoot(
+    Element* aRootElement);
+
+// Hide native selection UI for hidden inputs
+static bool ShouldSuppressNativeSelectionDisplay(nsIFrame* aFrame) {
+  if (!aFrame || !aFrame->IsVisibleConsideringAncestors()) {
+    return true;
+  }
+
+  nsRect rect = nsLayoutUtils::GetAllInFlowRectsUnion(aFrame, aFrame);
+  const CSSRect bounds = CSSRect::FromAppUnits(rect);
+
+  // Hide on tiny editors (borrowed this from WebKit btw)
+  if (bounds.width * bounds.height < 4) {
+    return true;
+  }
+
+  for (nsIFrame* frame = aFrame; frame;) {
+    if (frame->StyleEffects()->IsTransparent()) {
+      return true;
+    }
+
+    if (auto clip = frame->GetClipPropClipRect(
+            frame->StyleDisplay(), frame->StyleEffects(), frame->GetSize())) {
+      rect = rect.Intersect(*clip);
+    }
+
+    const PhysicalAxes axes =
+        frame->ShouldApplyOverflowClipping(frame->StyleDisplay());
+    ScrollContainerFrame* scroll = do_QueryFrame(frame);
+    if (!scroll && !axes.isEmpty()) {
+      nsRect clip;
+      nsRectCornerRadii radii;
+      nsMargin inset;
+      frame->ComputeOverflowClipRectRelativeToSelf(axes, clip, radii, inset);
+      rect = rect.Intersect(clip);
+    }
+
+    if (rect.IsEmpty()) {
+      return true;
+    }
+
+    nsIFrame* parent = nsLayoutUtils::GetCrossDocParentFrameInProcess(frame);
+    if (!parent) {
+      break;
+    }
+
+    rect = nsLayoutUtils::TransformFrameRectToAncestor(frame, rect, parent);
+    frame = parent;
+  }
+
+  return false;
+}
+
+static void CollectNativeScrollReferences(
+    nsIFrame* aFrame, nsTArray<NativeTextInputScrollReference>& aReferences) {
+  nsPresContext* context =
+      aFrame->PresContext()->GetInProcessRootContentDocumentPresContext();
+  if (!context) {
+    return;
+  }
+
+  PresShell* shell = context->PresShell();
+  nsIFrame* root = shell->GetRootFrame();
+  auto* rootScroll = shell->GetRootScrollContainerFrame();
+  const float resolution = shell->GetResolution();
+  bool hasRoot = false;
+
+  auto append = [&](ScrollContainerFrame* aScroll, bool aFixed) {
+    BrowserChild* browser = BrowserChild::GetFrom(aScroll->PresShell());
+    if (!browser || !aScroll->GetContent()) {
+      return;
+    }
+
+    NativeTextInputScrollReference reference;
+    reference.mGuid = layers::ScrollableLayerGuid(
+        browser->GetLayersId(), aScroll->PresShell()->GetPresShellId(),
+        nsLayoutUtils::FindOrCreateIDFor(aScroll->GetContent()));
+    reference.mGeneration = aScroll->CurrentScrollGeneration();
+
+    const auto matrix = nsLayoutUtils::GetTransformToAncestor(
+        RelativeTo{aScroll}, RelativeTo{root});
+    const float scale = aScroll->PresContext()->CSSToDevPixelScale().scale;
+    const gfx::Point origin = matrix.TransformPoint(gfx::Point());
+    const gfx::Point x = matrix.TransformPoint(gfx::Point(scale, 0)) - origin;
+    const gfx::Point y = matrix.TransformPoint(gfx::Point(0, scale)) - origin;
+    reference.mXAxis = LayoutDevicePoint(x.x, x.y) * resolution;
+    reference.mYAxis = LayoutDevicePoint(y.x, y.y) * resolution;
+    reference.mOffset = aScroll->GetScrollPositionCSSPixels();
+
+    if (aScroll == rootScroll) {
+      reference.mZoom = scale * resolution;
+      reference.mFixed = aFixed;
+      const CSSPoint callback =
+          nsLayoutUtils::GetCumulativeApzCallbackTransform(aScroll);
+      reference.mOffset = aFixed ? callback : reference.mOffset + callback;
+      hasRoot = true;
+    }
+    aReferences.AppendElement(reference);
+  };
+
+  for (nsIFrame* frame = nsLayoutUtils::GetCrossDocParentFrameInProcess(aFrame);
+       frame; frame = nsLayoutUtils::GetCrossDocParentFrameInProcess(frame)) {
+    if (ScrollContainerFrame* scroll = do_QueryFrame(frame)) {
+      append(scroll, false);
+    }
+  }
+
+  if (!hasRoot && rootScroll) {
+    append(rootScroll, true);
+  }
+}
+
+nsresult ContentEventHandler::QueryNativeTextInput(
+    const NativeTextInputRequest& aRequest, NativeTextInputReply& aReply) {
+  aReply = NativeTextInputReply();
+  nsresult rv = InitCommon(eQuerySelectedText);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(mRootElement, NS_ERROR_NOT_AVAILABLE);
+  NS_ENSURE_TRUE(mDocument->GetPresContext(), NS_ERROR_NOT_AVAILABLE);
+  nsIWidget* widget = mDocument->GetPresContext()->GetRootWidget();
+  NS_ENSURE_TRUE(widget, NS_ERROR_NOT_AVAILABLE);
+
+  aReply.mEditable = mRootElement->IsEditable();
+  aReply.mSelectable = aReply.mEditable;
+  if (nsTextControlFrame* control =
+          GetFocusedTextControlFrameForRoot(mRootElement)) {
+    aReply.mEditable = !control->ControlElement()->IsDisabledOrReadOnly();
+    aReply.mSelectable = !control->ControlElement()->IsDisabled();
+  }
+
+  // Convert frame app unit to root widget device pixel, then account
+  // for the visual viewport.
+  auto visualRect = [&](nsIFrame* aFrame, nsRect aRect,
+                        NativeTextInputRect& aResult) -> nsresult {
+    nsPresContext* context = aFrame->PresContext();
+    aResult.mUntransformedRect =
+        LayoutDeviceRect::FromAppUnits(aRect, context->AppUnitsPerDevPixel());
+    Maybe<gfx::Matrix> transform;
+    nsresult result = ConvertToRootRelativeOffset(aFrame, aRect, &transform);
+    NS_ENSURE_SUCCESS(result, result);
+    aResult.mRect = LayoutDeviceIntRect::FromAppUnitsToOutside(
+        aRect, context->AppUnitsPerDevPixel());
+    if (nsPresContext* root =
+            context->GetInProcessRootContentDocumentPresContext()) {
+      aResult.mRect = RoundedOut(ViewportUtils::DocumentRelativeLayoutToVisual(
+          aResult.mRect, root->PresShell()));
+      if (transform) {
+        auto* scroll = root->PresShell()->GetRootScrollContainerFrame();
+        const auto visualToLayout =
+            ViewportUtils::GetVisualToLayoutTransform<LayoutDevicePixel>(
+                scroll ? scroll->GetContent() : nullptr);
+        gfx::Matrix viewport;
+        if (visualToLayout.Inverse().Is2D(&viewport)) {
+          *transform *= viewport;
+        } else {
+          transform.reset();
+        }
+      }
+    }
+
+    if (transform) {
+      aResult.mTransform = *transform;
+    } else {
+      aResult.mUntransformedRect = LayoutDeviceRect(aResult.mRect);
+    }
+    CollectNativeScrollReferences(aFrame, aResult.mScrollReferences);
+    return NS_OK;
+  };
+
+  // At a line wrap or where text changes direction, keep the caret on the
+  // side UIKit asked for.
+  auto frameAtOffset = [&](uint32_t aOffset, bool aAssociateWithNext,
+                           FrameAndOffset& aResult) -> nsresult {
+    auto rangeOrError = ConvertFlatTextOffsetToDOMRange(aOffset, 0, false);
+    if (rangeOrError.isErr()) {
+      return rangeOrError.unwrapErr();
+    }
+
+    auto range = rangeOrError.unwrap();
+    nsresult result = AdjustCollapsedRangeMaybeIntoTextNode(range.mRange);
+    NS_ENSURE_SUCCESS(result, result);
+    nsIContent* content =
+        nsIContent::FromNode(range.mRange.GetStartContainer());
+    NS_ENSURE_TRUE(content, NS_ERROR_NOT_AVAILABLE);
+    const CaretAssociationHint hint = aAssociateWithNext
+                                          ? CaretAssociationHint::After
+                                          : CaretAssociationHint::Before;
+    nsFrameSelection* selection = mSelection->GetFrameSelection();
+    NS_ENSURE_TRUE(selection, NS_ERROR_NOT_AVAILABLE);
+    aResult = SelectionMovementUtils::GetCaretFrameForNodeOffset(
+        selection, content, range.mRange.StartOffset(), hint,
+        intl::BidiEmbeddingLevel(BIDI_LEVEL_UNDEFINED),
+        aReply.mEditable ? ForceEditableRegion::Yes : ForceEditableRegion::No);
+    return aResult ? NS_OK : NS_ERROR_NOT_AVAILABLE;
+  };
+
+  // Get the caret rect even when Gecko isn't drawing its own caret.
+  auto caretAtOffset = [&](uint32_t aOffset, bool aAssociateWithNext,
+                           NativeTextInputRect& aRect) -> nsresult {
+    FrameAndOffset frame;
+    nsresult result = frameAtOffset(aOffset, aAssociateWithNext, frame);
+    NS_ENSURE_SUCCESS(result, result);
+    nscoord bidiIndicator;
+    nsRect rect = nsCaret::GetGeometryForFrame(
+        frame.mFrame, frame.mOffsetInFrameContent, &bidiIndicator);
+    aRect.mRTL =
+        frame->GetEmbeddingLevel().Direction() == intl::BidiDirection::RTL;
+    aRect.mVertical = frame->GetWritingMode().IsVertical();
+    return visualRect(frame.mFrame, rect, aRect);
+  };
+
+  if (aRequest.mQuery == NativeTextInputQuery::State ||
+      aRequest.mQuery == NativeTextInputQuery::Appearance) {
+    nsIFrame* editorFrame = mRootElement->GetPrimaryFrame();
+    if (nsTextControlFrame* control =
+            GetFocusedTextControlFrameForRoot(mRootElement)) {
+      editorFrame = control;
+    }
+    aReply.mSuppressSelectionDisplay =
+        ShouldSuppressNativeSelectionDisplay(editorFrame);
+
+    // Find the scrollable areas containing the field and selection ends.
+    auto appendScrollers = [&](nsIFrame* aFrame) {
+      for (nsIFrame* frame = aFrame; frame;
+           frame = nsLayoutUtils::GetCrossDocParentFrameInProcess(frame)) {
+        ScrollContainerFrame* scroll = do_QueryFrame(frame);
+        if (!scroll || !scroll->GetContent()) {
+          continue;
+        }
+
+        BrowserChild* browser = BrowserChild::GetFrom(frame->PresShell());
+        if (!browser) {
+          continue;
+        }
+
+        layers::ScrollableLayerGuid guid(
+            browser->GetLayersId(), frame->PresShell()->GetPresShellId(),
+            nsLayoutUtils::FindOrCreateIDFor(scroll->GetContent()));
+        if (!aReply.mSelectionScrollers.Contains(guid)) {
+          aReply.mSelectionScrollers.AppendElement(guid);
+        }
+      }
+    };
+
+    appendScrollers(editorFrame);
+    nsRect caretRect;
+    appendScrollers(mSelection->GetSelectionAnchorGeometry(
+        nsISelectionController::SELECTION_ANCHOR_REGION, &caretRect));
+    appendScrollers(mSelection->GetSelectionAnchorGeometry(
+        nsISelectionController::SELECTION_FOCUS_REGION, &caretRect));
+
+    // Let UIKit choose the color for auto, but keep an explicit transparent
+    // color.
+    const auto caret =
+        nsCaret::GetFrameAndOffset(nsCaret::CaretPositionFor(mSelection));
+    if (caret.mFrame) {
+      aReply.mCaretColor =
+          caret.mFrame->GetCaretColorAt(caret.mOffsetInFrameContent);
+      aReply.mCaretColorIsAuto = caret.mFrame->StyleUI()->mCaretColor.IsAuto();
+    }
+  }
+
+  switch (aRequest.mQuery) {
+    case NativeTextInputQuery::State: {
+      if (aReply.mEditable) {
+        if (RefPtr<EditorBase> editor =
+                nsContentUtils::GetActiveEditor(mDocument->GetPresContext())) {
+          if (!editor->GetComposition()) {
+            aReply.mCanUndo = editor->CanUndo();
+            aReply.mCanRedo = editor->CanRedo();
+          }
+
+          RefPtr<EditorCommand> command = StyleUpdatingCommand::GetInstance();
+          aReply.mCanFormat =
+              command->IsCommandEnabled(Command::FormatBold, editor);
+        }
+      }
+
+      if (nsTextControlFrame* control =
+              GetFocusedTextControlFrameForRoot(mRootElement)) {
+        control->ControlElement()->GetTextEditorValue(aReply.mText);
+        aReply.mHasText = !aReply.mText.IsEmpty();
+      } else {
+        rv = GenerateFlatTextContent(mRootElement, aReply.mText);
+        NS_ENSURE_SUCCESS(rv, rv);
+
+        // Empty blocks add line breaks to flat text but have no text to select.
+        aReply.mHasText = nsContentUtils::HasNonEmptyTextContent(
+            mRootElement, nsContentUtils::eRecurseIntoChildren);
+      }
+
+      if (mFirstSelectedSimpleRange.IsPositioned()) {
+        auto start = GetStartOffset(mFirstSelectedSimpleRange);
+        if (start.isErr()) {
+          return start.unwrapErr();
+        }
+
+        nsAutoString selectedText;
+        rv = GenerateFlatTextContent(mFirstSelectedSimpleRange, selectedText);
+        NS_ENSURE_SUCCESS(rv, rv);
+        aReply.mSelectionStart = start.unwrap();
+        aReply.mSelectionLength = selectedText.Length();
+        aReply.mAssociateWithNext =
+            mSelection->GetFrameSelection()->GetHint() ==
+            CaretAssociationHint::After;
+      }
+
+      WidgetQueryContentEvent editor(true, eQueryEditorRect, widget);
+      rv = OnQueryEditorRect(&editor, &aReply);
+      NS_ENSURE_SUCCESS(rv, rv);
+      break;
+    }
+    case NativeTextInputQuery::Appearance: {
+      WidgetQueryContentEvent editor(true, eQueryEditorRect, widget);
+      rv = OnQueryEditorRect(&editor, &aReply);
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(editor.Succeeded(), NS_ERROR_NOT_AVAILABLE);
+      break;
+    }
+    case NativeTextInputQuery::Caret: {
+      NativeTextInputRect caret;
+      rv = caretAtOffset(aRequest.mOffset, aRequest.mAssociateWithNext, caret);
+      NS_ENSURE_SUCCESS(rv, rv);
+      aReply.mRect = caret.mRect;
+      aReply.mScrollReferences = caret.mScrollReferences.Clone();
+      aReply.mRTL = caret.mRTL;
+      aReply.mCaretRects.AppendElement(std::move(caret));
+      break;
+    }
+    case NativeTextInputQuery::SelectionRects:
+    case NativeTextInputQuery::SelectionHighlightRects: {
+      if (!aRequest.mLength ||
+          aRequest.mLength > UINT32_MAX - aRequest.mOffset) {
+        return NS_ERROR_INVALID_ARG;
+      }
+
+      auto rangeOrError = ConvertFlatTextOffsetToDOMRange(
+          aRequest.mOffset, aRequest.mLength, true);
+      if (rangeOrError.isErr()) {
+        return rangeOrError.unwrapErr();
+      }
+
+      auto range = rangeOrError.unwrap();
+
+      bool normalizeLines =
+          aRequest.mQuery == NativeTextInputQuery::SelectionHighlightRects;
+      nsIFrame* lineBlock = nullptr;
+      int32_t lineNumber = 0;
+      auto lineForFrame =
+          [&](nsIFrame* aFrame) -> std::pair<nsIFrame*, int32_t> {
+        auto [block, child] = aFrame->GetContainingBlockForLine(true);
+        if (!block || !block->IsBlockFrame()) {
+          return {nullptr, -1};
+        }
+
+        // A non-editable inline block belongs to the surrounding text line.
+        while (block->IsInlineOutside() && block->GetContent() &&
+               !block->GetContent()->IsEditable()) {
+          auto [parentBlock, parentChild] =
+              block->GetContainingBlockForLine(true);
+          if (!parentBlock || !parentBlock->IsBlockFrame()) {
+            break;
+          }
+          block = parentBlock;
+          child = parentChild;
+        }
+
+        nsILineIterator* lines = block->GetLineIterator();
+        if (!lines->GetNumLines()) {
+          return {nullptr, -1};
+        }
+
+        // Start searching at the previous line. If the text appears in a
+        // different order, try again from the beginning.
+        const int32_t searchStart = block == lineBlock ? lineNumber : 0;
+        int32_t line = lines->FindLineContaining(child, searchStart);
+        if (line < 0 && searchStart > 0) {
+          line = lines->FindLineContaining(child);
+        }
+        if (line >= 0) {
+          lineBlock = block;
+          lineNumber = line;
+        }
+        return {block, line};
+      };
+
+      std::pair<nsIFrame*, int32_t> startLine(nullptr, -1);
+      std::pair<nsIFrame*, int32_t> endLine(nullptr, -1);
+
+      // At a line wrap, use the side inside the selection for each handle.
+      // Keep the original height when only one line is selected.
+      if (normalizeLines) {
+        FrameAndOffset endpoint;
+        rv = frameAtOffset(aRequest.mOffset, true, endpoint);
+        NS_ENSURE_SUCCESS(rv, rv);
+        startLine = lineForFrame(endpoint.mFrame);
+
+        rv =
+            frameAtOffset(aRequest.mOffset + aRequest.mLength, false, endpoint);
+        NS_ENSURE_SUCCESS(rv, rv);
+        endLine = lineForFrame(endpoint.mFrame);
+        normalizeLines = startLine != endLine;
+      }
+
+      nsIFrame* previousBlock = nullptr;
+      nsIFrame* previousRectFrame = nullptr;
+      int32_t previousLine = -1;
+      bool previousInterior = false;
+      UnsafePreContentIterator iter;
+      rv = iter.Init(range.mRange.Start().AsRaw(), range.mRange.End().AsRaw());
+      NS_ENSURE_SUCCESS(rv, rv);
+
+      for (; !iter.IsDone(); iter.Next()) {
+        nsIContent* content = nsIContent::FromNode(iter.GetCurrentNode());
+        if (!content) {
+          continue;
+        }
+
+        Text* text = Text::FromNode(content);
+
+        // Include breaks so empty lines also have a highlight.
+        if (!text) {
+          if (!content->IsHTMLElement(nsGkAtoms::br)) {
+            continue;
+          }
+
+          if (!ShouldBreakLineBefore(*content, mRootElement)) {
+            continue;
+          }
+        }
+
+        const uint32_t start = text == range.mRange.GetStartContainer()
+                                   ? range.mRange.StartOffset()
+                                   : 0;
+        const uint32_t end = text == range.mRange.GetEndContainer()
+                                 ? range.mRange.EndOffset()
+                                 : (text ? text->Length() : kBRLength);
+        auto textOffset = GetFlatTextLengthInRange(
+            RawNodePosition(mRootElement, 0u),
+            RawNodePosition::Before(*content), mRootElement);
+        if (textOffset.isErr()) {
+          return textOffset.unwrapErr();
+        }
+
+        if (!text) {
+          if (textOffset.inspect() < aRequest.mOffset) {
+            continue;
+          }
+
+          if (textOffset.inspect() >= aRequest.mOffset + aRequest.mLength) {
+            continue;
+          }
+        }
+
+        for (nsIFrame* frame = content->GetPrimaryFrame(); frame;
+             frame = frame->GetNextContinuation()) {
+          uint32_t from = start;
+          uint32_t to = end;
+          const bool vertical = frame->GetWritingMode().IsVertical();
+          nsRect rect = frame->GetRectRelativeToSelf();
+          if (text) {
+            if (!frame->IsTextFrame()) {
+              continue;
+            }
+
+            const auto [frameStart, frameEnd] = frame->GetOffsets();
+            from = std::max(start, uint32_t(frameStart));
+            to = std::min(end, uint32_t(frameEnd));
+            if (from >= to) {
+              continue;
+            }
+
+            nsPoint first, last;
+            rv = frame->GetPointFromOffset(from, &first);
+            NS_ENSURE_SUCCESS(rv, rv);
+            rv = frame->GetPointFromOffset(to, &last);
+            NS_ENSURE_SUCCESS(rv, rv);
+
+            // Text written right to left -> end is before start
+            if (vertical) {
+              rect.y = std::min(first.y, last.y);
+              rect.height = std::abs(last.y - first.y);
+            } else {
+              rect.x = std::min(first.x, last.x);
+              rect.width = std::abs(last.x - first.x);
+            }
+          } else if (frame->IsBrFrame()) {
+            rect = GetLineBreakerRectBefore(frame).mRect;
+
+            // Keep a selected break visible even on a single line.
+            if (vertical) {
+              rect.height = frame->PresContext()->AppUnitsPerDevPixel();
+            } else {
+              rect.width = frame->PresContext()->AppUnitsPerDevPixel();
+            }
+          } else {
+            continue;
+          }
+
+          NativeTextInputRect selectionRect;
+          selectionRect.mStartOffset = textOffset.inspect() + from;
+          selectionRect.mEndOffset = textOffset.inspect() + to;
+          selectionRect.mContainsStart =
+              selectionRect.mStartOffset == aRequest.mOffset;
+          selectionRect.mContainsEnd =
+              selectionRect.mEndOffset == aRequest.mOffset + aRequest.mLength;
+          selectionRect.mRTL = frame->GetEmbeddingLevel().Direction() ==
+                               intl::BidiDirection::RTL;
+          selectionRect.mVertical = vertical;
+
+          nsIFrame* rectFrame = frame;
+          nsIFrame* block = nullptr;
+          int32_t line = -1;
+          bool interior = false;
+          if (normalizeLines) {
+            auto frameLine = lineForFrame(frame);
+            block = frameLine.first;
+            line = frameLine.second;
+
+            // Keep the original rects if text has moved away from its line.
+            // For the block and its parents, allow moving and scaling, but not
+            // rotation, skew, or flipping.
+            bool insideBlock = true;
+            for (nsIFrame* ancestor = frame; block && ancestor;
+                 ancestor = ancestor->GetParent()) {
+              if (ancestor == block) {
+                insideBlock = false;
+              }
+
+              if (insideBlock) {
+                if (ancestor->HasAnyStateBits(NS_FRAME_OUT_OF_FLOW)) {
+                  block = nullptr;
+                  break;
+                }
+
+                if (ancestor->IsTransformed()) {
+                  block = nullptr;
+                  break;
+                }
+
+                if (!ancestor->IsRelativelyPositioned()) {
+                  continue;
+                }
+
+                if (ancestor->GetPosition() != ancestor->GetNormalPosition()) {
+                  block = nullptr;
+                  break;
+                }
+                continue;
+              }
+
+              if (!ancestor->IsTransformed()) {
+                continue;
+              }
+
+              const auto transform = nsLayoutUtils::GetTransformToAncestor(
+                  RelativeTo{ancestor}, RelativeTo{ancestor->GetParent()});
+              gfx::Matrix matrix;
+              if (!transform.Is2D(&matrix)) {
+                block = nullptr;
+                break;
+              }
+
+              const bool axisAligned = matrix._12 == 0 && matrix._21 == 0;
+              if (!axisAligned) {
+                block = nullptr;
+                break;
+              }
+
+              const bool positiveScale = matrix._11 > 0 && matrix._22 > 0;
+              if (!positiveScale) {
+                block = nullptr;
+                break;
+              }
+            }
+
+            if (block && block->GetWritingMode().IsVertical() != vertical) {
+              block = nullptr;
+            }
+          }
+
+          if (block && line >= 0) {
+            auto lineInfo = block->GetLineIterator()->GetLine(line);
+            if (lineInfo.isErr()) {
+              return lineInfo.unwrapErr();
+            }
+
+            // Use the block's coordinates so we can compare the text and line
+            // rects.
+            rect.MoveBy(frame->GetOffsetTo(block));
+            rectFrame = block;
+            const WritingMode writingMode = block->GetWritingMode();
+            const nsSize size = block->GetSize();
+            const LogicalRect bounds(writingMode,
+                                     lineInfo.inspect().mLineBounds, size);
+            const LogicalRect content(
+                writingMode, block->GetContentRectRelativeToSelf(), size);
+            LogicalRect highlight(writingMode, rect, size);
+            const bool firstLine = std::pair(block, line) == startLine;
+            const bool lastLine = std::pair(block, line) == endLine;
+            interior = !firstLine && !lastLine;
+
+            // Fill the gaps between selected lines without growing the
+            // selection's outer edges.
+            // Starting from below, they're all borrowed from WebKit (again!)
+            nscoord blockStart = highlight.BStart(writingMode);
+            nscoord blockEnd = highlight.BEnd(writingMode);
+
+            if (!firstLine) {
+              blockStart = std::min(blockStart, bounds.BStart(writingMode));
+            }
+            if (!lastLine) {
+              blockEnd = std::max(blockEnd, bounds.BEnd(writingMode));
+            }
+
+            highlight.BStart(writingMode) = blockStart;
+            highlight.BSize(writingMode) = blockEnd - blockStart;
+
+            if (interior) {
+              // Fill indentation and trailing space on fully selected lines.
+              highlight.IStart(writingMode) = content.IStart(writingMode);
+              highlight.ISize(writingMode) = content.ISize(writingMode);
+            }
+
+            if (firstLine) {
+              // Find the line end as it appears on screen. Mixed text
+              // directions can put it somewhere other than the last frame in
+              // DOM order.
+              nsIFrame* firstVisual;
+              nsIFrame* lastVisual;
+              bool reordered;
+              rv = block->GetLineIterator()->CheckLineOrder(
+                  line, &reordered, &firstVisual, &lastVisual);
+              NS_ENSURE_SUCCESS(rv, rv);
+              nsIFrame* child = frame;
+
+              while (child->GetParent() && child->GetParent() != block) {
+                child = child->GetParent();
+              }
+
+              const bool reachesLineEnd = child == lastVisual;
+              const bool followsLineDirection =
+                  selectionRect.mRTL == writingMode.IsBidiRTL();
+              if (reachesLineEnd && followsLineDirection) {
+                highlight.ISize(writingMode) =
+                    std::max(highlight.IEnd(writingMode),
+                             content.IEnd(writingMode)) -
+                    highlight.IStart(writingMode);
+              }
+            }
+
+            rect = highlight.GetPhysicalRect(writingMode, size);
+
+            // Use shared coordinates for paragraphs in the same parent.
+            nsIFrame* parent = block->GetParent();
+            if (!block->HasAnyStateBits(NS_FRAME_OUT_OF_FLOW) &&
+                !block->IsTransformed() &&
+                !block->IsRelativelyOrStickyPositioned()) {
+              if (parent && parent->IsBlockFrame() &&
+                  parent->GetWritingMode() == writingMode) {
+                rect.MoveBy(block->GetOffsetTo(parent));
+                rectFrame = parent;
+              }
+            }
+          }
+
+          rv = visualRect(rectFrame, rect, selectionRect);
+          NS_ENSURE_SUCCESS(rv, rv);
+
+          if (block && previousBlock && rectFrame == previousRectFrame) {
+            auto& previous = aReply.mRects.LastElement();
+            const bool sameLine =
+                block == previousBlock && line == previousLine;
+            const WritingMode writingMode = block->GetWritingMode();
+            bool nextLine = false;
+            if (!sameLine) {
+              if (!vertical) {
+                nextLine =
+                    selectionRect.mRect.YMost() > previous.mRect.YMost();
+              } else if (writingMode.IsVerticalRL()) {
+                nextLine = selectionRect.mRect.x < previous.mRect.x;
+              } else {
+                nextLine =
+                    selectionRect.mRect.XMost() > previous.mRect.XMost();
+              }
+            }
+
+            // Give neighboring lines the same edge, including after rounding.
+            // This fills paragraph gaps and avoids painting an edge twice.
+            if (nextLine) {
+              const auto& transform = selectionRect.mTransform;
+              if (!vertical) {
+                const int32_t edge = previous.mRect.YMost();
+                const float localEdge = (edge - transform._32) / transform._22;
+                previous.mUntransformedRect.SetBottomEdge(localEdge);
+                selectionRect.mUntransformedRect.SetTopEdge(localEdge);
+                selectionRect.mRect.SetTopEdge(edge);
+              } else if (writingMode.IsVerticalRL()) {
+                const int32_t edge = previous.mRect.x;
+                const float localEdge = (edge - transform._31) / transform._11;
+                previous.mUntransformedRect.SetLeftEdge(localEdge);
+                selectionRect.mUntransformedRect.SetRightEdge(localEdge);
+                selectionRect.mRect.SetRightEdge(edge);
+              } else {
+                const int32_t edge = previous.mRect.XMost();
+                const float localEdge = (edge - transform._31) / transform._11;
+                previous.mUntransformedRect.SetRightEdge(localEdge);
+                selectionRect.mUntransformedRect.SetLeftEdge(localEdge);
+                selectionRect.mRect.SetLeftEdge(edge);
+              }
+            } else if (sameLine && std::pair(block, line) != startLine) {
+              if (!vertical) {
+                selectionRect.mRect.SetTopEdge(
+                    std::max(selectionRect.mRect.y, previous.mRect.y));
+                selectionRect.mUntransformedRect.SetTopEdge(
+                    std::max(selectionRect.mUntransformedRect.y,
+                             previous.mUntransformedRect.y));
+              } else if (writingMode.IsVerticalRL()) {
+                selectionRect.mRect.SetRightEdge(
+                    std::min(selectionRect.mRect.XMost(),
+                             previous.mRect.XMost()));
+                selectionRect.mUntransformedRect.SetRightEdge(
+                    std::min(selectionRect.mUntransformedRect.XMost(),
+                             previous.mUntransformedRect.XMost()));
+              } else {
+                selectionRect.mRect.SetLeftEdge(
+                    std::max(selectionRect.mRect.x, previous.mRect.x));
+                selectionRect.mUntransformedRect.SetLeftEdge(
+                    std::max(selectionRect.mUntransformedRect.x,
+                             previous.mUntransformedRect.x));
+              }
+            }
+
+            // Keep partial first and last lines separate from the full lines.
+            bool mergeRects = false;
+            if (interior && previousInterior && (sameLine || nextLine)) {
+              mergeRects = true;
+            } else if (sameLine && previous.mRTL == selectionRect.mRTL) {
+              mergeRects = previous.mRect.Intersects(selectionRect.mRect);
+            }
+
+            if (mergeRects) {
+              previous.mRect = previous.mRect.Union(selectionRect.mRect);
+              previous.mUntransformedRect = previous.mUntransformedRect.Union(
+                  selectionRect.mUntransformedRect);
+              previous.mStartOffset =
+                  std::min(previous.mStartOffset, selectionRect.mStartOffset);
+              previous.mEndOffset =
+                  std::max(previous.mEndOffset, selectionRect.mEndOffset);
+              previous.mContainsStart |= selectionRect.mContainsStart;
+              previous.mContainsEnd |= selectionRect.mContainsEnd;
+              previousBlock = block;
+              previousLine = line;
+              continue;
+            }
+          }
+
+          previousBlock = block;
+          previousRectFrame = rectFrame;
+          previousLine = line;
+          previousInterior = interior;
+          aReply.mRects.AppendElement(selectionRect);
+        }
+      }
+
+      // Line breaks and empty paragraphs may have no text rect.
+      // Use the caret rect so the selection handle still has a position.
+      bool containsStart = false;
+      bool containsEnd = false;
+      for (const auto& rect : aReply.mRects) {
+        containsStart |= rect.mContainsStart;
+        containsEnd |= rect.mContainsEnd;
+      }
+
+      if (!containsStart) {
+        NativeTextInputRect caret;
+        rv = caretAtOffset(aRequest.mOffset, true, caret);
+        NS_ENSURE_SUCCESS(rv, rv);
+        caret.mContainsStart = true;
+        caret.mStartOffset = caret.mEndOffset = aRequest.mOffset;
+        aReply.mRects.AppendElement(caret);
+      }
+
+      if (!containsEnd) {
+        NativeTextInputRect caret;
+        rv = caretAtOffset(aRequest.mOffset + aRequest.mLength, false, caret);
+        NS_ENSURE_SUCCESS(rv, rv);
+        caret.mContainsEnd = true;
+        caret.mStartOffset = caret.mEndOffset =
+            aRequest.mOffset + aRequest.mLength;
+        aReply.mRects.AppendElement(caret);
+      }
+      break;
+    }
+    case NativeTextInputQuery::HitTest: {
+      PresShell* shell = mDocument->GetPresShell();
+      NS_ENSURE_TRUE(shell, NS_ERROR_NOT_AVAILABLE);
+      nsIFrame* rootFrame = shell->GetRootFrame();
+      NS_ENSURE_TRUE(rootFrame, NS_ERROR_NOT_AVAILABLE);
+      nsPoint point = nsLayoutUtils::GetEventCoordinatesRelativeTo(
+          widget, aRequest.mPoint, RelativeTo{rootFrame});
+      nsIFrame* target =
+          nsLayoutUtils::GetFrameForPoint(RelativeTo{rootFrame}, point);
+      nsTextControlFrame* textControl =
+          GetFocusedTextControlFrameForRoot(mRootElement);
+      const bool hitTextControl =
+          target && textControl &&
+          target->GetContent() == textControl->ControlElement();
+
+      if (target && target->GetContent() && target->IsSelectable()) {
+        aReply.mHitSelectableContent =
+            hitTextControl ||
+            target->GetContent()->IsInclusiveDescendantOf(mRootElement);
+      }
+
+      if (aReply.mHitSelectableContent) {
+        if (hitTextControl) {
+          target = mRootElement->GetPrimaryFrame();
+          NS_ENSURE_TRUE(target, NS_ERROR_NOT_AVAILABLE);
+        }
+        NS_ENSURE_TRUE(nsLayoutUtils::TransformPoint(
+                           RelativeTo{rootFrame}, RelativeTo{target}, point) ==
+                           nsLayoutUtils::TRANSFORM_SUCCEEDED,
+                       NS_ERROR_NOT_AVAILABLE);
+      } else {
+        target = mRootElement->GetPrimaryFrame();
+        NS_ENSURE_TRUE(target, NS_ERROR_NOT_AVAILABLE);
+        point = nsLayoutUtils::GetEventCoordinatesRelativeTo(
+            widget, aRequest.mPoint, RelativeTo{target});
+      }
+
+      auto offsets = target->GetContentOffsetsFromPoint(point);
+      NS_ENSURE_TRUE(offsets.content &&
+                         offsets.content->IsInclusiveDescendantOf(mRootElement),
+                     NS_ERROR_NOT_AVAILABLE);
+      auto offset =
+          GetFlatTextLengthInRange(RawNodePosition(mRootElement, 0u),
+                                   RawNodePosition(offsets), mRootElement);
+      if (offset.isErr()) {
+        return offset.unwrapErr();
+      }
+
+      aReply.mOffset = offset.unwrap();
+      aReply.mAssociateWithNext =
+          offsets.associate == CaretAssociationHint::After;
+
+      if (aReply.mHitSelectableContent && target->IsTextFrame()) {
+        auto character =
+            static_cast<nsTextFrame*>(target)->GetCharacterOffsetAtFramePoint(
+                point);
+        if (character.content &&
+            character.content->IsInclusiveDescendantOf(mRootElement)) {
+          auto characterOffset = GetFlatTextLengthInRange(
+              RawNodePosition(mRootElement, 0u), RawNodePosition(character),
+              mRootElement);
+          if (characterOffset.isOk()) {
+            aReply.mCharacterOffset = characterOffset.unwrap();
+          }
+        }
+      }
+      break;
+    }
+    case NativeTextInputQuery::WritingDirection:
+    case NativeTextInputQuery::Move:
+    case NativeTextInputQuery::ParagraphBoundary:
+    case NativeTextInputQuery::LineBoundary: {
+      FrameAndOffset frame;
+      rv = frameAtOffset(aRequest.mOffset, aRequest.mAssociateWithNext, frame);
+      NS_ENSURE_SUCCESS(rv, rv);
+      aReply.mRTL = nsBidiPresUtils::ParagraphDirection(frame) ==
+                    intl::BidiDirection::RTL;
+      const bool vertical = frame->GetWritingMode().IsVertical();
+      const bool backwardDirection =
+          aRequest.mDirection == NativeTextInputDirection::Backward ||
+          aRequest.mDirection == NativeTextInputDirection::Left ||
+          aRequest.mDirection == NativeTextInputDirection::Up;
+      bool backward = backwardDirection;
+      const bool verticalMovement =
+          aRequest.mDirection == NativeTextInputDirection::Up ||
+          aRequest.mDirection == NativeTextInputDirection::Down;
+      const bool physicalDirection =
+          aRequest.mDirection != NativeTextInputDirection::Forward &&
+          aRequest.mDirection != NativeTextInputDirection::Backward;
+      const bool inlineMovement =
+          !physicalDirection || (verticalMovement == vertical);
+
+      if (physicalDirection && inlineMovement && aReply.mRTL) {
+        backward = !backward;
+      }
+      if (physicalDirection && !inlineMovement && vertical &&
+          frame->GetWritingMode().IsVerticalRL()) {
+        backward = !backward;
+      }
+
+      aReply.mBackward = backward;
+      if (aRequest.mQuery == NativeTextInputQuery::WritingDirection) {
+        break;
+      }
+
+      nsSelectionAmount amount = inlineMovement ? eSelectCluster : eSelectLine;
+      if (aRequest.mQuery == NativeTextInputQuery::LineBoundary) {
+        amount = backward ? eSelectBeginLine : eSelectEndLine;
+      } else if (aRequest.mQuery == NativeTextInputQuery::ParagraphBoundary) {
+        amount = eSelectParagraph;
+      }
+
+      PeekOffsetOptions options{PeekOffsetOption::JumpLines,
+                                PeekOffsetOption::StopAtScroller,
+                                PeekOffsetOption::ForCaretMove};
+      if (aRequest.mQuery == NativeTextInputQuery::ParagraphBoundary) {
+        // ForCaretMove moves into the text at a paragraph boundary.
+        // We need the paragraph boundary itself when selecting a paragraph.
+        options -= PeekOffsetOption::ForCaretMove;
+      }
+      if (physicalDirection) {
+        options += PeekOffsetOption::Visual;
+      }
+      if (aReply.mEditable) {
+        options += PeekOffsetOption::ForceEditableRegion;
+      }
+
+      nsPoint desired;
+      if (amount == eSelectLine) {
+        // Keep the same column when moving through several lines.
+        rv = frame->GetPointFromOffset(frame.mOffsetInFrameContent, &desired);
+        NS_ENSURE_SUCCESS(rv, rv);
+        desired += frame->GetOffsetToRootFrame();
+      }
+
+      uint32_t offset = aRequest.mOffset;
+      for (uint32_t i = 0; i < aRequest.mCount; ++i) {
+        // The next paragraph may have a different text direction.
+        bool previous = backwardDirection;
+        if (physicalDirection && inlineMovement &&
+            nsBidiPresUtils::ParagraphDirection(frame) ==
+                intl::BidiDirection::RTL) {
+          previous = !previous;
+        }
+        if (physicalDirection && !inlineMovement && vertical &&
+            frame->GetWritingMode().IsVerticalRL()) {
+          previous = !previous;
+        }
+        PeekOffsetStruct peek(amount, previous ? eDirPrevious : eDirNext,
+                              frame.mOffsetInFrameContent, desired, options,
+                              eDefaultBehavior, mRootElement);
+        rv = frame->PeekOffset(&peek);
+        if (NS_FAILED(rv) || !peek.mResultContent ||
+            !peek.mResultContent->IsInclusiveDescendantOf(mRootElement)) {
+          return NS_ERROR_NOT_AVAILABLE;
+        }
+
+        auto resultOffset = GetFlatTextLengthInRange(
+            RawNodePosition(mRootElement, 0u),
+            RawNodePosition(peek.mResultContent, peek.mContentOffset),
+            mRootElement);
+        if (resultOffset.isErr()) {
+          return resultOffset.unwrapErr();
+        }
+
+        offset = resultOffset.unwrap();
+        if (amount == eSelectCluster && peek.mResultFrame) {
+          // Moving by a character doesn't set mAttach. At a line end, keep the
+          // caret on that line instead of jumping to the next one.
+          const auto [start, end] = peek.mResultFrame->GetOffsets();
+          peek.mAttach = end == peek.mContentOffset && (start || end)
+                             ? CaretAssociationHint::Before
+                             : CaretAssociationHint::After;
+        }
+
+        aReply.mAssociateWithNext = peek.mAttach == CaretAssociationHint::After;
+        if (i + 1 < aRequest.mCount) {
+          frame = SelectionMovementUtils::GetFrameForNodeOffset(
+              peek.mResultContent, peek.mContentOffset, peek.mAttach);
+          NS_ENSURE_TRUE(frame, NS_ERROR_NOT_AVAILABLE);
+        }
+      }
+
+      aReply.mOffset = offset;
+      break;
+    }
+    case NativeTextInputQuery::SetWritingDirection: {
+      RefPtr<EditorBase> editor =
+          nsContentUtils::GetActiveEditor(mDocument->GetPresContext());
+      NS_ENSURE_TRUE(editor && aReply.mEditable, NS_ERROR_NOT_AVAILABLE);
+      const EditorBase::TextDirection direction =
+          aRequest.mDirection == NativeTextInputDirection::Backward
+              ? EditorBase::TextDirection::eRTL
+              : EditorBase::TextDirection::eLTR;
+      editor->SwitchTextDirectionTo(direction);
+      break;
+    }
+    case NativeTextInputQuery::ToggleBold:
+    case NativeTextInputQuery::ToggleItalic:
+    case NativeTextInputQuery::ToggleUnderline: {
+      RefPtr<EditorBase> editor =
+          nsContentUtils::GetActiveEditor(mDocument->GetPresContext());
+      NS_ENSURE_TRUE(editor && aReply.mEditable, NS_ERROR_NOT_AVAILABLE);
+
+      Command format = Command::FormatBold;
+      if (aRequest.mQuery == NativeTextInputQuery::ToggleItalic) {
+        format = Command::FormatItalic;
+      } else if (aRequest.mQuery == NativeTextInputQuery::ToggleUnderline) {
+        format = Command::FormatUnderline;
+      }
+
+      RefPtr<EditorCommand> command = StyleUpdatingCommand::GetInstance();
+      NS_ENSURE_TRUE(command->IsCommandEnabled(format, editor),
+                     NS_ERROR_NOT_AVAILABLE);
+      rv = command->DoCommand(format, *editor, nullptr);
+      NS_ENSURE_SUCCESS(rv, rv);
+      break;
+    }
+    case NativeTextInputQuery::SetSelection: {
+      NS_ENSURE_TRUE(aReply.mSelectable, NS_ERROR_NOT_AVAILABLE);
+      WidgetSelectionEvent selection(true, eSetSelection, widget);
+      selection.mOffset = aRequest.mOffset;
+      selection.mLength = aRequest.mLength;
+      selection.mExpandToClusterBoundary = false;
+      selection.mAssociateWithNext = Some(aRequest.mAssociateWithNext);
+
+      SelectionBatcher selectionBatch(*mSelection, __FUNCTION__);
+      rv = OnSelectionEvent(&selection, ScrollFlags::ScrollFirstAncestorOnly |
+                                            ScrollFlags::ScrollOverflowHidden);
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(selection.mSucceeded, NS_ERROR_NOT_AVAILABLE);
+      break;
+    }
+    case NativeTextInputQuery::PrepareDeletion: {
+      NS_ENSURE_TRUE(aReply.mEditable, NS_ERROR_NOT_AVAILABLE);
+      // Apparently there's a line break at the start of an empty block
+      // of text? So to make deletion don't show an empty selection, just
+      // don't select the break
+      if (!aRequest.mOffset && aRequest.mLength == kBRLength) {
+        auto rangeOrError = ConvertFlatTextOffsetToDOMRange(
+            aRequest.mOffset, aRequest.mLength, false);
+        if (rangeOrError.isErr()) {
+          return rangeOrError.unwrapErr();
+        }
+
+        const auto& range = rangeOrError.inspect().mRange;
+        const nsINode* endContainer = range.GetEndContainer();
+
+        if (!range.EndOffset() && endContainer->IsElement() &&
+            ShouldBreakLineBefore(*endContainer->AsContent(), mRootElement)) {
+          break;
+        }
+      }
+
+      WidgetSelectionEvent selection(true, eSetSelection, widget);
+      selection.mOffset = aRequest.mOffset;
+      selection.mLength = aRequest.mLength;
+      selection.mExpandToClusterBoundary = false;
+      selection.mAssociateWithNext = Some(aRequest.mAssociateWithNext);
+
+      // UIKit selects text before deleting it when holding backspace.
+      // Hide this temporary selection so handles and page menus don't flash.
+      AutoHideSelectionChanges hideSelectionChanges(*mSelection);
+      rv = OnSelectionEvent(&selection);
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(selection.mSucceeded, NS_ERROR_NOT_AVAILABLE);
+      break;
+    }
+    case NativeTextInputQuery::ReplaceText: {
+      RefPtr<EditorBase> editor =
+          nsContentUtils::GetActiveEditor(mDocument->GetPresContext());
+      NS_ENSURE_TRUE(editor && aReply.mEditable, NS_ERROR_NOT_AVAILABLE);
+      auto rangeOrError = ConvertFlatTextOffsetToDOMRange(
+          aRequest.mOffset, aRequest.mLength, false);
+      if (rangeOrError.isErr()) {
+        return rangeOrError.unwrapErr();
+      }
+
+      auto range = rangeOrError.unwrap();
+      RefPtr<nsRange> replacement = nsRange::Create(
+          range.mRange.Start(), range.mRange.End(), IgnoreErrors());
+      NS_ENSURE_TRUE(replacement, NS_ERROR_NOT_AVAILABLE);
