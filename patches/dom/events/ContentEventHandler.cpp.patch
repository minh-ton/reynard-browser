+              ? EditorBase::PreventSetSelection::No
+              : EditorBase::PreventSetSelection::Yes);
+      NS_ENSURE_SUCCESS(rv, rv);
+      break;
+    }
+    case NativeTextInputQuery::InsertDictation: {
+      RefPtr<EditorBase> editor =
+          nsContentUtils::GetActiveEditor(mDocument->GetPresContext());
+      NS_ENSURE_TRUE(editor && aReply.mEditable, NS_ERROR_NOT_AVAILABLE);
+
+      WidgetSelectionEvent selection(true, eSetSelection, widget);
+      selection.mOffset = aRequest.mOffset;
+      selection.mLength = aRequest.mLength;
+      selection.mExpandToClusterBoundary = false;
