+        NS_ENSURE_SUCCESS(rv, rv);
+        NS_ENSURE_TRUE(selection.mSucceeded, NS_ERROR_NOT_AVAILABLE);
+      }
+
+      rv = editor->InsertTextAsAction(aRequest.mText);
+      NS_ENSURE_SUCCESS(rv, rv);
+      break;
+    }
+    case NativeTextInputQuery::StartTextDrag: {
+      NS_ENSURE_TRUE(aReply.mEditable && !mSelection->IsCollapsed(),
+                     NS_ERROR_NOT_AVAILABLE);
+
+      RefPtr<PresShell> shell = mDocument->GetPresShell();
+      nsIFrame* rootFrame = shell ? shell->GetRootFrame() : nullptr;
+      NS_ENSURE_TRUE(rootFrame, NS_ERROR_NOT_AVAILABLE);
+
+      WidgetMouseEvent event(true, eMouseTouchDrag, widget,
+                             WidgetMouseEvent::eReal);
+      event.mRefPoint = aRequest.mPoint;
+      event.mInputSource = dom::MouseEvent_Binding::MOZ_SOURCE_TOUCH;
+      event.mButton = MouseButton::ePrimary;
+      event.mButtons = MouseButtonsFlag::ePrimaryFlag;
