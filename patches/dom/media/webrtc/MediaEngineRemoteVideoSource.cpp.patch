+static uint32_t FrameRateFitnessDistance(
+    const webrtc::CaptureCapability& aCandidate,
+    const NormalizedConstraintSet::DoubleRange& aConstraint) {
+  using H = MediaConstraintsHelper;
+
+  if (!aCandidate.maxFPS) {
+    return 0;
+  }
+
+  if (aCandidate.minFPS <= 0) {
+    return H::FitnessDistance(double(aCandidate.maxFPS), aConstraint);
+  }
+
+  const double min = std::max(double(aCandidate.minFPS), aConstraint.mMin);
+  const double max = std::min(double(aCandidate.maxFPS), aConstraint.mMax);
+
+  if (min > max) {
+    return UINT32_MAX;
+  }
+
+  return H::FitnessDistance(
+      std::clamp(aConstraint.mIdeal.valueOr(max), min, max), aConstraint);
+}
+
+static uint32_t FrameRateFeasibilityDistance(
+    const webrtc::CaptureCapability& aCandidate,
+    const NormalizedConstraintSet::DoubleRange& aConstraint) {
+  using H = MediaConstraintsHelper;
+
+  if (!aCandidate.maxFPS) {
+    return 0;
+  }
+
+  if (aCandidate.minFPS <= 0) {
+    return H::FeasibilityDistance(double(aCandidate.maxFPS), aConstraint);
+  }
+
+  const double min = std::max(double(aCandidate.minFPS), aConstraint.mMin);
+  const double max = double(aCandidate.maxFPS);
+
+  if (min > max) {
+    return UINT32_MAX;
+  }
+
+  return H::FeasibilityDistance(
+      std::clamp(aConstraint.mIdeal.valueOr(max), min, max), aConstraint);
+}
